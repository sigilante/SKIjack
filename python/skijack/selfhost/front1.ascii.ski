-- The full language's front end, in SKIjack-0 (avon docs/WORKLIST.md,
-- Stage 8), grown from front0.ascii.ski.  It reads a program as 7-bit
-- character codes and writes each name's closed term, as the expander
-- does with checking off; compiling this file with itself is the fixed
-- point.  M1: cores, macros, signatures, the Tier 1 birds and the
-- numeral operations; M2: interpreter generation; M3: quotation and
-- level-1 runs; M4: scries, paths and namespace literals.
bool === Yes | No
nat  === Zero | Suc nat
bit  === Lo | Hi
code === Code bit bit bit bit bit bit bit
sym  === SEq | SBar | SGt | SColon | SBack | SDot | SSemi | SLP | SRP | SLB | SRB | SLC | SRC | SAt | SMinus | SStar | SBang | SLt | SQuest | SCaret | SComma | SSlash
ch   === ChSpace | ChNl | ChLetter | ChDigit nat | ChPrime | ChSym sym | ChOther
str  === SNil | SCons code str
name === NNil | NCons code name
tok  === TName ident | TAxis nat | TTypeDecl | TCase | TAssign | TEq | TAlt | TLam | TDot | TSemi | TLP | TRP | TLB | TRB | TLC | TRC | TNl | TColon | TArrow | TMacro | TCMacro | TQOpen | TQClose | TTurn | TFuel nat | TFuelE | TScry | TNsOpen | TMapsTo | TComma | TSlash | TGlue | TBad
toks === TNil | TCons tok toks
-- identifiers: a name interned to a binary number, least significant bit
-- first; a table from names to numbers, and back
bits  === Bn | Bz bits | Bo bits
ident === IdRaw name | Id bits
it    === It0 | ItT itt
itt   === ItB it name bits it
mid   === MId bits | MIdNone
rv    === Rv0 | RvT rvt
rvt   === RvB mnm rv rv
mnm   === MNm name | MNmNone
ist   === Ist it rv bits
ia    === IA bits ist
ir    === IR toks ist
mn   === MName ident | MNone
dk   === DOpen | DClose | DNl | DOther
op   === OType | OEq | ODef | OSig | OMacro | OCMacro | ONone
-- for each open bracket, whether it counts toward the depth: a core's
-- braces do not
bk   === BkNil | BkCons bool bk
-- parsing: constructor and type tables, the syntax tree, partial results
names === NmNil | NmCons ident names
ci    === CInfo ident ident nat nat
cis   === CiNil | CiCons ci cis
ty    === TyInfo ident names
tys   === TyNil | TyCons ty tys
mc    === MC ci | MCNone
mty   === MTy names | MTNone
cr    === CR cis tys | CRFail
cg    === CG names cis toks | CGFail
-- a quotation: its body, its fuel and the interpreter left of `|-`
expr  === EVar ident | EApp eap | ECell exprs | EPick nat expr | ECase expr brs | ELam ident expr | EQuote expr fuel mie | EScry pth | ENs facts
-- a path's segments, each a tag and perhaps a payload; a namespace
-- literal's facts, each a path and its value
pth   === PNil | PSeg ident mie pth
facts === FtNil | FtCons pth expr facts
ppr   === PP pth toks | PPFail
pft   === PFt facts toks | PFtFail
fuel  === FNone | FNum nat | FPol
mie   === INone | ISome expr
eap   === EAp expr expr
exprs === XNil | XCons expr exprs
br    === Br ident names expr
brs   === BNil | BCons br brs
-- a core holds its equations, each with the core's parameters first;
-- once named, each is DCEq: its composite name `core.eq`, its own name,
-- its siblings' renaming, its binders and its body
decl  === DEq ident names expr | DDef ident expr | DType ident names fss | DMacro ident names bool expr | DCore ident names decls | DCEq ident ident ren names expr
ren   === RnNil | RnCons ident ident ren
-- each constructor's field types, in order
fss   === FsNil | FsCons names fss
pf    === PF names fss toks | PFFail
pc    === PC decls toks | PCFail
decls === DNil | DCons decl decls
pe    === PE expr toks | PFail
px    === PX exprs toks | PXFail
pb    === PB brs toks | PBFail
pn    === PN names toks | PNFail
pd    === PD decls | PDFail
mt    === MT toks | MNo
hn    === HN names toks
-- expansion: desugared expressions, rules, equations, terms
dexpr === DName ident | DApp dap | DLam ident dexpr | DBad
dap   === DAp dexpr dexpr
hr    === HR nat bit
-- RQuote: the datum of a term, encoded by the object type's application
-- constructor and leaves (qe)
rterm === RVar ident | RIx nat | RRef ident | RS | RK | RI | RAp rap | RRule rule | RQuote rterm qe | RBad
qe    === QE ident names
rap   === RA rterm rterm
rule  === Rule names rterm
rules === Rm0 | RmT rmt
rmt   === RmB mru rules rules
subs  === SubNil | SubCons ident rterm ident subs
mr    === MR rterm | MRNone
mru   === MRu rule | MRuNone
eqx   === EqX ident names dexpr names
-- macros, most recent first; expansion's results: an expression, the
-- work left and the next fresh binder; a substitution and its results
macs  === McNil | McCons ident names bool expr macs
mm    === MM names bool expr | MMNone
mx    === MX expr bits bits | MXFail
mxs   === MXs exprs bits bits | MXsFail
mxb   === MXb brs bits bits | MXbFail
sb    === SbNil | SbCons ident expr sb
mex   === MEx expr | MExNone
se    === SE expr bits
ses   === SEs exprs bits
sbr   === SBr brs bits
rb    === RB ident expr bits
rns   === RNs names expr bits
cq    === CQ decls ist
rq    === RQ ren ist
eqxs  === ExNil | ExCons eqx eqxs
-- trees keyed by name, in code order: a set, and maps to constructors,
-- rules, terms, Tarjan's state and groups
ord   === CLt | CEq | CGt
nset  === Ns0 | NsT nst
nst   === NsB bool nset nset
cm    === Cm0 | CmT cmt
cmt   === CmB mc cm cm
tje   === TjE names bool nat nat bool
tjm   === Tj0 | TjT tjt
tjt   === TjB mtj tjm tjm
mtj   === MTj tje | MTjNone
scs   === ScNil | ScCons names scs
tst   === Tst nat names tjm scs
gi    === GSingle bool | GMulti eqxs | GSkip
gm    === Gm0 | GmT gmt
gmt   === GmB mg gm gm
mg    === MG gi | MGNone
tm    === TS | TK | TI | TV nat | TA ap
ap    === Ap tm tm
memo  === Me0 | MeT met
met   === MeB mtm memo memo
mtm   === MTm tm | MTmNone
tmm   === TM tm memo
tms   === TmNil | TmCons tm tms
inb   === IB tm nat tms memo
outs  === ONil | OCons name tm outs
prs   === PrNil | PrCons ident ident prs
-- quotation: a body with its nested quotations stripped out, each under a
-- placeholder; a quotation definition so stripped; what compiling them
-- adds: rules, datums, level-1 runs printed and only checked, and each
-- quotation's term with the datums declared before it
qs    === QsNil | QsCons ident expr qs
sq    === SQ expr qs bits | SQFail
sqs   === SQs exprs qs bits | SQsFail
sqb   === SQb brs qs bits | SQbFail
qd    === QD ident expr fuel mie qs | QN ident nfs
nf    === NF expr expr qs
nfs   === NfNil | NfCons nf nfs
-- a path's term: the path type's Nil, Cons and segment type, the
-- constructors and the names; or no path type
sx    === SX ident ident ident cm ist | SXNone
pex   === PEx expr | PExFail
ans   === Ans ident ident | AnsNone
qds   === QdNil | QdCons qd qds
qst   === QSt qds bits | QStFail
qf    === QF nfs bits | QFFail
nr    === NrNil | NrCons ident rule nr
qrt   === QrNil | QrCons rterm nset qrt
qo    === QO nr names names names qrt | QOErr
rts   === RtNil | RtCons rterm rts
mrts  === MRts rts | MRtsNone
-- quotation's context: macros, constructors, types, the level-0 scope,
-- the quotation scope, the leaves' renaming, the encoding, the program,
-- the answer type's hit and not-yet, the loops, the bare core outputs
-- and the level-0 names printed
qx    === QX macs cm tys nset nset ren qe decls ans ren ren nset
orf   === OR rterm bool | ORNone
kvs   === KvNil | KvCons rterm rterm kvs
qfc   === QFC kvs nr qrt | QFCFail
ci2   === CI2 nat mn | CINone
mnr   === MNr nr | MNrFail
qi    === QI ident bool exprs | QINone
-- interpreter generation: the object type (its name, constructors, fields
-- and application constructor), a candidate outcome type (its name,
-- constructors, fields and carrier), what each outcome constructor
-- continues the loop with, and the loop's types
ob    === Ob ident names fss ident | ObNone | ObErr
cd    === Cd ident names fss ident
cds   === CdNil | CdCons cd cds
ck    === CkStep | CkDone | CkTo ident
cks   === CkNil | CkCons ck cks
ckr   === CKs cks names | CKErr
lty   === LT ident ident ident ident cks ident ident | LTErr
nq    === NQ names ist
qr    === QR nat nat
gq    === GQ decls ist | GQErr
oa    === OA outs memo
result === ROk outs | RErr
-- BEGIN GENERATED
classify c = c |> { Code b6 b5 b4 b3 b2 b1 b0 (b6 |> { Lo (b5 |> { Lo (b4 |> { Lo (b3 |> { Lo ChOther ; Hi (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo ChOther ; Hi ChSpace }) ; Hi (b0 |> { Lo ChNl ; Hi ChOther }) }) ; Hi (b1 |> { Lo (b0 |> { Lo ChOther ; Hi ChSpace }) ; Hi ChOther }) }) }) ; Hi ChOther }) ; Hi (b4 |> { Lo (b3 |> { Lo (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo ChSpace ; Hi (ChSym SBang) }) ; Hi ChOther }) ; Hi (b1 |> { Lo ChOther ; Hi (b0 |> { Lo ChOther ; Hi ChPrime }) }) }) ; Hi (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo (ChSym SLP) ; Hi (ChSym SRP) }) ; Hi (b0 |> { Lo (ChSym SStar) ; Hi ChOther }) }) ; Hi (b1 |> { Lo (b0 |> { Lo (ChSym SComma) ; Hi (ChSym SMinus) }) ; Hi (b0 |> { Lo (ChSym SDot) ; Hi (ChSym SSlash) }) }) }) }) ; Hi (b3 |> { Lo (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo (ChDigit Zero) ; Hi (ChDigit (Suc Zero)) }) ; Hi (b0 |> { Lo (ChDigit (Suc (Suc Zero))) ; Hi (ChDigit (Suc (Suc (Suc Zero)))) }) }) ; Hi (b1 |> { Lo (b0 |> { Lo (ChDigit (Suc (Suc (Suc (Suc Zero))))) ; Hi (ChDigit (Suc (Suc (Suc (Suc (Suc Zero)))))) }) ; Hi (b0 |> { Lo (ChDigit (Suc (Suc (Suc (Suc (Suc (Suc Zero))))))) ; Hi (ChDigit (Suc (Suc (Suc (Suc (Suc (Suc (Suc Zero)))))))) }) }) }) ; Hi (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo (ChDigit (Suc (Suc (Suc (Suc (Suc (Suc (Suc (Suc Zero))))))))) ; Hi (ChDigit (Suc (Suc (Suc (Suc (Suc (Suc (Suc (Suc (Suc Zero)))))))))) }) ; Hi (b0 |> { Lo (ChSym SColon) ; Hi (ChSym SSemi) }) }) ; Hi (b1 |> { Lo (b0 |> { Lo (ChSym SLt) ; Hi (ChSym SEq) }) ; Hi (b0 |> { Lo (ChSym SGt) ; Hi (ChSym SQuest) }) }) }) }) }) }) ; Hi (b5 |> { Lo (b4 |> { Lo (b3 |> { Lo (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo (ChSym SAt) ; Hi ChLetter }) ; Hi ChLetter }) ; Hi ChLetter }) ; Hi ChLetter }) ; Hi (b3 |> { Lo ChLetter ; Hi (b2 |> { Lo (b1 |> { Lo ChLetter ; Hi (b0 |> { Lo ChLetter ; Hi (ChSym SLB) }) }) ; Hi (b1 |> { Lo (b0 |> { Lo (ChSym SBack) ; Hi (ChSym SRB) }) ; Hi (b0 |> { Lo (ChSym SCaret) ; Hi ChLetter }) }) }) }) }) ; Hi (b4 |> { Lo (b3 |> { Lo (b2 |> { Lo (b1 |> { Lo (b0 |> { Lo ChOther ; Hi ChLetter }) ; Hi ChLetter }) ; Hi ChLetter }) ; Hi ChLetter }) ; Hi (b3 |> { Lo ChLetter ; Hi (b2 |> { Lo (b1 |> { Lo ChLetter ; Hi (b0 |> { Lo ChLetter ; Hi (ChSym SLC) }) }) ; Hi (b1 |> { Lo (b0 |> { Lo (ChSym SBar) ; Hi (ChSym SRC) }) ; Hi ChOther }) }) }) }) }) }) }
