nameCons := (NCons (Code Hi Hi Lo Lo Lo Hi Hi) (NCons (Code Hi Hi Lo Hi Hi Hi Hi) (NCons (Code Hi Hi Lo Hi Hi Hi Lo) (NCons (Code Hi Hi Hi Lo Lo Hi Hi) NNil))))
