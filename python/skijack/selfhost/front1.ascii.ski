-- booleans, numerals, codes, names
andB a b = a |> { Yes b ; No No }
orB a b = a |> { Yes Yes ; No b }
notB a = a |> { Yes No ; No Yes }
eqBit a b = a |> { Lo (b |> { Lo Yes ; Hi No }) ; Hi (b |> { Lo No ; Hi Yes }) }
eqCode x y = x |> { Code a6 a5 a4 a3 a2 a1 a0 (y |> { Code b6 b5 b4 b3 b2 b1 b0 (andB (eqBit a6 b6) (andB (eqBit a5 b5) (andB (eqBit a4 b4) (andB (eqBit a3 b3) (andB (eqBit a2 b2) (andB (eqBit a1 b1) (eqBit a0 b0))))))) }) }
revAcc n acc = n |> { NNil acc ; NCons c r (revAcc r (NCons c acc)) }
add m n = n |> { Zero m ; Suc k (Suc (add m k)) }
mul10 n = add n (add n (add n (add n (add n (add n (add n (add n (add n n))))))))
-- lexing: characters to tokens
idChar k = k |> { ChSpace No ; ChNl No ; ChLetter Yes ; ChDigit d Yes ; ChPrime Yes ; ChSym y No ; ChOther No }
atSym y = y |> { SEq No ; SBar No ; SGt No ; SColon No ; SBack No ; SDot No ; SSemi No ; SLP No ; SRP No ; SLB No ; SRB No ; SLC No ; SRC No ; SAt Yes ; SMinus No ; SStar No ; SBang No ; SLt No ; SQuest No ; SCaret No ; SComma No ; SSlash No }
nextIs cd r = r |> { SNil No ; SCons c r2 (eqCode c cd) }
tail r = r |> { SNil SNil ; SCons c r2 r2 }
lx s = s |> { SNil (TCons TNl TNil) ; SCons c r (lxc c (classify c) r) }
lxc c k r = k |> { ChSpace (lx r) ; ChNl (TCons TNl (lx r)) ; ChLetter (lxName (NCons c NNil) r) ; ChDigit d (lxNum d one r) ; ChPrime (TCons TBad (lx r)) ; ChSym y (lxSym y r) ; ChOther (TCons TBad (lx r)) }
lxName acc r = r |> { SNil (lxEmit (revAcc acc NNil) r) ; SCons c r2 (idChar (classify c) |> { Yes (lxName (NCons c acc) r2) ; No (lxEmit (revAcc acc NNil) r) }) }
-- `ns` straight before `{` opens a namespace literal
lxEmit nm r = cmpName nm nameNs |> { CEq (nextIs codeLC r |> { Yes (TCons TNsOpen (lx (tail r))) ; No (TCons (TName (IdRaw nm)) (lx r)) }) ; CLt (TCons (TName (IdRaw nm)) (lx r)) ; CGt (TCons (TName (IdRaw nm)) (lx r)) }
-- digits: before `@` an axis, otherwise a literal; a number has at most
-- four digits (skijack.lexicon.MAX_DIGITS): a fifth is refused where it
-- stands, so no number is read past 9,999
lxNum n nd r = r |> { SNil (TCons (TNum n) (lx SNil)) ; SCons c r2 (numStep n nd (classify c) r r2) }
numStep n nd k r r2 = k |> { ChSpace (TCons (TNum n) (lx r)) ; ChNl (TCons (TNum n) (lx r)) ; ChLetter (TCons (TNum n) (lx r)) ; ChDigit d (eqN nd four |> { Yes (TCons TBad (lx r)) ; No (lxNum (add (mul10 n) d) (Suc nd) r2) }) ; ChPrime (TCons (TNum n) (lx r)) ; ChSym y (atSym y |> { Yes (TCons (TAxis n) (lx r2)) ; No (TCons (TNum n) (lx r)) }) ; ChOther (TCons (TNum n) (lx r)) }
lxSym y r = y |> { SEq (nextIs codeEqc r |> { Yes (nextIs codeEqc (tail r) |> { Yes (TCons TTypeDecl (lx (tail (tail r)))) ; No (TCons TEq (lx r)) }) ; No (nextIs codeGt r |> { Yes (TCons TMapsTo (lx (tail r))) ; No (TCons TEq (lx r)) }) }) ; SBar (nextIs codeGt r |> { Yes (TCons TCase (lx (tail r))) ; No (nextIs codeMinus r |> { Yes (TCons TTurn (lx (tail r))) ; No (TCons TAlt (lx r)) }) }) ; SGt (TCons TQClose (lx r)) ; SColon (nextIs codeEqc r |> { Yes (lxAssign (tail r)) ; No (TCons TColon (lx r)) }) ; SBack (TCons TLam (lx r)) ; SDot (TCons TDot (lx r)) ; SSemi (TCons TSemi (lx r)) ; SLP (TCons TLP (lx r)) ; SRP (TCons TRP (lx r)) ; SLB (TCons TLB (lx r)) ; SRB (TCons TRB (lx r)) ; SLC (TCons TLC (lx r)) ; SRC (TCons TRC (lx r)) ; SAt (lxAt r) ; SMinus (nextIs codeMinus r |> { Yes (skipLine r) ; No (nextIs codeGt r |> { Yes (TCons TArrow (lx (tail r))) ; No (TCons TBad (lx r)) }) }) ; SStar (TCons TBad (lx r)) ; SBang (TCons TBad (lx r)) ; SLt (TCons TQOpen (lx r)) ; SQuest (nextIs codeCaret r |> { Yes (TCons TScry (lx (tail r))) ; No (TCons TBad (lx r)) }) ; SCaret (TCons TBad (lx r)) ; SComma (TCons TComma (lx r)) ; SSlash (TCons TSlash (lx r)) }
-- `@` then digits or `[]` is fuel
lxAt r = r |> { SNil (TCons TBad (lx r)) ; SCons c r2 (classify c |> { ChDigit d (lxFuel d one r2) ; ChSpace (TCons TBad (lx r)) ; ChNl (TCons TBad (lx r)) ; ChLetter (TCons TBad (lx r)) ; ChPrime (TCons TBad (lx r)) ; ChOther (TCons TBad (lx r)) ; ChSym y (andB (eqCode c codeLB) (nextIs codeRB r2) |> { Yes (TCons TFuelE (lx (tail r2))) ; No (TCons TBad (lx r)) }) }) }
lxFuel n nd r = r |> { SNil (TCons (TFuel n) (lx r)) ; SCons c r2 (classify c |> { ChDigit d (eqN nd four |> { Yes (TCons TBad (lx r)) ; No (lxFuel (add (mul10 n) d) (Suc nd) r2) }) ; ChSpace (TCons (TFuel n) (lx r)) ; ChNl (TCons (TFuel n) (lx r)) ; ChLetter (TCons (TFuel n) (lx r)) ; ChPrime (TCons (TFuel n) (lx r)) ; ChOther (TCons (TFuel n) (lx r)) ; ChSym y (TCons (TFuel n) (lx r)) }) }
-- after `:=`, a `*` or `!` makes a macro's operator
lxAssign r = nextIs codeStar r |> { Yes (TCons TMacro (lx (tail r))) ; No (nextIs codeBang r |> { Yes (TCons TCMacro (lx (tail r))) ; No (TCons TAssign (lx r)) }) }
skipLine r = r |> { SNil (lx SNil) ; SCons c r2 (eqCode c codeNl |> { Yes (TCons TNl (lx r2)) ; No (skipLine r2) }) }
-- lists of names
eqB a b = a |> { Bn (b |> { Bn Yes ; Bz y No ; Bo y No }) ; Bz x (b |> { Bn No ; Bz y (eqB x y) ; Bo y No }) ; Bo x (b |> { Bn No ; Bz y No ; Bo y (eqB x y) }) }
inc b = b |> { Bn (Bo Bn) ; Bz r (Bo r) ; Bo r (Bz (inc r)) }
idBits x = x |> { IdRaw n Bn ; Id b b }
eqId x y = eqB (idBits x) (idBits y)
-- a group's key: its first member's number with a zero above its top bit,
-- a form no interned number takes
keyBits b = b |> { Bn (Bz Bn) ; Bz r (Bz (keyBits r)) ; Bo r (Bo (keyBits r)) }
keyOf x = Id (keyBits (idBits x))
memN n ns = ns |> { NmNil No ; NmCons m r (orB (eqId n m) (memN n r)) }
appN a b = a |> { NmNil b ; NmCons m r (NmCons m (appN r b)) }
lenN ns = ns |> { NmNil Zero ; NmCons m r (Suc (lenN r)) }
sHas x s = sHasB (idBits x) s
sHasB b s = s |> { Ns0 No ; NsT t (t |> { NsB v z o (b |> { Bn v ; Bz r (sHasB r z) ; Bo r (sHasB r o) }) }) }
sAdd x s = sAddB (idBits x) s
sAddB b s = s |> { Ns0 (sAddB b (NsT (NsB No Ns0 Ns0))) ; NsT t (t |> { NsB v z o (b |> { Bn (NsT (NsB Yes z o)) ; Bz r (NsT (NsB v (sAddB r z) o)) ; Bo r (NsT (NsB v z (sAddB r o))) }) }) }
setOf ns s = ns |> { NmNil s ; NmCons n r (setOf r (sAdd n s)) }
cmpBit a b = a |> { Lo (b |> { Lo CEq ; Hi CLt }) ; Hi (b |> { Lo CGt ; Hi CEq }) }
thenC o k = o |> { CLt CLt ; CEq k ; CGt CGt }
cmpCode x y = x |> { Code a6 a5 a4 a3 a2 a1 a0 (y |> { Code b6 b5 b4 b3 b2 b1 b0 (thenC (cmpBit a6 b6) (thenC (cmpBit a5 b5) (thenC (cmpBit a4 b4) (thenC (cmpBit a3 b3) (thenC (cmpBit a2 b2) (thenC (cmpBit a1 b1) (cmpBit a0 b0))))))) }) }
cmpName m n = m |> { NNil (n |> { NNil CEq ; NCons c r CLt }) ; NCons a r (n |> { NNil CGt ; NCons b s (thenC (cmpCode a b) (cmpName r s)) }) }
itGet n m = m |> { It0 MIdNone ; ItT t (t |> { ItB l k v r (cmpName n k |> { CLt (itGet n l) ; CEq (MId v) ; CGt (itGet n r) }) }) }
itAdd n x m = m |> { It0 (ItT (ItB It0 n x It0)) ; ItT t (t |> { ItB l k v r (cmpName n k |> { CLt (ItT (ItB (itAdd n x l) k v r)) ; CEq (ItT (ItB l k x r)) ; CGt (ItT (ItB l k v (itAdd n x r))) }) }) }
rvPut b x m = m |> { Rv0 (rvPut b x (RvT (RvB MNmNone Rv0 Rv0))) ; RvT t (t |> { RvB v z o (b |> { Bn (RvT (RvB x z o)) ; Bz r (RvT (RvB v (rvPut r x z) o)) ; Bo r (RvT (RvB v z (rvPut r x o))) }) }) }
rvGet b m = m |> { Rv0 MNmNone ; RvT t (t |> { RvB v z o (b |> { Bn v ; Bz r (rvGet r z) ; Bo r (rvGet r o) }) }) }
nameFor rv x = rvGet (idBits x) rv |> { MNm n n ; MNmNone NNil }
-- the next number for a name not yet seen, or its number
look n s = s |> { Ist tab rv nx (itGet n tab |> { MId b (IA b s) ; MIdNone (IA nx (Ist (itAdd n nx tab) (rvPut nx (MNm n) rv) (inc nx))) }) }
intern ts s = ts |> { TNil (IR TNil s) ; TCons t r (nameOf t |> { MNone (ir2 t (intern r s)) ; MName x (x |> { Id b (ir2 t (intern r s)) ; IdRaw n (look n s |> { IA b s2 (ir2 (TName (Id b)) (intern r s2)) }) }) }) }
ir2 t q = q |> { IR ts s (IR (TCons t ts) s) }
seed ns s = ns |> { NmNil s ; NmCons x r (x |> { IdRaw n (look n s |> { IA b s2 (seed r s2) }) ; Id b (seed r s) }) }
seeded := seed seedNames (Ist It0 Rv0 Bn)
dupS ns s = ns |> { NmNil No ; NmCons n r (sHas n s |> { Yes Yes ; No (dupS r (sAdd n s)) }) }
eqN m n = m |> { Zero (n |> { Zero Yes ; Suc k No }) ; Suc j (n |> { Zero No ; Suc k (eqN j k) }) }
isSKI n = orB (eqId n idS) (orB (eqId n idK) (eqId n idI))
preludeNames := NmCons idPair (NmCons idHd (NmCons idTl (NmCons idNil (NmCons idCons (NmCons idZero (NmCons idSuc NmNil))))))
-- newlines inside ( ), [ ] and { } are not tokens, but for one before the
-- bracket that closes the outermost group, which the parser refuses; a
-- core's braces, the `{` straight after `:=`, do not count; and a newline
-- dropped before fuel is refused, as fuel must follow its `>` directly;
-- so is one before a path's `/`, and one between a path's tag and `[`
-- ends the path (TGlue), as in Python, whose path reads raw tokens
isFuel t = fuelOf t |> { FNone No ; FNum n Yes ; FPol Yes }
predN n = n |> { Zero Zero ; Suc k k }
closes r = r |> { TNil No ; TCons t r2 (depthKind t |> { DOpen No ; DClose Yes ; DNl (closes r2) ; DOther No }) }
nlf pp prev d ks ts = ts |> { TNil TNil ; TCons t r (depthKind t |> { DOpen (andB (isAssign prev) (isLC t) |> { Yes (TCons t (nlf prev t d (BkCons No ks) r)) ; No (TCons t (nlf prev t (Suc d) (BkCons Yes ks) r)) }) ; DClose (ks |> { BkNil (TCons t (nlf prev t d BkNil r)) ; BkCons c ks2 (c |> { Yes (TCons t (nlf prev t (predN d) ks2 r)) ; No (TCons t (nlf prev t d ks2 r)) }) }) ; DNl (d |> { Zero (TCons t (nlf prev t d ks r)) ; Suc k (andB (eqN k Zero) (closes r) |> { Yes (TCons t (nlf prev t d ks r)) ; No (orB (headIs isFuel r) (headIs isSlash r) |> { Yes (TCons TBad (nlf prev t d ks r)) ; No (andB (isSlash pp) (andB (nameOf prev |> { MName n Yes ; MNone No }) (headIs isLB r)) |> { Yes (TCons TGlue (nlf prev t d ks r)) ; No (nlf prev t d ks r) }) }) }) }) ; DOther (TCons t (nlf prev t d ks r)) }) }
-- pass one: every type declaration's constructors, their indices and arities
cc prev ts = ts |> { TNil (CR CiNil TyNil) ; TCons t r (isTypeDecl t |> { Yes (ccDecl prev r) ; No (cc t r) }) }
ccDecl prev r = nameOf prev |> { MNone CRFail ; MName tn (ccJoin tn (ccCtor tn Zero r)) }
ccJoin tn q = q |> { CGFail CRFail ; CG ns is r (ccJoin2 tn ns is (cc TNl r)) }
ccJoin2 tn ns is q = q |> { CRFail CRFail ; CR is2 ys (CR (appCI is is2) (TyCons (TyInfo tn ns) ys)) }
appCI a b = a |> { CiNil b ; CiCons x r (CiCons x (appCI r b)) }
ccCtor tn i ts = ts |> { TNil CGFail ; TCons t r (nameOf t |> { MNone CGFail ; MName c (ccFields tn i c Zero r) }) }
ccFields tn i c k ts = ts |> { TNil (CG (NmCons c NmNil) (CiCons (CInfo c tn i k) CiNil) ts) ; TCons t r (nameOf t |> { MName f (ccFields tn i c (Suc k) r) ; MNone (isAlt t |> { Yes (ccCons c (CInfo c tn i k) (ccCtor tn (Suc i) r)) ; No (isNl t |> { Yes (CG (NmCons c NmNil) (CiCons (CInfo c tn i k) CiNil) ts) ; No CGFail }) }) }) }
ccCons c x q = q |> { CGFail CGFail ; CG ns is r (CG (NmCons c ns) (CiCons x is) r) }
cmPut b x m = m |> { Cm0 (cmPut b x (CmT (CmB MCNone Cm0 Cm0))) ; CmT t (t |> { CmB v z o (b |> { Bn (CmT (CmB x z o)) ; Bz r (CmT (CmB v (cmPut r x z) o)) ; Bo r (CmT (CmB v z (cmPut r x o))) }) }) }
cmGet b m = m |> { Cm0 MCNone ; CmT t (t |> { CmB v z o (b |> { Bn v ; Bz r (cmGet r z) ; Bo r (cmGet r o) }) }) }
cmAdd n x m = cmPut (idBits n) (MC x) m
findCI c m = cmGet (idBits c) m
ciMap is m = is |> { CiNil m ; CiCons x r (ciMap r (x |> { CInfo n tn i k (cmAdd n x m) })) }
findTy tn ys = ys |> { TyNil MTNone ; TyCons y r (y |> { TyInfo n cs (eqId tn n |> { Yes (MTy cs) ; No (findTy tn r) }) }) }
tyNames ys = ys |> { TyNil NmNil ; TyCons y r (y |> { TyInfo n cs (NmCons n (tyNames r)) }) }
-- parsing: expressions
want p ts = ts |> { TNil MNo ; TCons t r (p t |> { Yes (MT r) ; No MNo }) }
headIs p ts = ts |> { TNil No ; TCons t r (p t) }
ttl ts = ts |> { TNil TNil ; TCons t r r }
pexpr ct ts = pcase ct (papp ct ts)
pcase ct p = p |> { PFail PFail ; PE e r (headIs isCase r |> { Yes (pcaseL ct e (want isLC (ttl r))) ; No (headIs isTurn r |> { Yes (pturn ct e (want isQOpen (ttl r))) ; No p }) }) }
pcaseL ct e m = m |> { MNo PFail ; MT r (pcaseB ct e (pbrs ct r)) }
pcaseB ct e q = q |> { PBFail PFail ; PB bs r (want isRC r |> { MNo PFail ; MT r2 (pcase ct (PE (ECase e bs) r2)) }) }
papp ct ts = papp2 ct (patom ct ts)
papp2 ct p = p |> { PFail PFail ; PE e r (headIs atomStart r |> { Yes (papp3 ct e (patom ct r)) ; No p }) }
papp3 ct e p = p |> { PFail PFail ; PE a r (papp2 ct (PE (EApp (EAp e a)) r)) }
patom ct ts = ts |> { TNil PFail ; TCons t r (patomT ct t r) }
patomT ct t r = t |> { TName n (pqual (EVar n) r) ; TAxis n (pwrap (EPick n) (patom ct r)) ; TTypeDecl PFail ; TCase PFail ; TAssign PFail ; TEq PFail ; TAlt PFail ; TLam (plam ct r) ; TDot PFail ; TSemi PFail ; TLP (pclose isRP (pexpr ct r)) ; TRP PFail ; TLB (pcell (pitems ct r)) ; TRB PFail ; TLC PFail ; TRC PFail ; TNl PFail ; TColon PFail ; TArrow PFail ; TMacro PFail ; TCMacro PFail ; TQOpen (pquote ct r) ; TQClose PFail ; TTurn PFail ; TFuel n PFail ; TFuelE PFail ; TScry (ppath ct r |> { PPFail PFail ; PP p r2 (PE (EScry p) r2) }) ; TNsOpen (pns ct r) ; TMapsTo PFail ; TComma PFail ; TSlash PFail ; TGlue PFail ; TNum n (PE (ENum n) r) ; TBad PFail }
-- a qualified name, `a.b.c`: a name and `.name` after it, one name that
-- no table holds (parser.py atom)
pqual e r = r |> { TNil (PE e r) ; TCons t r2 (isDot t |> { Yes (r2 |> { TNil (PE e r) ; TCons u r3 (nameOf u |> { MName m (pqual (EVar idQual) r3) ; MNone (PE e r) }) }) ; No (PE e r) }) }
-- a path, one or more `/tag`, each perhaps with `[payload]`
ppath ct r = headIs isSlash r |> { No PPFail ; Yes (pseg ct (ttl r)) }
pseg ct r = r |> { TNil PPFail ; TCons t r2 (nameOf t |> { MNone PPFail ; MName g (headIs isLB r2 |> { Yes (pexpr ct (ttl r2) |> { PFail PPFail ; PE e r3 (want isRB r3 |> { MNo PPFail ; MT r4 (pmore ct g (ISome e) r4) }) }) ; No (headIs isGlue r2 |> { Yes (PP (PSeg g INone PNil) (ttl r2)) ; No (pmore ct g INone r2) }) }) }) }
pmore ct g pay r = headIs isSlash r |> { Yes (pseg ct (ttl r) |> { PPFail PPFail ; PP p r2 (PP (PSeg g pay p) r2) }) ; No (PP (PSeg g pay PNil) r) }
-- a namespace literal: `ns{` facts `/path => value`, by commas, `}`
pns ct r = headIs isRC r |> { Yes (PE (ENs FtNil) (ttl r)) ; No (pfacts ct r |> { PFtFail PFail ; PFt fs r2 (want isRC r2 |> { MNo PFail ; MT r3 (PE (ENs fs) r3) }) }) }
pfacts ct r = ppath ct r |> { PPFail PFtFail ; PP p r2 (want isMapsTo r2 |> { MNo PFtFail ; MT r3 (pexpr ct r3 |> { PFail PFtFail ; PE e r4 (headIs isComma r4 |> { Yes (pfacts ct (ttl r4) |> { PFtFail PFtFail ; PFt fs r5 (PFt (FtCons p e fs) r5) }) ; No (PFt (FtCons p e FtNil) r4) }) }) }) }
-- a quotation, and the fuel straight after its `>`
pquote ct r = pexpr ct r |> { PFail PFail ; PE e r2 (want isQClose r2 |> { MNo PFail ; MT r3 (r3 |> { TNil (PE (EQuote e FNone INone) r3) ; TCons t r4 (fuelOf t |> { FNone (PE (EQuote e FNone INone) r3) ; FNum k (PE (EQuote e (FNum k) INone) r4) ; FPol (PE (EQuote e FPol INone) r4) }) }) }) }
pturn ct e m = m |> { MNo PFail ; MT r (pquote ct r |> { PFail PFail ; PE q r2 (q |> { EQuote b f i (pcase ct (PE (EQuote b f (ISome e)) r2)) ; EVar n PFail ; EApp a PFail ; ECell xs PFail ; EPick k x PFail ; ECase x bs PFail ; ELam x b PFail ; EScry p PFail ; ENs fs PFail ; ENum k PFail }) }) }
pwrap f p = p |> { PFail PFail ; PE e r (PE (f e) r) }
pclose q p = p |> { PFail PFail ; PE e r (want q r |> { MNo PFail ; MT r2 (PE e r2) }) }
plam ct r = r |> { TNil PFail ; TCons t r2 (nameOf t |> { MNone PFail ; MName x (want isDot r2 |> { MNo PFail ; MT r3 (pwrap (ELam x) (pexpr ct r3)) }) }) }
pitems ct ts = headIs atomStart ts |> { Yes (pitems2 ct (patom ct ts)) ; No (PX XNil ts) }
pitems2 ct p = p |> { PFail PXFail ; PE e r (pitems3 e (pitems ct r)) }
pitems3 e q = q |> { PXFail PXFail ; PX xs r (PX (XCons e xs) r) }
pcell q = q |> { PXFail PFail ; PX xs r (twoPlus xs |> { No PFail ; Yes (want isRB r |> { MNo PFail ; MT r2 (PE (ECell xs) r2) }) }) }
twoPlus xs = xs |> { XNil No ; XCons a r (r |> { XNil No ; XCons b r2 Yes }) }
pbrs ct ts = ts |> { TNil PBFail ; TCons t r (nameOf t |> { MNone PBFail ; MName c (findCI c ct |> { MCNone PBFail ; MC x (x |> { CInfo n tn i k (pbr1 ct c (pbind k r)) }) }) }) }
pbr1 ct c q = q |> { PNFail PBFail ; PN bs r (pbr2 ct c bs (pexpr ct r)) }
pbr2 ct c bs p = p |> { PFail PBFail ; PE e r (headIs isSemi r |> { Yes (pbr3 (Br c bs e) (pbrs ct (ttl r))) ; No (PB (BCons (Br c bs e) BNil) r) }) }
pbr3 b q = q |> { PBFail PBFail ; PB bs r (PB (BCons b bs) r) }
pbind k ts = k |> { Zero (PN NmNil ts) ; Suc j (ts |> { TNil PNFail ; TCons t r (nameOf t |> { MNone PNFail ; MName n (pbind2 n (pbind j r)) }) }) }
pbind2 n q = q |> { PNFail PNFail ; PN ns r (PN (NmCons n ns) r) }
-- parsing: declarations, one per line, each opened by a run of names; a
-- signature is parsed and dropped; `:=` before `{` opens a core
pprog ct ts = ts |> { TNil (PQ DNil SgNil) ; TCons t r (isNl t |> { Yes (pprog ct r) ; No (pdecl ct (heads ts)) }) }
heads ts = ts |> { TNil (HN NmNil ts) ; TCons t r (nameOf t |> { MNone (HN NmNil ts) ; MName n (hcons n (heads r)) }) }
hcons n h = h |> { HN ns r (HN (NmCons n ns) r) }
pdecl ct h = h |> { HN ns r (ns |> { NmNil PQFail ; NmCons n bs (r |> { TNil PQFail ; TCons t r2 (declOp t |> { OType (bs |> { NmNil (ptype ct n (ptc r2)) ; NmCons x y PQFail }) ; OEq (pdEnd ct (DEq n bs) (pexpr ct r2)) ; ODef (headIs isLC r2 |> { Yes (pcore ct n bs (pceqs ct bs (ttl r2))) ; No (bs |> { NmNil (pdEnd ct (DDef n) (pexpr ct r2)) ; NmCons x y PQFail }) }) ; OSig (bs |> { NmNil (psig ct n NmNil r2) ; NmCons x y PQFail }) ; OMacro (pdEnd ct (DMacro n bs No) (pexpr ct r2)) ; OCMacro (pdEnd ct (DMacro n bs Yes) (pexpr ct r2)) ; ONone PQFail }) }) }) }
atEnd r = r |> { TNil Yes ; TCons t r2 (isNl t) }
pdEnd ct f p = p |> { PFail PQFail ; PE e r (atEnd r |> { Yes (pdMore (f e) (pprog ct r)) ; No PQFail }) }
pdMore d q = q |> { PQFail PQFail ; PQ ds sg (PQ (DCons d ds) sg) }
ptype ct n q = q |> { PFFail PQFail ; PF cs fs r (atEnd r |> { Yes (pdMore (DType n cs fs) (pprog ct r)) ; No PQFail }) }
ptc r = r |> { TNil PFFail ; TCons t r2 (nameOf t |> { MNone PFFail ; MName c (ptc2 c (heads r2)) }) }
ptc2 c h = h |> { HN fs r (headIs isAlt r |> { Yes (ptc (ttl r) |> { PFFail PFFail ; PF cs fss r2 (PF (NmCons c cs) (FsCons fs fss) r2) }) ; No (PF (NmCons c NmNil) (FsCons fs FsNil) r) }) }
psig ct n ts r = r |> { TNil PQFail ; TCons t r2 (nameOf t |> { MNone PQFail ; MName x (headIs isArrow r2 |> { Yes (psig ct n (appN ts (nms1 x)) (ttl r2)) ; No (atEnd r2 |> { Yes (psMore n (appN ts (nms1 x)) (pprog ct r2)) ; No PQFail }) }) }) }
-- a signature, kept for Stage B: its name and its types, the result last
psMore n ts q = q |> { PQFail PQFail ; PQ ds sg (PQ ds (SgCons n ts sg)) }
-- a core's equations, to its `}`: each ends at a newline or the `}`
pcore ct n ps q = q |> { PCFail PQFail ; PC es r (atEnd r |> { Yes (pdMore (DCore n ps es) (pprog ct r)) ; No PQFail }) }
pceqs ct ps ts = ts |> { TNil PCFail ; TCons t r (isNl t |> { Yes (pceqs ct ps r) ; No (isRC t |> { Yes (PC DNil r) ; No (pceq ct ps (heads ts)) }) }) }
pceq ct ps h = h |> { HN ns r (ns |> { NmNil PCFail ; NmCons n bs (r |> { TNil PCFail ; TCons t r2 (declOp t |> { OEq (pceq2 ct ps (DEq n (appN ps bs)) (pexpr ct r2)) ; OType PCFail ; ODef PCFail ; OSig PCFail ; OMacro PCFail ; OCMacro PCFail ; ONone PCFail }) }) }) }
pceq2 ct ps f p = p |> { PFail PCFail ; PE e r (atEndC r |> { Yes (pcMore (f e) (pceqs ct ps r)) ; No PCFail }) }
atEndC r = r |> { TNil Yes ; TCons t r2 (orB (isNl t) (isRC t)) }
pcMore d q = q |> { PCFail PCFail ; PC ds r (PC (DCons d ds) r) }
-- interpreter generation (generate.py), before macros: a program with an
-- object type, one constructor of two fields of its own type and every
-- other a leaf, gains the walker, the rebuilder and the default step
-- equations, each unless the program names it, and each interpreter core
-- its step and fuel loop, unless the core writes them
isApp n f = f |> { NmNil No ; NmCons a r (r |> { NmNil No ; NmCons b r2 (r2 |> { NmNil (andB (eqId a n) (eqId b n)) ; NmCons c r3 No }) }) }
isNilN f = f |> { NmNil Yes ; NmCons a r No }
nApps n fs = fs |> { FsNil Zero ; FsCons f r (isApp n f |> { Yes (Suc (nApps n r)) ; No (nApps n r) }) }
leafOr n fs = fs |> { FsNil Yes ; FsCons f r (andB (orB (isApp n f) (isNilN f)) (leafOr n r)) }
appOf n cs fs = cs |> { NmNil idNone ; NmCons c r (fs |> { FsNil idNone ; FsCons f fr (isApp n f |> { Yes c ; No (appOf n r fr) }) }) }
objT n cs fs acc = nApps n fs |> { Zero acc ; Suc k (k |> { Suc j ObErr ; Zero (leafOr n fs |> { No ObErr ; Yes (acc |> { ObNone (Ob n cs fs (appOf n cs fs)) ; Ob a b c e ObErr ; ObErr ObErr }) }) }) }
objOf ds acc = ds |> { DNil acc ; DCons d r (objOf r (d |> { DType n cs fs (objT n cs fs acc) ; DEq n bs x acc ; DDef n x acc ; DMacro n ps c x acc ; DCore n ps es acc ; DCEq c n rn bs x acc })) }
-- the outcome-shaped types: two constructors or more, one carrying just
-- an object term; the first such constructor is the carrier
carrierOf on cs fs = cs |> { NmNil MNone ; NmCons c r (fs |> { FsNil MNone ; FsCons f fr (f |> { NmNil (carrierOf on r fr) ; NmCons a r2 (andB (isNilN r2) (eqId a on) |> { Yes (MName c) ; No (carrierOf on r fr) }) }) }) }
candsOf on ds = ds |> { DNil CdNil ; DCons d r (d |> { DType n cs fs (andB (notB (eqId n on)) (geN (lenN cs) two) |> { No (candsOf on r) ; Yes (carrierOf on cs fs |> { MNone (candsOf on r) ; MName c (CdCons (Cd n cs fs c) (candsOf on r)) }) }) ; DEq n bs x (candsOf on r) ; DDef n x (candsOf on r) ; DMacro n ps c x (candsOf on r) ; DCore n ps es (candsOf on r) ; DCEq c n rn bs x (candsOf on r) }) }
-- the step outcome and the result are the last two; with one, the same
pickOR cs = cs |> { CdNil LTErr ; CdCons a r (r |> { CdNil (ltBuild a a) ; CdCons b r2 (pickOR2 a b r2) }) }
pickOR2 a b r = r |> { CdNil (ltBuild a b) ; CdCons c r2 (pickOR2 b c r2) }
nullsOf cs fs = cs |> { NmNil NmNil ; NmCons c r (fs |> { FsNil NmNil ; FsCons f fr (isNilN f |> { Yes (NmCons c (nullsOf r fr)) ; No (nullsOf r fr) }) }) }
lastN ns d = ns |> { NmNil d ; NmCons n r (lastN r n) }
initN ns = ns |> { NmNil NmNil ; NmCons n r (r |> { NmNil NmNil ; NmCons m r2 (NmCons n (initN r)) }) }
nthN ns i = ns |> { NmNil idNone ; NmCons n r (i |> { Zero n ; Suc k (nthN r k) }) }
nthF fs i = fs |> { FsNil NmNil ; FsCons f r (i |> { Zero f ; Suc k (nthF r k) }) }
firstNull sd cs fs = cs |> { NmNil MNone ; NmCons c r (fs |> { FsNil MNone ; FsCons f fr (andB (notB (eqId c sd)) (isNilN f) |> { Yes (MName c) ; No (firstNull sd r fr) }) }) }
ltBuild o q = o |> { Cd on ocs ofs sd (q |> { Cd rn rcs rfs val (eqN (lenN ocs) (lenN rcs) |> { No LTErr ; Yes (nullsOf rcs rfs |> { NmNil LTErr ; NmCons x y (firstNull sd ocs ofs |> { MNone LTErr ; MName dn (conts sd dn ocs ofs rcs rfs Zero (initN (nullsOf rcs rfs)) |> { CKErr LTErr ; CKs ks sp (LT sd dn val (lastN (nullsOf rcs rfs) idNone) ks on rn) }) }) }) }) }) }
-- the carrier continues, the first other leaf is done, a constructor with
-- a payload is the result's at its position, the other leaves the result's
-- spare leaves in turn
conts sd dn ocs ofs rcs rfs i sp = ocs |> { NmNil (CKs CkNil sp) ; NmCons c r (ofs |> { FsNil CKErr ; FsCons f fr (eqId c sd |> { Yes (ckCons CkStep (conts sd dn r fr rcs rfs (Suc i) sp)) ; No (eqId c dn |> { Yes (ckCons CkDone (conts sd dn r fr rcs rfs (Suc i) sp)) ; No (isNilN f |> { No (eqN (lenN f) (lenN (nthF rfs i)) |> { No CKErr ; Yes (ckCons (CkTo (nthN rcs i)) (conts sd dn r fr rcs rfs (Suc i) sp)) }) ; Yes (sp |> { NmNil CKErr ; NmCons s sr (ckCons (CkTo s) (conts sd dn r fr rcs rfs (Suc i) sr)) }) }) }) }) }) }
ckCons k q = q |> { CKErr CKErr ; CKs ks sp (CKs (CkCons k ks) sp) }
-- names built at run time: `res` and `step` before a constructor's name,
-- `c` before a number
ten := mul10 one
decimal n = geN n ten |> { No (NCons (digitCode n) NNil) ; Yes (dm10 n Zero |> { QR q r (catN (decimal q) (NCons (digitCode r) NNil)) }) }
dm10 n q = geN n ten |> { No (QR q n) ; Yes (dm10 (minus n ten) (Suc q)) }
digitCode v0 = v0 |> { Zero codeD0 ; Suc v1 (v1 |> { Zero codeD1 ; Suc v2 (v2 |> { Zero codeD2 ; Suc v3 (v3 |> { Zero codeD3 ; Suc v4 (v4 |> { Zero codeD4 ; Suc v5 (v5 |> { Zero codeD5 ; Suc v6 (v6 |> { Zero codeD6 ; Suc v7 (v7 |> { Zero codeD7 ; Suc v8 (v8 |> { Zero codeD8 ; Suc v9 codeD9 }) }) }) }) }) }) }) }) }
lookPre pre ns st = ns |> { NmNil (NQ NmNil st) ; NmCons n r (st |> { Ist tab rv nx (look (catN pre (nameFor rv n)) st |> { IA b st2 (lookPre pre r st2 |> { NQ is st3 (NQ (NmCons (Id b) is) st3) }) }) }) }
lookCs k i st = k |> { Zero (NQ NmNil st) ; Suc j (look (catN nameGLowC (decimal i)) st |> { IA b st2 (lookCs j (Suc i) st2 |> { NQ is st3 (NQ (NmCons (Id b) is) st3) }) }) }
-- expressions written
ev n = EVar n
ea f a = EApp (EAp f a)
ea2 f a b = ea (ea f a) b
evs ns = ns |> { NmNil XNil ; NmCons n r (XCons (EVar n) (evs r)) }
appXs a b = a |> { XNil b ; XCons x r (XCons x (appXs r b)) }
appD a b = a |> { DNil b ; DCons d r (DCons d (appD r b)) }
nms1 a = NmCons a NmNil
nms2 a b = NmCons a (nms1 b)
nms3 a b c = NmCons a (nms2 b c)
nms4 a b c d = NmCons a (nms3 b c d)
genProg ds st = objOf ds ObNone |> { ObNone (GQ ds st) ; ObErr GQErr ; Ob on cs fs apc (pickOR (candsOf on ds) |> { LTErr GQErr ; LT sd dn val to ks on2 rn2 (gen2 ds cs apc (leavesOf apc cs) sd dn val to ks st) }) }
leavesOf apc cs = cs |> { NmNil NmNil ; NmCons c r (eqId c apc |> { Yes r ; No (NmCons c (leavesOf apc r)) }) }
gen2 ds cs apc lv sd dn val to ks st = lookPre nameGRes lv st |> { NQ rs st2 (lookPre nameGStep cs st2 |> { NQ ss st3 (lookPre nameGStep lv st3 |> { NQ sl st4 (lookCs (lenN lv) Zero st4 |> { NQ cis st5 (fillAll ds ss lv sl sd dn val to ks |> { PDFail GQErr ; PD ds2 (GQ (appD ds2 (notTaken (setOf (takenOf ds) Ns0) (extras cs apc lv rs cis sd dn))) st5) }) }) }) }) }
takenOf ds = ds |> { DNil NmNil ; DCons d r (d |> { DType n cs fs (appN cs (takenOf r)) ; DEq n bs x (NmCons n (takenOf r)) ; DDef n x (NmCons n (takenOf r)) ; DMacro n ps c x (NmCons n (takenOf r)) ; DCore n ps es (NmCons n (takenOf r)) ; DCEq c n rn bs x (takenOf r) }) }
notTaken tk ds = ds |> { DNil DNil ; DCons d r (d |> { DEq n bs x (sHas n tk |> { Yes (notTaken tk r) ; No (DCons d (notTaken tk r)) }) ; DDef n x (DCons d (notTaken tk r)) ; DType n cs fs (DCons d (notTaken tk r)) ; DMacro n ps c x (DCons d (notTaken tk r)) ; DCore n ps es (DCons d (notTaken tk r)) ; DCEq c n rn bs x (DCons d (notTaken tk r)) }) }
-- the walker and the rebuilder, then the default steps
extras cs apc lv rs cis sd dn = appD (resEqs rs cis cis) (DCons (DEq idGSpApp (nms4 idGF idGAcc idGT idGU) (ea2 (ev idGF) (ev idGT) (ea2 (ev idCons) (ev idGU) (ev idGAcc)))) (DCons (DEq idGSp (nms2 idGM idGAcc) (appsE (ev idGM) (spSlots cs apc rs))) (DCons (DEq idGRb1 (nms4 idGF idGH idGX idGXs) (ea2 (ev idGF) (ea2 (ev apc) (ev idGH) (ev idGX)) (ev idGXs))) (DCons (DEq idGRb (nms2 idGH idGArgs) (ea2 (ev idGArgs) (ev idGH) (ea2 (ev idGRb1) (ev idGRb) (ev idGH)))) (defSteps lv apc sd dn)))))
resEqs rs cs cis = rs |> { NmNil DNil ; NmCons r rr (cis |> { NmNil DNil ; NmCons c cr (DCons (DEq r (NmCons idGAcc cs) (ea (ev c) (ev idGAcc))) (resEqs rr cs cr)) }) }
spSlots cs apc rs = cs |> { NmNil XNil ; NmCons c r (eqId c apc |> { Yes (XCons (ea2 (ev idGSpApp) (ev idGSp) (ev idGAcc)) (spSlots r apc rs)) ; No (rs |> { NmNil XNil ; NmCons q rr (XCons (ea (ev q) (ev idGAcc)) (spSlots r apc rr)) }) }) }
defSteps lv apc sd dn = appD (memN idI lv |> { No DNil ; Yes (DCons (DEq idGStepI1 (nms2 idGX idGRest) (ea (ev sd) (ea2 (ev idGRb) (ev idGX) (ev idGRest)))) (DCons (DEq idGStepI (nms1 idGArgs) (ea2 (ev idGArgs) (ev dn) (ev idGStepI1))) DNil)) }) (appD (memN idK lv |> { No DNil ; Yes (DCons (DEq idGStepK2 (nms3 idGX idGY idGRest) (ea (ev sd) (ea2 (ev idGRb) (ev idGX) (ev idGRest)))) (DCons (DEq idGStepK1 (nms2 idGX idGR) (ea2 (ev idGR) (ev dn) (ea (ev idGStepK2) (ev idGX)))) (DCons (DEq idGStepK (nms1 idGArgs) (ea2 (ev idGArgs) (ev dn) (ev idGStepK1))) DNil))) }) (memN idS lv |> { No DNil ; Yes (DCons (DEq idGStepS3 (nms4 idGX idGY idGZ idGRest) (ea (ev sd) (ea2 (ev idGRb) (ea2 (ev apc) (ea2 (ev apc) (ev idGX) (ev idGZ)) (ea2 (ev apc) (ev idGY) (ev idGZ))) (ev idGRest)))) (DCons (DEq idGStepS2 (nms3 idGX idGY idGR2) (ea2 (ev idGR2) (ev dn) (ea2 (ev idGStepS3) (ev idGX) (ev idGY)))) (DCons (DEq idGStepS1 (nms2 idGX idGR) (ea2 (ev idGR) (ev dn) (ea (ev idGStepS2) (ev idGX)))) (DCons (DEq idGStepS (nms1 idGArgs) (ea2 (ev idGArgs) (ev dn) (ev idGStepS1))) DNil)))) }))
-- an interpreter core writes `step`, `loop` or a step for a constructor
fillAll ds ss lv sl sd dn val to ks = ds |> { DNil (PD DNil) ; DCons d r (fillAll r ss lv sl sd dn val to ks |> { PDFail PDFail ; PD ds2 (d |> { DCore n ps es (orB (orB (memN idGStep (orderOf es)) (memN idLoop (orderOf es))) (anyIn ss (orderOf es)) |> { No (PD (DCons d ds2)) ; Yes (fillCore n ps es (orderOf es) lv sl sd dn val to ks |> { PDFail PDFail ; PD es2 (PD (DCons (DCore n ps es2) ds2)) }) }) ; DEq n bs x (PD (DCons d ds2)) ; DDef n x (PD (DCons d ds2)) ; DType n cs fs (PD (DCons d ds2)) ; DMacro n ps c x (PD (DCons d ds2)) ; DCEq c n rn bs x (PD (DCons d ds2)) }) }) }
anyIn ns hv = ns |> { NmNil No ; NmCons n r (orB (memN n hv) (anyIn r hv)) }
fillCore n ps es hv lv sl sd dn val to ks = memN idLoop hv |> { Yes (PD (appD es (stepEq ps hv sl))) ; No (memN idGLoop1 hv |> { Yes PDFail ; No (PD (appD es (appD (stepEq ps hv sl) (DCons (DEq idGLoop1 (appN ps (nms3 idGF idGM idGN2)) (appsE (appsE (ev idGStep) (evs ps)) (XCons (ev idGM) (contEs ps val ks)))) (DCons (DEq idLoop (appN ps (nms2 idGN idGM)) (ea2 (ev idGN) (ev to) (ea2 (appsE (ev idGLoop1) (evs ps)) (ev idLoop) (ev idGM)))) DNil))))) }) }
stepEq ps hv sl = memN idGStep hv |> { Yes DNil ; No (DCons (DEq idGStep (appN ps (nms1 idGM)) (appsE (ev idGSp) (XCons (ev idGM) (XCons (ev idNil) (stepSlots ps hv sl))))) DNil) }
stepSlots ps hv sl = sl |> { NmNil XNil ; NmCons s r (XCons (memN s hv |> { Yes (appsE (ev s) (evs ps)) ; No (ev s) }) (stepSlots ps hv r)) }
contEs ps val ks = ks |> { CkNil XNil ; CkCons k r (XCons (k |> { CkStep (appsE (ev idGF) (appXs (evs ps) (XCons (ev idGN2) XNil))) ; CkDone (ea (ev val) (ev idGM)) ; CkTo c (ev c) }) (contEs ps val r)) }
-- macros (expand.py, expand_macros): every body expanded to a fixed
-- point, the last definition of a name winning; a lambda's or a branch's
-- binder hides a macro of its name, an equation's binders do not.  Three
-- limits, each a refusal: nesting past 256 levels, unfolding past 100 on
-- one path, and 200,000 substitutions in one body
macsOf ds acc = ds |> { DNil acc ; DCons d r (macsOf r (d |> { DMacro n ps c x (McCons n ps c x acc) ; DEq n bs x acc ; DDef n x acc ; DType n cs fs acc ; DCore n ps es acc ; DCEq c n rn bs x acc })) }
findMac n ms = ms |> { McNil MMNone ; McCons m ps c b r (eqId n m |> { Yes (MM ps c b) ; No (findMac n r) }) }
visM n hid ms = memN n hid |> { Yes MMNone ; No (findMac n ms) }
macHead ms hid e = e |> { EVar n (visM n hid ms) ; EApp p (p |> { EAp f a (macHead ms hid f) }) ; ECell xs MMNone ; EPick k x MMNone ; ECase x bs MMNone ; ELam x b MMNone ; EQuote b fu i MMNone ; EScry p MMNone ; ENs fs MMNone ; ENum k MMNone }
spArgs e acc = e |> { EVar n acc ; EApp p (p |> { EAp f a (spArgs f (XCons a acc)) }) ; ECell xs acc ; EPick k x acc ; ECase x bs acc ; ELam x b acc ; EQuote b fu i acc ; EScry p acc ; ENs fs acc ; ENum k acc }
dbl n = add n n
depth0 := Suc (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl one))))))))
unfold0 := Suc (mul10 (mul10 one))
work0 := Bz (Bz (Bz (Bz (Bz (Bz (Bo (Bz (Bo (Bz (Bo (Bo (Bz (Bz (Bz (Bz (Bo (Bo Bn)))))))))))))))))
isZB b = b |> { Bn Yes ; Bz r (isZB r) ; Bo r No }
decW b = b |> { Bn Bn ; Bo r (Bz r) ; Bz r (Bo (decW r)) }
-- a fresh binder: a counter with two zeros above its top bit, a form no
-- interned number or group key takes
freshBits b = b |> { Bn (Bz (Bz Bn)) ; Bz r (Bz (freshBits r)) ; Bo r (Bo (freshBits r)) }
mxTop ms x = mxE ms NmNil depth0 unfold0 work0 Bn x
-- dep and unf count down the levels and unfoldings left; wk the work
mxE ms hid dep unf wk fr e = dep |> { Zero MXFail ; Suc dk (unf |> { Zero MXFail ; Suc uk (isZB wk |> { Yes MXFail ; No (mxE2 ms hid dep dk unf uk wk fr e) }) }) }
mxE2 ms hid dep dk unf uk wk fr e = e |> { EVar n (visM n hid ms |> { MMNone (MX e wk fr) ; MM ps c b (ps |> { NmNil (mxE ms hid dep uk (decW wk) fr b) ; NmCons q r MXFail }) }) ; EApp p (macHead ms hid e |> { MMNone (mxAp ms hid dk unf wk fr p) ; MM ps c b (c |> { Yes MXFail ; No (geN (lenXs (spArgs e XNil)) (lenN ps) |> { No MXFail ; Yes (mxMac ms hid dep uk ps b (mxL ms hid dk unf wk fr (spArgs e XNil))) }) }) }) ; ECell xs (mxCell (mxL ms hid dk unf wk fr xs)) ; EPick k x (mxWrap (EPick k) (mxE ms hid dk unf wk fr x)) ; ECase x bs (mxCase ms hid dk unf (mxE ms hid dk unf wk fr x) bs) ; ELam x b (mxWrap (ELam x) (mxE ms (NmCons x hid) dk unf wk fr b)) ; EQuote b fu i MXFail ; EScry p MXFail ; ENs fs MXFail ; ENum k (MX e wk fr) }
mxWrap f q = q |> { MXFail MXFail ; MX e w r (MX (f e) w r) }
mxAp ms hid dk unf wk fr p = p |> { EAp f a (mxAp2 ms hid dk unf a (mxE ms hid dk unf wk fr f)) }
mxAp2 ms hid dk unf a q = q |> { MXFail MXFail ; MX f w r (mxE ms hid dk unf w r a |> { MXFail MXFail ; MX a2 w2 r2 (MX (EApp (EAp f a2)) w2 r2) }) }
mxL ms hid dk unf wk fr xs = xs |> { XNil (MXs XNil wk fr) ; XCons x r (mxL2 ms hid dk unf r (mxE ms hid dk unf wk fr x)) }
mxL2 ms hid dk unf r q = q |> { MXFail MXsFail ; MX e w f (mxL ms hid dk unf w f r |> { MXsFail MXsFail ; MXs xs w2 f2 (MXs (XCons e xs) w2 f2) }) }
mxCell q = q |> { MXsFail MXFail ; MXs xs w f (MX (ECell xs) w f) }
mxCase ms hid dk unf q bs = q |> { MXFail MXFail ; MX x w f (mxBs ms hid dk unf w f bs |> { MXbFail MXFail ; MXb bs2 w2 f2 (MX (ECase x bs2) w2 f2) }) }
mxBs ms hid dk unf wk fr bs = bs |> { BNil (MXb BNil wk fr) ; BCons b r (b |> { Br c ns x (mxBs2 ms hid dk unf c ns r (mxE ms (appN ns hid) dk unf wk fr x)) }) }
mxBs2 ms hid dk unf c ns r q = q |> { MXFail MXbFail ; MX x w f (mxBs ms hid dk unf w f r |> { MXbFail MXbFail ; MXb bs w2 f2 (MXb (BCons (Br c ns x) bs) w2 f2) }) }
-- a macro applied: its arguments expanded, then its body with them
-- substituted, then that expanded, then any arguments past its parameters
mxMac ms hid dep uk ps b q = q |> { MXsFail MXFail ; MXs xs w f (sbE (zipS ps xs SbNil) b f |> { SE body f2 (mxE ms hid dep uk (decW w) f2 body |> { MXFail MXFail ; MX e w2 f3 (MX (appsE e (dropX (lenN ps) xs)) w2 f3) }) }) }
geN m n = n |> { Zero Yes ; Suc k (m |> { Zero No ; Suc j (geN j k) }) }
lenXs xs = xs |> { XNil Zero ; XCons x r (Suc (lenXs r)) }
dropX n xs = n |> { Zero xs ; Suc k (xs |> { XNil XNil ; XCons x r (dropX k r) }) }
appsE e xs = xs |> { XNil e ; XCons x r (appsE (EApp (EAp e x)) r) }
-- a parameter named twice takes the later argument
zipS ps xs acc = ps |> { NmNil acc ; NmCons p r (xs |> { XNil acc ; XCons x xr (zipS r xr (SbCons p x (sbDel p acc))) }) }
sbFind n s = s |> { SbNil MExNone ; SbCons k t r (eqId n k |> { Yes (MEx t) ; No (sbFind n r) }) }
sbDel n s = s |> { SbNil SbNil ; SbCons k t r (eqId n k |> { Yes (sbDel n r) ; No (SbCons k t (sbDel n r)) }) }
sbDelAll ns s = ns |> { NmNil s ; NmCons n r (sbDelAll r (sbDel n s)) }
-- free names as expand.py has them: a branch's constructor is one
freeE n e = e |> { EVar m (eqId n m) ; EApp p (p |> { EAp f a (orB (freeE n f) (freeE n a)) }) ; ECell xs (freeX n xs) ; EPick k x (freeE n x) ; ECase x bs (orB (freeE n x) (freeBs n bs)) ; ELam x b (eqId n x |> { Yes No ; No (freeE n b) }) ; EQuote b fu i (orB (freeE n b) (i |> { INone No ; ISome x (freeE n x) })) ; EScry p (freeP n p) ; ENs fs (freeFt n fs) ; ENum k No }
freeP n p = p |> { PNil No ; PSeg g pay r (orB (pay |> { INone No ; ISome x (freeE n x) }) (freeP n r)) }
freeFt n fs = fs |> { FtNil No ; FtCons p x r (orB (freeP n p) (orB (freeE n x) (freeFt n r))) }
freeX n xs = xs |> { XNil No ; XCons x r (orB (freeE n x) (freeX n r)) }
freeBs n bs = bs |> { BNil No ; BCons b r (b |> { Br c ns x (orB (eqId n c) (orB (andB (notB (memN n ns)) (freeE n x)) (freeBs n r))) }) }
-- substitution, capture-avoiding: a binder is renamed only when it would
-- capture a name free in what is substituted under it (_rename_binders)
sbE s e f = s |> { SbNil (SE e f) ; SbCons k t r (sbE2 s e f) }
sbE2 s e f = e |> { EVar n (sbFind n s |> { MEx t (SE t f) ; MExNone (SE e f) }) ; EApp p (p |> { EAp g a (sbE s g f |> { SE g2 f2 (sbE s a f2 |> { SE a2 f3 (SE (EApp (EAp g2 a2)) f3) }) }) }) ; ECell xs (sbL s xs f |> { SEs ys f2 (SE (ECell ys) f2) }) ; EPick k x (sbE s x f |> { SE y f2 (SE (EPick k y) f2) }) ; ECase x bs (sbE s x f |> { SE y f2 (sbBs s bs f2 |> { SBr bs2 f3 (SE (ECase y bs2) f3) }) }) ; ELam x b (rnB s x b f |> { RB y b2 f2 (sbE (sbDel y s) b2 f2 |> { SE b3 f3 (SE (ELam y b3) f3) }) }) ; EQuote b fu i (sbE s b f |> { SE b2 f2 (i |> { INone (SE (EQuote b2 fu INone) f2) ; ISome x (sbE s x f2 |> { SE x2 f3 (SE (EQuote b2 fu (ISome x2)) f3) }) }) }) ; EScry p (SE e f) ; ENs fs (SE e f) ; ENum k (SE e f) }
sbL s xs f = xs |> { XNil (SEs XNil f) ; XCons x r (sbE s x f |> { SE y f2 (sbL s r f2 |> { SEs ys f3 (SEs (XCons y ys) f3) }) }) }
sbBs s bs f = bs |> { BNil (SBr BNil f) ; BCons b r (b |> { Br c ns x (rnAll s ns NmNil x f |> { RNs nb x2 f2 (sbE (sbDelAll nb s) x2 f2 |> { SE x3 f3 (sbBs s r f3 |> { SBr bs2 f4 (SBr (BCons (Br c nb x3) bs2) f4) }) }) }) }) }
danger s x b = s |> { SbNil No ; SbCons k t r (orB (andB (notB (eqId k x)) (andB (freeE k b) (freeE x t))) (danger r x b)) }
rnB s x b f = danger s x b |> { No (RB x b f) ; Yes (sbE (SbCons x (EVar (Id (freshBits f))) SbNil) b (inc f) |> { SE b2 f2 (RB (Id (freshBits f)) b2 f2) }) }
rnAll s ns acc x f = ns |> { NmNil (RNs (appN acc NmNil) x f) ; NmCons n r (rnB s n x f |> { RB y x2 f2 (rnAll s r (appN acc (NmCons y NmNil)) x2 f2) }) }
-- every body expanded: equations', definitions' and core equations'
xpand ms ds = ds |> { DNil (PD DNil) ; DCons d r (xpand ms r |> { PDFail PDFail ; PD ds2 (xpd ms d ds2) }) }
xpd ms d ds = xbody d |> { INone (d |> { DCore n ps es (xpand ms es |> { PDFail PDFail ; PD es2 (PD (DCons (DCore n ps es2) ds)) }) ; DEq n bs x (PD (DCons d ds)) ; DDef n x (PD (DCons d ds)) ; DType n cs fs (PD (DCons d ds)) ; DMacro n ps c x (PD (DCons d ds)) ; DCEq c n rn bs x (PD (DCons d ds)) }) ; ISome x (mxTop ms x |> { MXFail PDFail ; MX x2 w r (PD (DCons (xset d x2) ds)) }) }
-- the body an equation or a definition expands, and the declaration with
-- it expanded
xbody d = d |> { DEq n bs x (ISome x) ; DDef n x (isQuoteE x |> { Yes INone ; No (ISome x) }) ; DType n cs fs INone ; DMacro n ps c x INone ; DCore n ps es INone ; DCEq c n rn bs x INone }
xset d x2 = d |> { DEq n bs x (DEq n bs x2) ; DDef n x (DDef n x2) ; DType n cs fs d ; DMacro n ps c x d ; DCore n ps es d ; DCEq c n rn bs x d }
-- the subset: no binder is S, K or I
anySKI ns = ns |> { NmNil No ; NmCons n r (orB (isSKI n) (anySKI r)) }
skiE e = e |> { EVar n No ; EApp p (p |> { EAp f a (orB (skiE f) (skiE a)) }) ; ECell xs (skiX xs) ; EPick n x (skiE x) ; ECase x bs (orB (skiE x) (skiB bs)) ; ELam x b (orB (isSKI x) (skiE b)) ; EQuote b fu i (orB (skiE b) (i |> { INone No ; ISome x (skiE x) })) ; EScry p (skiP p) ; ENs fs (skiFt fs) ; ENum k No }
skiP p = p |> { PNil No ; PSeg g pay r (orB (pay |> { INone No ; ISome x (skiE x) }) (skiP r)) }
skiFt fs = fs |> { FtNil No ; FtCons p x r (orB (skiP p) (orB (skiE x) (skiFt r))) }
skiX xs = xs |> { XNil No ; XCons x r (orB (skiE x) (skiX r)) }
skiB bs = bs |> { BNil No ; BCons b r (b |> { Br c ns x (orB (anySKI ns) (orB (skiE x) (skiB r))) }) }
skiD ds = ds |> { DNil No ; DCons d r (orB (d |> { DEq n bs x (orB (anySKI bs) (skiE x)) ; DDef n x (skiE x) ; DType n cs fs No ; DMacro n ps c x No ; DCore n ps es (skiD es) ; DCEq c n rn bs x (orB (anySKI bs) (skiE x)) }) (skiD r)) }
orderOf ds = ds |> { DNil NmNil ; DCons d r (d |> { DType n cs fs (appN cs (orderOf r)) ; DEq n bs x (NmCons n (orderOf r)) ; DDef n x (NmCons n (orderOf r)) ; DMacro n ps c x (orderOf r) ; DCore n ps es (orderOf r) ; DCEq c n rn bs x (orderOf r) }) }
prelNotIn o ps = ps |> { NmNil NmNil ; NmCons p r (sHas p o |> { Yes (prelNotIn o r) ; No (NmCons p (prelNotIn o r)) }) }
-- desugaring: cells, picks, cases and literals to applications and lambdas
dapp f a = DApp (DAp f a)
dsg ct ys e = e |> { EVar n (DName n) ; EApp p (p |> { EAp f a (dapp (dsg ct ys f) (dsg ct ys a)) }) ; ECell xs (dcell ct ys xs) ; EPick n x (dpick n (dsg ct ys x)) ; ECase x bs (dcase ct ys (dsg ct ys x) bs) ; ELam x b (DLam x (dsg ct ys b)) ; EQuote b fu i DBad ; EScry p DBad ; ENs fs DBad ; ENum k (dnum k) }
-- a literal: suc applied n times to zero, spelled with S, K and I,
-- which no binder may be, so no definition of suc or zero reaches it
dnum n = n |> { Zero (DName idK) ; Suc m (dapp dsuc (dnum m)) }
dsuc := dapp (dapp (DName idS) (dapp (DName idK) (DName idK))) (dapp (dapp (DName idS) (dapp (DName idK) (dapp (DName idS) (DName idI)))) (DName idK))
dcell ct ys xs = xs |> { XNil DBad ; XCons x r (r |> { XNil (dsg ct ys x) ; XCons y r2 (dapp (dapp (DName idPair) (dsg ct ys x)) (dcell ct ys r)) }) }
halve n = n |> { Zero (HR Zero Lo) ; Suc m (m |> { Zero (HR Zero Hi) ; Suc k (halve k |> { HR q b (HR (Suc q) b) }) }) }
dpick n d = n |> { Zero DBad ; Suc m (m |> { Zero d ; Suc j (halve n |> { HR q b (dapp (DName (b |> { Lo idHd ; Hi idTl })) (dpick q d)) }) }) }
dcase ct ys s bs = bs |> { BNil DBad ; BCons b r (b |> { Br c ns x (findCI c ct |> { MCNone DBad ; MC i (i |> { CInfo cn tn ix ar (findTy tn ys |> { MTNone DBad ; MTy cs (andB (eqN (lenB bs) (lenN cs)) (allOnce cs bs) |> { Yes (dconts ct ys s cs bs) ; No DBad }) }) }) }) }) }
lenB bs = bs |> { BNil Zero ; BCons b r (Suc (lenB r)) }
countB c bs = bs |> { BNil Zero ; BCons b r (b |> { Br n ns x (eqId c n |> { Yes (Suc (countB c r)) ; No (countB c r) }) }) }
allOnce cs bs = cs |> { NmNil Yes ; NmCons c r (andB (eqN (countB c bs) (Suc Zero)) (allOnce r bs)) }
findB c bs = bs |> { BNil (Br c NmNil (EVar c)) ; BCons b r (b |> { Br n ns x (eqId c n |> { Yes b ; No (findB c r) }) }) }
dconts ct ys s cs bs = cs |> { NmNil s ; NmCons c r (dconts ct ys (dapp s (dcont ct ys (findB c bs))) r bs) }
dcont ct ys b = b |> { Br c ns x (lams ns (dsg ct ys x)) }
lams ns d = ns |> { NmNil d ; NmCons n r (DLam n (lams r d)) }
freeIn n d = d |> { DName m (eqId n m) ; DApp p (p |> { DAp f a (orB (freeIn n f) (freeIn n a)) }) ; DLam x b (eqId n x |> { Yes No ; No (freeIn n b) }) ; DBad No }
-- code generation: names resolved, lambdas lifted into rules
rapp f a = RAp (RA f a)
rapps t cs = cs |> { NmNil t ; NmCons c r (rapps (rapp t (RVar c)) r) }
findSub n ss = ss |> { SubNil MRNone ; SubCons k t v r (eqId n k |> { Yes (MR t) ; No (findSub n r) }) }
resolve env n = eqId n idS |> { Yes RS ; No (eqId n idK |> { Yes RK ; No (eqId n idI |> { Yes RI ; No (sHas n env |> { Yes (RRef n) ; No (bird n) }) }) }) }
-- the Tier 1 birds, last: a program's own name comes first
bird n = eqId n idB |> { Yes birdB ; No (eqId n idC |> { Yes birdC ; No (eqId n idW |> { Yes birdW ; No (eqId n idY |> { Yes yComb ; No RBad }) }) }) }
birdB := rapp (rapp RS (rapp RK RS)) RK
birdC := rapp (rapp RS (rapp (rapp RS (rapp RK RS)) (rapp (rapp RS (rapp RK RK)) RS))) (rapp RK RK)
birdW := rapp (rapp RS RS) (rapp RK RI)
lamPs d = d |> { DName n NmNil ; DApp p NmNil ; DLam x b (NmCons x (lamPs b)) ; DBad NmNil }
lamBody d = d |> { DName n d ; DApp p d ; DLam x b (lamBody b) ; DBad d }
gen env sc ss d = d |> { DName n (findSub n ss |> { MR t t ; MRNone (memN n sc |> { Yes (RVar n) ; No (resolve env n) }) }) ; DApp p (p |> { DAp f a (rapp (gen env sc ss f) (gen env sc ss a)) }) ; DLam x b (lift env sc ss (lamPs d) (lamBody d)) ; DBad RBad }
lift env sc ss ps body = liftR env (capture sc ss ps body) ss ps body
liftR env cs ss ps body = rapps (RRule (Rule (appN cs ps) (gen env (appN cs ps) (dropSubs ps ss) body))) cs
fv s ps body = andB (freeIn s body) (notB (memN s ps))
viaSub s ss ps body = ss |> { SubNil No ; SubCons k t v r (orB (andB (fv k ps body) (eqId s v)) (viaSub s r ps body)) }
capture sc ss ps body = sc |> { NmNil NmNil ; NmCons s r (orB (fv s ps body) (viaSub s ss ps body) |> { Yes (NmCons s (capture r ss ps body)) ; No (capture r ss ps body) }) }
dropSubs ps ss = ss |> { SubNil SubNil ; SubCons k t v r (memN k ps |> { Yes (dropSubs ps r) ; No (SubCons k t v (dropSubs ps r)) }) }
-- rules: the prelude, constructors, equations and definitions
dum n = n |> { Zero NmNil ; Suc k (NmCons idNone (dum k)) }
one := Suc Zero
two := Suc one
three := Suc two
four := Suc three
argsFrom t j k = k |> { Zero t ; Suc m (argsFrom (rapp t (RIx j)) (Suc j) m) }
preludeRules := rAdd idSuc (Rule (dum three) (rapp (RIx two) (RIx Zero))) (rAdd idZero (Rule (dum two) (RIx Zero)) (rAdd idCons (Rule (dum four) (rapp (rapp (RIx three) (RIx Zero)) (RIx one))) (rAdd idNil (Rule (dum two) (RIx Zero)) (rAdd idTl (Rule (dum one) (rapp (RIx Zero) (rapp RK RI))) (rAdd idHd (Rule (dum one) (rapp (RIx Zero) RK)) (rAdd idPair (Rule (dum three) (rapp (rapp (RIx two) (RIx Zero)) (RIx one))) Rm0))))))
arityOf ct c = findCI c ct |> { MCNone Zero ; MC x (x |> { CInfo n tn i k k }) }
ctorRule k i n = Rule (dum (add k n)) (argsFrom (RIx (add k i)) Zero k)
ctorsOf ct i n cs rs = cs |> { NmNil rs ; NmCons c r (ctorsOf ct (Suc i) n r (rAdd c (ctorRule (arityOf ct c) i n) rs)) }
ctorRules ct ys rs = ys |> { TyNil rs ; TyCons y r (y |> { TyInfo tn cs (ctorRules ct r (ctorsOf ct Zero (lenN cs) cs rs)) }) }
yComb := rapp (rapp RS (rapp RK (rapp (rapp RS RI) RI))) (rapp (rapp RS (rapp (rapp RS (rapp RK RS)) RK)) (rapp RK (rapp (rapp RS RI) RI)))
eqsOf ct ys ds = ds |> { DNil ExNil ; DCons d r (d |> { DEq n bs x (ExCons (EqX n bs (dsg ct ys x) NmNil) (eqsOf ct ys r)) ; DDef n x (eqsOf ct ys r) ; DType n cs fs (eqsOf ct ys r) ; DMacro n ps c x (eqsOf ct ys r) ; DCore n ps es (appEx (eqsOf ct ys es) (eqsOf ct ys r)) ; DCEq c n rn bs x (ExCons (EqX c bs (rnD rn bs (dsg ct ys x)) NmNil) (eqsOf ct ys r)) }) }
appEx a b = a |> { ExNil b ; ExCons q r (ExCons q (appEx r b)) }
-- in a core, a sibling's name, unbound and not S, K or I, is the sibling
rnD rn bd d = d |> { DName m (orB (memN m bd) (isSKI m) |> { Yes d ; No (rnFind m rn |> { MName c (DName c) ; MNone d }) }) ; DApp p (p |> { DAp f a (dapp (rnD rn bd f) (rnD rn bd a)) }) ; DLam x b (DLam x (rnD rn (NmCons x bd) b)) ; DBad DBad }
-- an equation's dependencies: the equations its body names outside its
-- binders; the groups are the strongly connected components (Tarjan)
fnames d bound acc = d |> { DName m (memN m bound |> { Yes acc ; No (NmCons m acc) }) ; DApp p (p |> { DAp f a (fnames f bound (fnames a bound acc)) }) ; DLam x b (fnames b (NmCons x bound) acc) ; DBad acc }
onlyIn s ns = ns |> { NmNil NmNil ; NmCons n r (sHas n s |> { Yes (NmCons n (onlyIn s r)) ; No (onlyIn s r) }) }
depsAll eqs es = es |> { ExNil ExNil ; ExCons q r (q |> { EqX n bs b d (ExCons (EqX n bs b (onlyIn eqs (fnames b bs NmNil))) (depsAll eqs r)) }) }
tjPut b x m = m |> { Tj0 (tjPut b x (TjT (TjB MTjNone Tj0 Tj0))) ; TjT t (t |> { TjB v z o (b |> { Bn (TjT (TjB x z o)) ; Bz r (TjT (TjB v (tjPut r x z) o)) ; Bo r (TjT (TjB v z (tjPut r x o))) }) }) }
tjGetB b m = m |> { Tj0 MTjNone ; TjT t (t |> { TjB v z o (b |> { Bn v ; Bz r (tjGetB r z) ; Bo r (tjGetB r o) }) }) }
tjSet n x m = tjPut (idBits n) (MTj x) m
tjGet n m = tjGetB (idBits n) m
tjInit es m = es |> { ExNil m ; ExCons q r (q |> { EqX n bs b d (tjInit r (tjSet n (TjE d No Zero Zero No) m)) }) }
minN a b = a |> { Zero Zero ; Suc j (b |> { Zero Zero ; Suc k (Suc (minN j k)) }) }
tarjan es s = es |> { ExNil s ; ExCons q r (q |> { EqX n bs b d (tarjan r (seen n s |> { Yes s ; No (strong n s) })) }) }
seen n s = s |> { Tst c stk m out (tjGet n m |> { MTjNone Yes ; MTj e (e |> { TjE d v i l o v }) }) }
strong v s = s |> { Tst c stk m out (tjGet v m |> { MTjNone s ; MTj e (e |> { TjE d vis i l o (finish v (edges v d (Tst (Suc c) (NmCons v stk) (tjSet v (TjE d Yes c c Yes) m) out))) }) }) }
edges v ws s = ws |> { NmNil s ; NmCons w r (edges v r (edge v w s)) }
edge v w s = s |> { Tst c stk m out (tjGet w m |> { MTjNone s ; MTj e (e |> { TjE d vis wi wl won (vis |> { No (lowOf v w (strong w s)) ; Yes (won |> { Yes (lower v wi s) ; No s }) }) }) }) }
lowOf v w s = s |> { Tst c stk m out (tjGet w m |> { MTjNone s ; MTj e (e |> { TjE d vis wi wl won (lower v wl s) }) }) }
lower v x s = s |> { Tst c stk m out (tjGet v m |> { MTjNone s ; MTj e (e |> { TjE d vis vi vl von (Tst c stk (tjSet v (TjE d vis vi (minN vl x) von) m) out) }) }) }
finish v s = s |> { Tst c stk m out (tjGet v m |> { MTjNone s ; MTj e (e |> { TjE d vis vi vl von (eqN vi vl |> { Yes (popTo v NmNil s) ; No s }) }) }) }
popTo v acc s = s |> { Tst c stk m out (stk |> { NmNil (Tst c stk m (ScCons acc out)) ; NmCons w r (popOff v w acc (Tst c r (offStack w m) out)) }) }
popOff v w acc s = eqId w v |> { Yes (s |> { Tst c stk m out (Tst c stk m (ScCons (NmCons w acc) out)) }) ; No (popTo v (NmCons w acc) s) }
offStack w m = tjGet w m |> { MTjNone m ; MTj e (e |> { TjE d vis i l o (tjSet w (TjE d vis i l No) m) }) }
gmPut b x m = m |> { Gm0 (gmPut b x (GmT (GmB MGNone Gm0 Gm0))) ; GmT t (t |> { GmB v z o (b |> { Bn (GmT (GmB x z o)) ; Bz r (GmT (GmB v (gmPut r x z) o)) ; Bo r (GmT (GmB v z (gmPut r x o))) }) }) }
gmGetB b m = m |> { Gm0 MGNone ; GmT t (t |> { GmB v z o (b |> { Bn v ; Bz r (gmGetB r z) ; Bo r (gmGetB r o) }) }) }
gmSet n x m = gmPut (idBits n) (MG x) m
gmGet n m = gmGetB (idBits n) m
-- each component's first equation in declaration order compiles it; a
-- component of one is a recursion if the equation depends on itself
selfDep n m = tjGet n m |> { MTjNone No ; MTj e (e |> { TjE d vis i l o (memN n d) }) }
inDecl es c = es |> { ExNil ExNil ; ExCons q r (q |> { EqX n bs b d (memN n c |> { Yes (ExCons q (inDecl r c)) ; No (inDecl r c) }) }) }
skipAll g m = g |> { ExNil m ; ExCons q r (q |> { EqX n bs b d (skipAll r (gmSet n GSkip m)) }) }
firstOf g m = g |> { ExNil m ; ExCons q r (q |> { EqX n bs b d (skipAll r (gmSet n (GMulti g) m)) }) }
groupsOf es tj cs g = cs |> { ScNil g ; ScCons c r (groupsOf es tj r (c |> { NmNil g ; NmCons n rest (rest |> { NmNil (gmSet n (GSingle (selfDep n tj)) g) ; NmCons x y (firstOf (inDecl es c) g) }) })) }
namesX g = g |> { ExNil NmNil ; ExCons q r (q |> { EqX n bs b d (NmCons n (namesX r)) }) }
lenX g = g |> { ExNil Zero ; ExCons q r (Suc (lenX r)) }
eqRules env gs es rs = es |> { ExNil rs ; ExCons q r (eqRules env gs r (q |> { EqX n bs b d (gmGet n gs |> { MGNone rs ; MG i (i |> { GSingle self (single env self q rs) ; GMulti g (multi env g rs) ; GSkip rs }) }) })) }
single env self q rs = q |> { EqX n bs b d (self |> { No (rAdd n (Rule bs (gen env bs SubNil b)) rs) ; Yes (rAdd n (Rule NmNil (rapp yComb (RRule (Rule (NmCons idAt bs) (gen env (NmCons idAt bs) (SubCons n (RVar idAt) idAt SubNil) b))))) rs) }) }
tupleR nn = Rule (dum (Suc nn)) (argsFrom (RIx nn) Zero nn)
pickR nn j = Rule (dum nn) (RIx j)
selR nn j = Rule (dum one) (rapp (RIx Zero) (RRule (pickR nn j)))
subsOf nn j g = g |> { ExNil SubNil ; ExCons m r (m |> { EqX n bs b d (SubCons n (rapp (RRule (selR nn j)) (RVar idAt)) idAt (subsOf nn (Suc j) r)) }) }
codeR env ss m = m |> { EqX n bs b d (Rule (NmCons idAt bs) (gen env (NmCons idAt bs) ss b)) }
codes env ss g t = g |> { ExNil t ; ExCons m r (codes env ss r (rapp t (rapp (RRule (codeR env ss m)) (RIx Zero)))) }
genR env nn ss g = Rule (dum one) (codes env ss g (RRule (tupleR nn)))
multi env g rs = g |> { ExNil rs ; ExCons m r (m |> { EqX n bs b d (multi2 env g (lenX g) (keyOf n) rs) }) }
multi2 env g nn key rs = members g nn Zero key (rAdd key (Rule NmNil (rapp yComb (RRule (genR env nn (subsOf nn Zero g) g)))) rs)
members g nn j key rs = g |> { ExNil rs ; ExCons m r (m |> { EqX n bs b d (members r nn (Suc j) key (rAdd n (Rule NmNil (rapp (RRule (selR nn j)) (RRef key))) rs)) }) }
defRules env ct ys ds rs = ds |> { DNil rs ; DCons d r (d |> { DDef n x (defRules env ct ys r (isQuoteE x |> { Yes rs ; No (rAdd n (Rule NmNil (gen env NmNil SubNil (dsg ct ys x))) rs) })) ; DEq n bs x (defRules env ct ys r rs) ; DType n cs fs (defRules env ct ys r rs) ; DMacro n ps c x (defRules env ct ys r rs) ; DCore n ps es (defRules env ct ys r rs) ; DCEq c n rn bs x (defRules env ct ys r rs) }) }
badT t = t |> { RVar n No ; RIx k No ; RRef n No ; RS No ; RK No ; RI No ; RAp p (p |> { RA f a (orB (badT f) (badT a)) }) ; RRule r (r |> { Rule fs b (badT b) }) ; RQuote x q (badT x) ; RBad Yes }
badRs m = m |> { Rm0 No ; RmT t (t |> { RmB v z o (orB (v |> { MRuNone No ; MRu x (x |> { Rule fs b (badT b) }) }) (orB (badRs z) (badRs o))) }) }
-- expansion: every reference inlined, every rule's formals abstracted
app e f = TA (Ap e f)
free x t = t |> { TS No ; TK No ; TI No ; TV n (eqN x n) ; TA p (p |> { Ap e f (orB (free x e) (free x f)) }) }
isV x t = t |> { TS No ; TK No ; TI No ; TV n (eqN x n) ; TA p No }
abs x t = t |> { TS (app TK TS) ; TK (app TK TK) ; TI (app TK TI) ; TV n (eqN x n |> { Yes TI ; No (app TK (TV n)) }) ; TA p (p |> { Ap e f (free x t |> { No (app TK t) ; Yes (andB (isV x f) (notB (free x e)) |> { Yes e ; No (app (app TS (abs x e)) (abs x f)) }) }) }) }
absAll i fs t = fs |> { NmNil t ; NmCons f r (abs i (absAll (Suc i) r t)) }
lastFrom n fs i best = fs |> { NmNil best ; NmCons f r (lastFrom n r (Suc i) (eqId n f |> { Yes i ; No best })) }
mePut b x m = m |> { Me0 (mePut b x (MeT (MeB MTmNone Me0 Me0))) ; MeT t (t |> { MeB v z o (b |> { Bn (MeT (MeB x z o)) ; Bz r (MeT (MeB v (mePut r x z) o)) ; Bo r (MeT (MeB v z (mePut r x o))) }) }) }
meGet b m = m |> { Me0 MTmNone ; MeT t (t |> { MeB v z o (b |> { Bn v ; Bz r (meGet r z) ; Bo r (meGet r o) }) }) }
meAdd n x m = mePut (idBits n) (MTm x) m
findMe n m = meGet (idBits n) m
rmPut b x m = m |> { Rm0 (rmPut b x (RmT (RmB MRuNone Rm0 Rm0))) ; RmT t (t |> { RmB v z o (b |> { Bn (RmT (RmB x z o)) ; Bz r (RmT (RmB v (rmPut r x z) o)) ; Bo r (RmT (RmB v z (rmPut r x o))) }) }) }
rmGet b m = m |> { Rm0 MRuNone ; RmT t (t |> { RmB v z o (b |> { Bn v ; Bz r (rmGet r z) ; Bo r (rmGet r o) }) }) }
rAdd n x m = rmPut (idBits n) (MRu x) m
findR n m = rmGet (idBits n) m
-- a name met again while its own term is being made is a cycle: the
-- memo records it under the name `@`, and the result is an error
tof rs n me path = findMe n me |> { MTm t (TM t me) ; MTmNone (memN n path |> { Yes (TM TI (meAdd idAt TI me)) ; No (findR n rs |> { MRuNone (TM TI me) ; MRu r (tofAdd n (ruleTm rs r me (NmCons n path))) }) }) }
tofAdd n q = q |> { TM t me (TM t (meAdd n t me)) }
-- A rule's body is abstracted with each reference a leaf, a variable
-- numbered past the formals, and each leaf is then replaced by its term:
-- the terms are closed, so this is the abstraction of the inlined body.
ruleTm rs r me path = r |> { Rule fs b (fill fs (lenN fs) (inl rs fs (lenN fs) b Zero TmNil me path)) }
fill fs nf q = q |> { IB t j ls me (TM (subst nf ls (absAll Zero fs t)) me) }
inl rs fs nf b j ls me path = b |> { RVar n (IB (TV (lastFrom n fs Zero Zero)) j ls me) ; RIx k (IB (TV k) j ls me) ; RRef n (leaf nf j ls (tof rs n me path)) ; RS (IB TS j ls me) ; RK (IB TK j ls me) ; RI (IB TI j ls me) ; RAp p (p |> { RA f a (inl2 rs fs nf a (inl rs fs nf f j ls me path) path) }) ; RRule r (leaf nf j ls (ruleTm rs r me path)) ; RQuote x q (leaf nf j ls (quoteTm rs x q me path)) ; RBad (IB TI j ls me) }
inl2 rs fs nf a q path = q |> { IB tf j ls me (inl3 tf (inl rs fs nf a j ls me path)) }
inl3 tf q = q |> { IB ta j ls me (IB (app tf ta) j ls me) }
leaf nf j ls q = q |> { TM t me (IB (TV (add nf j)) (Suc j) (snoc ls t) me) }
snoc ls t = ls |> { TmNil (TmCons t TmNil) ; TmCons u r (TmCons u (snoc r t)) }
minus n m = m |> { Zero n ; Suc k (minus (predN n) k) }
nthT ls i = ls |> { TmNil TI ; TmCons t r (i |> { Zero t ; Suc k (nthT r k) }) }
subst nf ls t = t |> { TS TS ; TK TK ; TI TI ; TV n (nthT ls (minus n nf)) ; TA p (p |> { Ap e f (app (subst nf ls e) (subst nf ls f)) }) }
-- each pair: the name to print, and the name whose term it is; once an
-- error is marked, the result is RErr and no more terms are made
outAll rv rs ps me = ps |> { PrNil (OA ONil me) ; PrCons n x r (findMe idAt me |> { MTm t (OA ONil me) ; MTmNone (outAll2 (nameFor rv n) (tof rs x me NmNil) (outAll rv rs r)) }) }
outAll2 n q k = q |> { TM t me (k me |> { OA os me2 (OA (OCons n t os) me2) }) }
-- cores: each equation named `core.eq`, interned past lexing
catN a b = a |> { NNil b ; NCons c r (NCons c (catN r b)) }
cidLook n e st = st |> { Ist tab rv nx (look (catN (nameFor rv n) (NCons codeDot (nameFor rv e))) st) }
cidsFor n es acc st = es |> { DNil (RQ acc st) ; DCons d r (d |> { DEq e bs x (cidLook n e st |> { IA b st2 (cidsFor n r (RnCons e (Id b) acc) st2) }) ; DDef e x (cidsFor n r acc st) ; DType e cs fs (cidsFor n r acc st) ; DMacro e ps c x (cidsFor n r acc st) ; DCore e ps fs (cidsFor n r acc st) ; DCEq c e rn bs x (cidsFor n r acc st) }) }
rnFind n rn = rn |> { RnNil MNone ; RnCons k c r (eqId n k |> { Yes (MName c) ; No (rnFind n r) }) }
ceqs rn es = es |> { DNil DNil ; DCons d r (d |> { DEq e bs x (DCons (DCEq (rnFind e rn |> { MName c c ; MNone e }) e rn bs x) (ceqs rn r)) ; DDef e x (ceqs rn r) ; DType e cs fs (ceqs rn r) ; DMacro e ps c x (ceqs rn r) ; DCore e ps fs (ceqs rn r) ; DCEq c e rn2 bs x (ceqs rn r) }) }
coreIds st ds = ds |> { DNil (CQ DNil st) ; DCons d r (d |> { DCore n ps es (cidsFor n es RnNil st |> { RQ rn st2 (cqCons (DCore n ps (ceqs rn es)) (coreIds st2 r)) }) ; DEq n bs x (cqCons d (coreIds st r)) ; DDef n x (cqCons d (coreIds st r)) ; DType n cs fs (cqCons d (coreIds st r)) ; DMacro n ps c x (cqCons d (coreIds st r)) ; DCEq c n rn bs x (cqCons d (coreIds st r)) }) }
cqCons d q = q |> { CQ ds st (CQ (DCons d ds) st) }
coreNames ds = ds |> { DNil NmNil ; DCons d r (d |> { DCore n ps es (NmCons n (coreNames r)) ; DEq n bs x (coreNames r) ; DDef n x (coreNames r) ; DType n cs fs (coreNames r) ; DMacro n ps c x (coreNames r) ; DCEq c n rn bs x (coreNames r) }) }
dupEqs ds = ds |> { DNil No ; DCons d r (orB (d |> { DCore n ps es (dupS (orderOf es) Ns0) ; DEq n bs x No ; DDef n x No ; DType n cs fs No ; DMacro n ps c x No ; DCEq c n rn bs x No }) (dupEqs r)) }
cidsOf ds = ds |> { DNil NmNil ; DCons d r (d |> { DCore n ps es (appN (cidsOf es) (cidsOf r)) ; DCEq c n rn bs x (NmCons c (cidsOf r)) ; DEq n bs x (cidsOf r) ; DDef n x (cidsOf r) ; DType n cs fs (cidsOf r) ; DMacro n ps c x (cidsOf r) }) }
-- a core with an equation `loop`: its name denotes the loop, where no
-- program-level name takes it, and is always printed with the loop's term
loopOf es = es |> { DNil MNone ; DCons d r (d |> { DCEq c e rn bs x (eqId e idLoop |> { Yes (MName c) ; No (loopOf r) }) ; DEq n bs x (loopOf r) ; DDef n x (loopOf r) ; DType n cs fs (loopOf r) ; DMacro n ps c x (loopOf r) ; DCore n ps fs (loopOf r) }) }
loops ds = ds |> { DNil RnNil ; DCons d r (d |> { DCore n ps es (loopOf es |> { MName c (RnCons n c (loops r)) ; MNone (loops r) }) ; DEq n bs x (loops r) ; DDef n x (loops r) ; DType n cs fs (loops r) ; DMacro n ps c x (loops r) ; DCEq c n rn bs x (loops r) }) }
loopAlias bk ls = ls |> { RnNil RnNil ; RnCons n c r (sHas n bk |> { Yes (loopAlias bk r) ; No (RnCons n c (loopAlias bk r)) }) }
loopRules ls rs = ls |> { RnNil rs ; RnCons n c r (loopRules r (rAdd n (Rule NmNil (RRef c)) rs)) }
rnKeys ls = ls |> { RnNil NmNil ; RnCons n c r (NmCons n (rnKeys r)) }
-- the names printed: the program's and the prelude's, then each core
-- equation as `core.eq` and, when no other core has one of its name, bare
selfP ns = ns |> { NmNil PrNil ; NmCons n r (PrCons n n (selfP r)) }
appP a b = a |> { PrNil b ; PrCons n x r (PrCons n x (appP r b)) }
countN n ns = ns |> { NmNil Zero ; NmCons m r (eqId n m |> { Yes (Suc (countN n r)) ; No (countN n r) }) }
bareAll ds = ds |> { DNil NmNil ; DCons d r (d |> { DCore n ps es (appN (bareAll es) (bareAll r)) ; DCEq c n rn bs x (NmCons n (bareAll r)) ; DEq n bs x (bareAll r) ; DDef n x (bareAll r) ; DType n cs fs (bareAll r) ; DMacro n ps c x (bareAll r) }) }
coreP bn qn ds = ds |> { DNil PrNil ; DCons d r (d |> { DCore n ps es (appP (coreP bn qn es) (coreP bn qn r)) ; DCEq c n rn bs x (PrCons c c (andB (eqN (countN n bn) one) (notB (memN n qn)) |> { Yes (PrCons n c (coreP bn qn r)) ; No (coreP bn qn r) })) ; DEq n bs x (coreP bn qn r) ; DDef n x (coreP bn qn r) ; DType n cs fs (coreP bn qn r) ; DMacro n ps c x (coreP bn qn r) }) }
loopP ls = ls |> { RnNil PrNil ; RnCons n c r (PrCons n c (loopP r)) }
-- the prelude's successor as a term: the numeral operations and fuel
-- use it, not the name `suc`, which a program may define for itself
sucR := rapp (rapp RS (rapp RK RK)) (rapp (rapp RS (rapp RK (rapp RS RI))) RK)
-- the numeral operations a program names and does not define, each `Y`
-- of a generator taking itself first; expand.py's helper rules are
-- inline here, and natMul's natAdd is always the prelude's
natNames := NmCons idNatAdd (NmCons idNatSub (NmCons idNatMul (NmCons idNatIfEq (NmCons idNatIfLe NmNil))))
natOps ds = natOps2 ds natNames
natOps2 ds ns = ns |> { NmNil NmNil ; NmCons n r (andB (menD n ds) (notB (defD n ds)) |> { Yes (NmCons n (natOps2 ds r)) ; No (natOps2 ds r) }) }
menD n ds = ds |> { DNil No ; DCons d r (orB (d |> { DEq m bs x (hasE n x) ; DDef m x (hasE n x) ; DType m cs fs No ; DMacro m ps c x (hasE n x) ; DCore m ps es (menD n es) ; DCEq c m rn bs x (hasE n x) }) (menD n r)) }
defD n ds = ds |> { DNil No ; DCons d r (orB (d |> { DEq m bs x (eqId n m) ; DDef m x (eqId n m) ; DType m cs fs No ; DMacro m ps c x (eqId n m) ; DCore m ps es (eqId n m) ; DCEq c m rn bs x No }) (defD n r)) }
hasE n e = e |> { EVar m (eqId n m) ; EApp p (p |> { EAp f a (orB (hasE n f) (hasE n a)) }) ; ECell xs (hasX n xs) ; EPick k x (hasE n x) ; ECase x bs (orB (hasE n x) (hasBs n bs)) ; ELam x b (hasE n b) ; EQuote b fu i (orB (hasE n b) (i |> { INone No ; ISome x (hasE n x) })) ; EScry p (hasP n p) ; ENs fs (hasFt n fs) ; ENum k No }
hasP n p = p |> { PNil No ; PSeg g pay r (orB (pay |> { INone No ; ISome x (hasE n x) }) (hasP n r)) }
hasFt n fs = fs |> { FtNil No ; FtCons p x r (orB (hasP n p) (orB (hasE n x) (hasFt n r))) }
hasX n xs = xs |> { XNil No ; XCons x r (orB (hasE n x) (hasX n r)) }
hasBs n bs = bs |> { BNil No ; BCons b r (b |> { Br c ns x (orB (hasE n x) (hasBs n r)) }) }
five := Suc four
rap4 f a b c d = rapp (rapp (rapp (rapp f a) b) c) d
natAddR := rapp yComb (RRule (Rule (dum three) (rapp (rapp (RIx two) (RIx one)) (rapp (rapp (RRule (Rule (dum three) (rapp sucR (rapp (rapp (RIx Zero) (RIx one)) (RIx two))))) (RIx Zero)) (RIx one)))))
natSubR := rapp yComb (RRule (Rule (dum three) (rapp (rapp (RIx two) (RIx one)) (rapp (rapp (RRule (Rule (dum three) (rapp (rapp (RIx Zero) (rapp (rapp (RIx one) RK) RI)) (RIx two)))) (RIx Zero)) (RIx one)))))
natMulR := rapp yComb (RRule (Rule (dum three) (rapp (rapp (RIx two) RK) (rapp (rapp (RRule (Rule (dum three) (rapp (rapp natAddR (RIx one)) (rapp (rapp (RIx Zero) (RIx one)) (RIx two))))) (RIx Zero)) (RIx one)))))
natIfT := RRule (Rule (dum five) (rapp (rapp (rapp (rapp (RIx Zero) (RIx three)) (RIx four)) (RIx one)) (RIx two)))
natIfS := RRule (Rule (dum five) (rapp (rapp (RIx one) (RIx three)) (rap4 natIfT (RIx Zero) (RIx two) (RIx three) (RIx four))))
natIfEqR := rapp yComb (RRule (Rule (dum five) (rapp (rapp (RIx one) (rapp (rapp (RIx two) (RIx three)) (rapp RK (RIx four)))) (rap4 natIfS (RIx Zero) (RIx two) (RIx three) (RIx four)))))
natIfLeR := rapp yComb (RRule (Rule (dum five) (rapp (rapp (RIx one) (RIx three)) (rap4 natIfS (RIx Zero) (RIx two) (RIx three) (RIx four)))))
natR n = eqId n idNatAdd |> { Yes natAddR ; No (eqId n idNatSub |> { Yes natSubR ; No (eqId n idNatMul |> { Yes natMulR ; No (eqId n idNatIfEq |> { Yes natIfEqR ; No natIfLeR }) }) }) }
natRules ns rs = ns |> { NmNil rs ; NmCons n r (natRules r (rAdd n (Rule NmNil (natR n)) rs)) }
-- quotation (expand.py, pass 6): a definition that is a quotation is a
-- datum, or with fuel or an interpreter a level-1 run.  Its body, nested
-- quotations stripped to placeholders, is expanded, desugared, and
-- generated with the object type's leaves for leaf names; its term is
-- encoded by the object type's constructors.  Inside it, a datum
-- declared later, itself, or a level-1 run is refused, as Python's
-- environment does not hold them yet
isQuoteE e = e |> { EVar n No ; EApp p No ; ECell xs No ; EPick k x No ; ECase x bs No ; ELam x b No ; EQuote b fu i Yes ; EScry p No ; ENs fs Yes ; ENum k No }
isDatum fu i = fu |> { FNone (i |> { INone Yes ; ISome x No }) ; FNum k No ; FPol No }
-- private names: a leaf with three zeros above its top bit, a placeholder
-- with four
leafBits b = b |> { Bn (Bz (Bz (Bz Bn))) ; Bz r (Bz (leafBits r)) ; Bo r (Bo (leafBits r)) }
pidBits b = b |> { Bn (Bz (Bz (Bz (Bz Bn)))) ; Bz r (Bz (pidBits r)) ; Bo r (Bo (pidBits r)) }
leafId n = Id (leafBits (idBits n))
strip sx sl e qs qc = e |> { EVar n (SQ e qs qc) ; EApp p (p |> { EAp f a (strip sx sl f qs qc |> { SQFail SQFail ; SQ f2 qs2 qc2 (strip sx sl a qs2 qc2 |> { SQFail SQFail ; SQ a2 qs3 qc3 (SQ (EApp (EAp f2 a2)) qs3 qc3) }) }) }) ; ECell xs (stripL sx sl xs qs qc |> { SQsFail SQFail ; SQs ys qs2 qc2 (SQ (ECell ys) qs2 qc2) }) ; EPick k x (strip sx sl x qs qc |> { SQFail SQFail ; SQ y qs2 qc2 (SQ (EPick k y) qs2 qc2) }) ; ECase x bs (strip sx sl x qs qc |> { SQFail SQFail ; SQ y qs2 qc2 (stripB sx sl bs qs2 qc2 |> { SQbFail SQFail ; SQb bs2 qs3 qc3 (SQ (ECase y bs2) qs3 qc3) }) }) ; ELam x b (strip sx sl b qs qc |> { SQFail SQFail ; SQ b2 qs2 qc2 (SQ (ELam x b2) qs2 qc2) }) ; EQuote b fu i (isDatum fu i |> { No SQFail ; Yes (strip sx sl b qs (inc qc) |> { SQFail SQFail ; SQ b2 qs2 qc2 (SQ (EVar (Id (pidBits qc))) (QsCons (Id (pidBits qc)) b2 qs2) qc2) }) }) ; EScry p (sl |> { No SQFail ; Yes (pathE sx p |> { PExFail SQFail ; PEx pe (SQ (EApp (EAp (EVar idScry) pe)) qs qc) }) }) ; ENs fs SQFail ; ENum k (SQ e qs qc) }
stripL sx sl xs qs qc = xs |> { XNil (SQs XNil qs qc) ; XCons x r (strip sx sl x qs qc |> { SQFail SQsFail ; SQ y qs2 qc2 (stripL sx sl r qs2 qc2 |> { SQsFail SQsFail ; SQs ys qs3 qc3 (SQs (XCons y ys) qs3 qc3) }) }) }
stripB sx sl bs qs qc = bs |> { BNil (SQb BNil qs qc) ; BCons b r (b |> { Br c ns x (strip sx sl x qs qc |> { SQFail SQbFail ; SQ y qs2 qc2 (stripB sx sl r qs2 qc2 |> { SQbFail SQbFail ; SQb bs2 qs3 qc3 (SQb (BCons (Br c ns y) bs2) qs3 qc3) }) }) }) }
qstrip sx sl ds qc = ds |> { DNil (QSt QdNil qc) ; DCons d r (d |> { DDef n x (x |> { EQuote b fu i (strip sx sl b QsNil qc |> { SQFail QStFail ; SQ b2 ns qc2 (qstrip sx sl r qc2 |> { QStFail QStFail ; QSt qd qc3 (QSt (QdCons (QD n b2 fu i ns) qd) qc3) }) }) ; ENs fs (qfacts sx sl fs qc |> { QFFail QStFail ; QF nfs qc2 (qstrip sx sl r qc2 |> { QStFail QStFail ; QSt qd qc3 (QSt (QdCons (QN n nfs) qd) qc3) }) }) ; EScry p (qstrip sx sl r qc) ; EVar m (qstrip sx sl r qc) ; EApp a (qstrip sx sl r qc) ; ECell xs (qstrip sx sl r qc) ; EPick k y (qstrip sx sl r qc) ; ECase y bs (qstrip sx sl r qc) ; ELam y b (qstrip sx sl r qc) ; ENum k (qstrip sx sl r qc) }) ; DEq n bs x (qstrip sx sl r qc) ; DType n cs fs (qstrip sx sl r qc) ; DMacro n ps c x (qstrip sx sl r qc) ; DCore n ps es (qstrip sx sl r qc) ; DCEq c n rn bs x (qstrip sx sl r qc) }) }
-- a namespace literal's facts: each key the path's term, each value a
-- quotation without fuel or an interpreter, stripped
qfacts sx sl fs qc = fs |> { FtNil (QF NfNil qc) ; FtCons p v r (pathE sx p |> { PExFail QFFail ; PEx ke (v |> { EQuote b fu i (isDatum fu i |> { No QFFail ; Yes (strip sx sl b QsNil qc |> { SQFail QFFail ; SQ vb ns qc2 (qfacts sx sl r qc2 |> { QFFail QFFail ; QF nfs qc3 (QF (NfCons (NF ke vb ns) nfs) qc3) }) }) }) ; EVar m QFFail ; EApp a QFFail ; ECell xs QFFail ; EPick k x QFFail ; ECase x bs QFFail ; ELam x b QFFail ; EScry q QFFail ; ENs gs QFFail ; ENum k QFFail }) }) }
-- a path's term: `Cons Tag (... Nil)`, each tag's constructor its name
-- with the first letter capital, a constructor of the segment type
pathE sx p = sx |> { SXNone PExFail ; SX nl cn sg ct st (p |> { PNil (PEx (EVar nl)) ; PSeg g pay r (pay |> { ISome x PExFail ; INone (segCtor sg ct st g |> { MNone PExFail ; MName c (pathE sx r |> { PExFail PExFail ; PEx e (PEx (EApp (EAp (EApp (EAp (EVar cn) (EVar c))) e))) }) }) }) }) }
segCtor sg ct st g = st |> { Ist tab rv nx (itGet (capFirst (nameFor rv g)) tab |> { MIdNone MNone ; MId b (findCI (Id b) ct |> { MCNone MNone ; MC x (x |> { CInfo c tn i k (eqId tn sg |> { Yes (MName c) ; No MNone }) }) }) }) }
capFirst nm = nm |> { NNil NNil ; NCons c r (NCons (upperC c) r) }
upperC c = c |> { Code b6 b5 b4 b3 b2 b1 b0 (andB (andB (eqBit b6 Hi) (eqBit b5 Hi)) (andB (orB (eqBit b4 Hi) (orB (eqBit b3 Hi) (orB (eqBit b2 Hi) (orB (eqBit b1 Hi) (eqBit b0 Hi))))) (notB (andB (eqBit b4 Hi) (andB (eqBit b3 Hi) (orB (eqBit b2 Hi) (andB (eqBit b1 Hi) (eqBit b0 Hi))))))) |> { Yes (Code b6 Lo b4 b3 b2 b1 b0) ; No c }) }
-- the path type, `path === Nil | Cons seg path`, read
pathSx ct st ds = ds |> { DNil SXNone ; DCons d r (d |> { DType n cs fs (eqId n idPath |> { Yes (pathSx2 ct st cs fs) ; No (pathSx ct st r) }) ; DEq n bs x (pathSx ct st r) ; DDef n x (pathSx ct st r) ; DMacro n ps c x (pathSx ct st r) ; DCore n ps es (pathSx ct st r) ; DCEq c n rn bs x (pathSx ct st r) }) }
pathSx2 ct st cs fs = nullsOf cs fs |> { NmNil SXNone ; NmCons nl y (consOf cs fs |> { MNone SXNone ; MName cn (SX nl cn (nthN (nthF fs (posN cn cs Zero)) Zero) ct st) }) }
consOf cs fs = cs |> { NmNil MNone ; NmCons c r (fs |> { FsNil MNone ; FsCons f fr (f |> { NmNil (consOf r fr) ; NmCons a r2 (r2 |> { NmNil (consOf r fr) ; NmCons b r3 (r3 |> { NmNil (eqId b idPath |> { Yes (MName c) ; No (consOf r fr) }) ; NmCons e r4 (consOf r fr) }) }) }) }) }
posN n ns i = ns |> { NmNil i ; NmCons m r (eqId n m |> { Yes i ; No (posN n r (Suc i)) }) }
hasLeaf n lv = memN n lv
qNames qd = qd |> { QdNil NmNil ; QdCons q r (q |> { QD n b fu i ns (NmCons n (qNames r)) ; QN n nfs (NmCons n (qNames r)) }) }
l1Names qd = qd |> { QdNil NmNil ; QdCons q r (q |> { QD n b fu i ns (isDatum fu i |> { Yes (l1Names r) ; No (NmCons n (l1Names r)) }) ; QN n nfs (l1Names r) }) }
pidsOf qd = qd |> { QdNil NmNil ; QdCons q r (q |> { QD n b fu i ns (appN (qsNames ns) (pidsOf r)) ; QN n nfs (appN (nfPids nfs) (pidsOf r)) }) }
nfPids nfs = nfs |> { NfNil NmNil ; NfCons f r (f |> { NF k v ns (appN (qsNames ns) (nfPids r)) }) }
qsNames qs = qs |> { QsNil NmNil ; QsCons n x r (NmCons n (qsNames r)) }
notIn ns xs = xs |> { NmNil NmNil ; NmCons x r (memN x ns |> { Yes (notIn ns r) ; No (NmCons x (notIn ns r)) }) }
-- a leaf name, unbound, is the leaf
rnQ rn bd d = d |> { DName m (memN m bd |> { Yes d ; No (rnFind m rn |> { MName c (DName c) ; MNone d }) }) ; DApp p (p |> { DAp f a (dapp (rnQ rn bd f) (rnQ rn bd a)) }) ; DLam x b (DLam x (rnQ rn (NmCons x bd) b)) ; DBad DBad }
leafRen lv = lv |> { NmNil RnNil ; NmCons n r (RnCons n (leafId n) (leafRen r)) }
leafIds lv = lv |> { NmNil NmNil ; NmCons n r (NmCons (leafId n) (leafIds r)) }
seedMe lv i me = lv |> { NmNil me ; NmCons n r (seedMe r (Suc i) (meAdd (leafId n) (TV i) me)) }
qbody x b = x |> { QX ms ct ys es0 eq rn qe dsc an ls bo l0 (mxTop ms b |> { MXFail MRNone ; MX e w f (MR (gen eq NmNil SubNil (rnQ rn NmNil (dsg ct ys e)))) }) }
qparam x a = x |> { QX ms ct ys es0 eq rn qe dsc an ls bo l0 (mxTop ms a |> { MXFail MRNone ; MX e w f (MR (gen es0 NmNil SubNil (dsg ct ys e))) }) }
qparams x xs = xs |> { XNil (MRts RtNil) ; XCons a r (qparam x a |> { MRNone MRtsNone ; MR t (qparams x r |> { MRtsNone MRtsNone ; MRts ts (MRts (RtCons t ts)) }) }) }
-- a quotation's nested quotations, each its placeholder's rule
qnest qb qe ns = ns |> { QsNil (MNr NrNil) ; QsCons n b r (qb b |> { MRNone MNrFail ; MR t (qnest qb qe r |> { MNrFail MNrFail ; MNr nr (MNr (NrCons n (Rule NmNil (RQuote t qe)) nr)) }) }) }
-- the interpreter: a core applied to all its parameters; by default
-- whnfF, applied to none whatever it takes
coreInfo ds n = ds |> { DNil CINone ; DCons d r (d |> { DCore m ps es (eqId n m |> { Yes (CI2 (lenN ps) (loopOf es)) ; No (coreInfo r n) }) ; DEq m bs x (coreInfo r n) ; DDef m x (coreInfo r n) ; DType m cs fs (coreInfo r n) ; DMacro m ps c x (coreInfo r n) ; DCEq c m rn bs x (coreInfo r n) }) }
headVar e = e |> { EVar n (MName n) ; EApp p (p |> { EAp f a (headVar f) }) ; ECell xs MNone ; EPick k x MNone ; ECase x bs MNone ; ELam x b MNone ; EQuote b fu i MNone ; EScry p MNone ; ENs fs MNone ; ENum k MNone }
numR k = k |> { Zero RK ; Suc j (rapp sucR (numR j)) }
rappT t ts = ts |> { RtNil t ; RtCons a r (rappT (rapp t a) r) }
qinterp x i = qinterp2 x (i |> { INone (QI idWhnfF Yes XNil) ; ISome e (headVar e |> { MNone QINone ; MName n (QI n No (spArgs e XNil)) }) })
qinterp2 x q = q |> { QINone MRNone ; QI n dflt args (x |> { QX ms ct ys es0 eq rn qe dsc an ls bo l0 (qcore x dsc n dflt args) }) }
qcore x dsc n dflt args = coreInfo dsc n |> { CINone MRNone ; CI2 k ml (andB (orB dflt (eqN k (lenXs args))) (ml |> { MName c Yes ; MNone No }) |> { No MRNone ; Yes (ml |> { MNone MRNone ; MName c (qparams x args |> { MRtsNone MRNone ; MRts ts (MR (rappT (RRef c) ts)) }) }) }) }
-- each quotation definition in turn; av holds the datums before it
qcomp qb x qe qd av = qd |> { QdNil (QO NrNil NmNil NmNil NmNil QrNil) ; QdCons q r (q |> { QD n b fu i ns (qmerge (qone qb x qe n b fu i ns av) (qcomp qb x qe r (isDatum fu i |> { Yes (sAdd n av) ; No av }))) ; QN n nfs (qmerge (qoneN qb x qe n nfs av) (qcomp qb x qe r (sAdd n av))) }) }
qmerge a b = a |> { QOErr QOErr ; QO nr d l c t (b |> { QOErr QOErr ; QO nr2 d2 l2 c2 t2 (QO (appNr nr nr2) (appN d d2) (appN l l2) (appN c c2) (appQr t t2)) }) }
qone qb x qe n b fu i ns av = qnest qb qe ns |> { MNrFail QOErr ; MNr nr (qb b |> { MRNone QOErr ; MR t (qone2 x n (RQuote t qe) fu i av nr) }) }
qone2 x n q fu i av nr = isDatum fu i |> { Yes (QO (NrCons n (Rule NmNil q) nr) (nms1 n) NmNil NmNil (QrCons q av QrNil)) ; No (qinterp x i |> { MRNone QOErr ; MR h (qlv1 n fu (rapp (rapp h (fuelR fu)) q) (QrCons q av QrNil) nr) }) }
fuelR fu = fu |> { FNum k (numR k) ; FNone (numR Zero) ; FPol (numR Zero) }
qlv1 n fu body rt nr = fu |> { FNum k (QO (NrCons n (Rule NmNil body) nr) NmNil (nms1 n) NmNil rt) ; FNone (QO (NrCons n (Rule NmNil body) nr) NmNil NmNil (nms1 n) rt) ; FPol (QO (NrCons n (Rule NmNil body) nr) NmNil NmNil (nms1 n) rt) }
-- a namespace literal (_compile_nslit): `\p. EQ5 p key (hit value) ...
-- notYet`, EQ5, hit and not-yet each the term printed under that name when
-- the literal is compiled; one not a datum before it holds no quotation
qoneN qb x qe n nfs av = qansOf x |> { AnsNone QOErr ; Ans hit ny (qoneN2 qe n (outRef x av idEQ5) (outRef x av hit) (outRef x av ny) (qfactsC qb qe nfs av)) }
qansOf x = x |> { QX ms ct ys es0 eq rn qe dsc an ls bo l0 an }
qoneN2 qe n eo ho yo fc = eo |> { ORNone QOErr ; OR er eb (qoneN3 qe n er eb ho yo fc) }
qoneN3 qe n er eb ho yo fc = ho |> { ORNone QOErr ; OR hr hb (qoneN4 qe n er eb hr hb yo fc) }
qoneN4 qe n er eb hr hb yo fc = yo |> { ORNone QOErr ; OR yr yb (fc |> { QFCFail QOErr ; QFC kv nrs rts (QO (NrCons n (Rule (nms1 resBinder) (resBody er hr yr qe kv)) nrs) (nms1 n) NmNil NmNil (appQr rts (rootIf eb er (rootIf hb hr (rootIf yb yr QrNil))))) }) }
resBinder := Id (freshBits Bn)
resBody er hr yr qe kv = kv |> { KvNil yr ; KvCons k v r (rapp (rapp (rapp (rapp er (RVar resBinder)) (RQuote k qe)) (rapp hr (RQuote v qe))) (resBody er hr yr qe r)) }
qfactsC qb qe nfs av = nfs |> { NfNil (QFC KvNil NrNil QrNil) ; NfCons f r (f |> { NF ke vb ns (qfact qe av (qb ke) (qb vb) (qnest qb qe ns) (qfactsC qb qe r av)) }) }
qfact qe av km vm mn rest = mn |> { MNrFail QFCFail ; MNr nrs (km |> { MRNone QFCFail ; MR kt (vm |> { MRNone QFCFail ; MR vt (rest |> { QFCFail QFCFail ; QFC kv nrs2 rts (QFC (KvCons kt vt kv) (appNr nrs nrs2) (QrCons (RQuote kt qe) av (QrCons (RQuote vt qe) av rts))) }) }) }) }
appNr a b = a |> { NrNil b ; NrCons n u r (NrCons n u (appNr r b)) }
appQr a b = a |> { QrNil b ; QrCons t v r (QrCons t v (appQr r b)) }
rootIf b t rt = b |> { No rt ; Yes (QrCons t Ns0 rt) }
-- the term printed under a name when quotation begins: a datum before,
-- a core's loop, a bare core equation, a level-0 name, in that order
outRef x av n = x |> { QX ms ct ys es0 eq rn qe dsc an ls bo l0 (sHas n av |> { Yes (OR (RRef n) No) ; No (rnFind n ls |> { MName c (OR (RRef c) Yes) ; MNone (rnFind n bo |> { MName c (OR (RRef c) Yes) ; MNone (sHas n l0 |> { Yes (OR (RRef n) Yes) ; No ORNone }) }) }) }) }
-- the answer type's hit, its carrier, and its not-yet, its last leaf
ansOf on o2 r2 ds = ds |> { DNil AnsNone ; DCons d r (d |> { DType n cs fs (andB (notB (orB (eqId n on) (orB (eqId n o2) (eqId n r2)))) (geN (lenN cs) two) |> { No (ansOf on o2 r2 r) ; Yes (carrierOf on cs fs |> { MNone (ansOf on o2 r2 r) ; MName c (Ans c (lastN (nullsOf cs fs) idNone)) }) }) ; DEq n bs x (ansOf on o2 r2 r) ; DDef n x (ansOf on o2 r2 r) ; DMacro n ps c x (ansOf on o2 r2 r) ; DCore n ps es (ansOf on o2 r2 r) ; DCEq c n rn bs x (ansOf on o2 r2 r) }) }
bareOut bn qn ds = ds |> { DNil RnNil ; DCons d r (d |> { DCore n ps es (appRn (bareOut bn qn es) (bareOut bn qn r)) ; DCEq c n rn bs x (andB (eqN (countN n bn) one) (notB (memN n qn)) |> { Yes (RnCons n c (bareOut bn qn r)) ; No (bareOut bn qn r) }) ; DEq n bs x (bareOut bn qn r) ; DDef n x (bareOut bn qn r) ; DType n cs fs (bareOut bn qn r) ; DMacro n ps c x (bareOut bn qn r) }) }
appRn a b = a |> { RnNil b ; RnCons n c r (RnCons n c (appRn r b)) }
nrAdd nr rs = nr |> { NrNil rs ; NrCons n u r (nrAdd r (rAdd n u rs)) }
-- the datum: the term encoded, a leaf by its constructor, an application
-- by the application constructor; S, K and I by the leaves of those names
quoteTm rs x q me path = ruleTm rs (Rule NmNil x) me path |> { TM t me2 (encT rs q t me2 path) }
encT rs q t me path = q |> { QE apc lv (t |> { TS (leafT rs lv idS me path) ; TK (leafT rs lv idK me path) ; TI (leafT rs lv idI me path) ; TV i (tof rs (nthN lv i) me path) ; TA p (p |> { Ap e f (tof rs apc me path |> { TM ta me2 (encT rs q e me2 path |> { TM te me3 (encT rs q f me3 path |> { TM tf me4 (TM (app (app ta te) tf) me4) }) }) }) }) }) }
leafT rs lv n me path = memN n lv |> { Yes (tof rs n me path) ; No (TM TI (meAdd idAt TI me)) }
-- what a quotation reaches through rules: a datum only if declared before
reachOK rs dts av vis todo = todo |> { RtNil Yes ; RtCons t r (t |> { RRef n (sHas n vis |> { Yes (reachOK rs dts av vis r) ; No (sHas n dts |> { Yes (sHas n av |> { Yes (reachOK rs dts av (sAdd n vis) r) ; No No }) ; No (findR n rs |> { MRuNone (reachOK rs dts av (sAdd n vis) r) ; MRu u (u |> { Rule fs b (reachOK rs dts av (sAdd n vis) (RtCons b r)) }) }) }) }) ; RAp p (p |> { RA f a (reachOK rs dts av vis (RtCons f (RtCons a r))) }) ; RRule u (u |> { Rule fs b (reachOK rs dts av vis (RtCons b r)) }) ; RQuote y q (reachOK rs dts av vis (RtCons y r)) ; RVar n (reachOK rs dts av vis r) ; RIx k (reachOK rs dts av vis r) ; RS (reachOK rs dts av vis r) ; RK (reachOK rs dts av vis r) ; RI (reachOK rs dts av vis r) ; RBad (reachOK rs dts av vis r) }) }
rootsOK rs dts rt = rt |> { QrNil Yes ; QrCons t av r (andB (reachOK rs dts av Ns0 (RtCons t RtNil)) (rootsOK rs dts r)) }
-- with a quotation, the answer type, if any, is one, with a leaf, and a
-- type named path is `Nil | Cons seg path` in shape
ansCands on o2 r2 ds = ds |> { DNil NmNil ; DCons d r (d |> { DType n cs fs (andB (notB (orB (eqId n on) (orB (eqId n o2) (eqId n r2)))) (geN (lenN cs) two) |> { No (ansCands on o2 r2 r) ; Yes (carrierOf on cs fs |> { MNone (ansCands on o2 r2 r) ; MName c (nullsOf cs fs |> { NmNil (NmCons idNone (ansCands on o2 r2 r)) ; NmCons y z (NmCons n (ansCands on o2 r2 r)) }) }) }) ; DEq n bs x (ansCands on o2 r2 r) ; DDef n x (ansCands on o2 r2 r) ; DMacro n ps c x (ansCands on o2 r2 r) ; DCore n ps es (ansCands on o2 r2 r) ; DCEq c n rn bs x (ansCands on o2 r2 r) }) }
ansOK on o2 r2 ds = ansCands on o2 r2 ds |> { NmNil Yes ; NmCons a r (r |> { NmNil (notB (eqId a idNone)) ; NmCons b r2 No }) }
consFs fs = fs |> { FsNil Zero ; FsCons f r (f |> { NmNil (consFs r) ; NmCons a r2 (r2 |> { NmNil (consFs r) ; NmCons b r3 (r3 |> { NmNil (eqId b idPath |> { Yes (Suc (consFs r)) ; No (consFs r) }) ; NmCons c r4 (consFs r) }) }) }) }
pathOK ds = ds |> { DNil Yes ; DCons d r (d |> { DType n cs fs (eqId n idPath |> { Yes (andB (eqN (lenN cs) two) (andB (eqN (lenN (nullsOf cs fs)) one) (eqN (consFs fs) one))) ; No (pathOK r) }) ; DEq n bs x (pathOK r) ; DDef n x (pathOK r) ; DMacro n ps c x (pathOK r) ; DCore n ps es (pathOK r) ; DCEq c n rn bs x (pathOK r) }) }
-- Stage A (check.py), over the parsed program before macros and
-- generation, as the expander checks before it expands: the first
-- problem's class, in check.py's order.  The collect phase comes first: a
-- name declared twice is a ScopeError, and so is an equation twice in a
-- core; then the object type's and the path type's shapes, each an
-- InterfaceError (find_object_type, find_path_type); then a binder named
-- S, K or I, a ScopeError; then each declaration in turn.  Checking only
-- refuses: nothing here changes a term
pScope := PAIs one
pArity := PAIs two
pCase  := PAIs (Suc two)
pData  := PAIs (Suc (Suc two))
pIface := PAIs (Suc (Suc (Suc two)))
pSym   := PAIs (Suc (Suc (Suc (Suc two))))
aor a b = a |> { PANo b ; PAIs c (PAIs c) }
stageA st ct ys ds = aor (aDup ds) (aor (aShape ds) (aor (aSKI ds |> { Yes pScope ; No PANo }) (aStart st ct ys ds)))
-- the collect phase: every type, constructor, macro, equation, core and
-- definition name shares one table (check.py declare)
aNames ds = ds |> { DNil NmNil ; DCons d r (d |> { DEq n bs x (NmCons n (aNames r)) ; DDef n x (NmCons n (aNames r)) ; DType n cs fs (NmCons n (appN cs (aNames r))) ; DMacro n ps c x (NmCons n (aNames r)) ; DCore n ps es (NmCons n (aNames r)) ; DCEq c n rn bs x (aNames r) }) }
aDup ds = orB (dupS (aNames ds) Ns0) (dupEqs ds) |> { Yes pScope ; No PANo }
aShape ds = objOf ds ObNone |> { ObNone (aPath ds) ; Ob on cs fs apc (aPath ds) ; ObErr pIface }
-- the first type named path is `Nil | Cons seg path` in shape: two
-- constructors, one nullary and one of two fields, the second the path
aPath ds = ds |> { DNil PANo ; DCons d r (d |> { DEq n bs x (aPath r) ; DDef n x (aPath r) ; DType n cs fs (eqId n idPath |> { Yes (andB (eqN (lenN cs) two) (andB (eqN (aNulls fs) one) (eqN (aConses fs) one)) |> { Yes PANo ; No pIface }) ; No (aPath r) }) ; DMacro n ps c x (aPath r) ; DCore n ps es (aPath r) ; DCEq c n rn bs x (aPath r) }) }
aNulls fs = fs |> { FsNil Zero ; FsCons f r (isNilN f |> { Yes (Suc (aNulls r)) ; No (aNulls r) }) }
aConses fs = fs |> { FsNil Zero ; FsCons f r (aConsF f |> { Yes (Suc (aConses r)) ; No (aConses r) }) }
aConsF f = f |> { NmNil No ; NmCons a r (r |> { NmNil No ; NmCons b r2 (r2 |> { NmNil (eqId b idPath) ; NmCons c r3 No }) }) }
-- a binder named S, K or I, anywhere: an equation's, a macro's parameter,
-- a lambda's, a branch's (check.py isa_binders)
aSKI ds = ds |> { DNil No ; DCons d r (orB (d |> { DEq n bs x (orB (anySKI bs) (skiE x)) ; DDef n x (skiE x) ; DType n cs fs No ; DMacro n ps c x (orB (anySKI ps) (skiE x)) ; DCore n ps es (aSKI es) ; DCEq c n rn bs x (orB (anySKI bs) (skiE x)) }) (aSKI r)) }
-- the context: the names known everywhere, the macros, the constructors,
-- the types, the program, the object type, the path type's segment type,
-- the names, `step` before each leaf, before the application constructor
-- and before every constructor
aStart st ct ys ds = objOf ds ObNone |> { ObNone (aWalk (ACx (setOf (appN aFixed (takenOf ds)) Ns0) (aMacs ds) ct ys ds ObNone (aSeg ct st ds) st NmNil idNone NmNil) ds) ; ObErr pIface ; Ob on cs fs apc (lookPre nameGRes (leavesOf apc cs) st |> { NQ rs st2 (lookPre nameGStep cs st2 |> { NQ ss st3 (aWalk (ACx (setOf (appN aFixed (appN (takenOf ds) (aGen (leavesOf apc cs) rs))) Ns0) (aMacs ds) ct ys ds (Ob on cs fs apc) (aSeg ct st ds) st (aLeafSteps cs ss apc) (aAppStep cs ss apc) ss) ds) }) }) }
-- the ISA, the Tier 1 birds and the prelude's names (expand.program_prelude)
aFixed := NmCons idS (NmCons idK (NmCons idI (NmCons idB (NmCons idC (NmCons idW (NmCons idY (NmCons idPair (NmCons idHd (NmCons idTl (NmCons idNil (NmCons idCons (NmCons idZero (NmCons idSuc (NmCons idNatAdd (NmCons idNatSub (NmCons idNatMul (NmCons idNatIfEq (NmCons idNatIfLe (NmCons idNatDiv (NmCons idNatRem (NmCons idListLength (NmCons idListAt (NmCons idListAppend (NmCons idListTake (NmCons idListDrop NmNil)))))))))))))))))))))))))
-- what generation adds at program level (generate.generated_names)
aGen lv rs = appN (nms4 idGSpApp idGSp idGRb1 idGRb) (appN rs (appN (memN idI lv |> { Yes (nms2 idGStepI1 idGStepI) ; No NmNil }) (appN (memN idK lv |> { Yes (NmCons idGStepK2 (nms2 idGStepK1 idGStepK)) ; No NmNil }) (memN idS lv |> { Yes (nms4 idGStepS3 idGStepS2 idGStepS1 idGStepS) ; No NmNil }))))
aLeafSteps cs ss apc = cs |> { NmNil NmNil ; NmCons c r (ss |> { NmNil NmNil ; NmCons s sr (eqId c apc |> { Yes (aLeafSteps r sr apc) ; No (NmCons s (aLeafSteps r sr apc)) }) }) }
aAppStep cs ss apc = cs |> { NmNil idNone ; NmCons c r (ss |> { NmNil idNone ; NmCons s sr (eqId c apc |> { Yes s ; No (aAppStep r sr apc) }) }) }
aMacs ds = ds |> { DNil Ns0 ; DCons d r (d |> { DEq n bs x (aMacs r) ; DDef n x (aMacs r) ; DType n cs fs (aMacs r) ; DMacro n ps c x (sAdd n (aMacs r)) ; DCore n ps es (aMacs r) ; DCEq c n rn bs x (aMacs r) }) }
aSeg ct st ds = pathSx ct st ds |> { SXNone MNone ; SX nl cn sg ct2 st2 (MName sg) }
gKnown g n = g |> { ACx k ms ct ys ds ob sg st sl sa ss (sHas n k) }
gMac g n = g |> { ACx k ms ct ys ds ob sg st sl sa ss (sHas n ms) }
gCt g = g |> { ACx k ms ct ys ds ob sg st sl sa ss ct }
gYs g = g |> { ACx k ms ct ys ds ob sg st sl sa ss ys }
gDs g = g |> { ACx k ms ct ys ds ob sg st sl sa ss ds }
gOb g = g |> { ACx k ms ct ys ds ob sg st sl sa ss ob }
gSg g = g |> { ACx k ms ct ys ds ob sg st sl sa ss sg }
gSt g = g |> { ACx k ms ct ys ds ob sg st sl sa ss st }
gSl g = g |> { ACx k ms ct ys ds ob sg st sl sa ss sl }
gSa g = g |> { ACx k ms ct ys ds ob sg st sl sa ss sa }
gSs g = g |> { ACx k ms ct ys ds ob sg st sl sa ss ss }
-- each declaration in turn (check.py run); a core's equations hold its
-- parameters first, so its binders past them are the equation's own
aWalk g ds = ds |> { DNil PANo ; DCons d r (aor (aDecl g d) (aWalk g r)) }
aDecl g d = d |> { DEq n bs x (aE g CxTop (setOf bs Ns0) No x) ; DDef n x (aDef g x) ; DType n cs fs PANo ; DMacro n ps c x (aE g CxTop (setOf ps Ns0) Yes x) ; DCore n ps es (aCore g ps es) ; DCEq c n rn bs x PANo }
aSpine e as = e |> { EVar n (Spn e as) ; EApp p (p |> { EAp f a (aSpine f (XCons a as)) }) ; ECell xs (Spn e as) ; EPick k x (Spn e as) ; ECase x bs (Spn e as) ; ELam x b (Spn e as) ; EQuote b fu i (Spn e as) ; EScry p (Spn e as) ; ENs fs (Spn e as) ; ENum k (Spn e as) }
aLenXs xs = xs |> { XNil Zero ; XCons x r (Suc (aLenXs r)) }
-- an expression at level 0: g the context, c the core's, bd the names
-- bound, m whether a macro's body, whose names are not checked
aE g c bd m e = e |> { EVar n (aName g c bd m n) ; EApp p (aSpine e XNil |> { Spn h as (aor (aEqPos g c bd h as) (aor (aE g c bd m h) (aEs g c bd m as))) }) ; ECell xs (aEs g c bd m xs) ; EPick k x (aE g c bd m x) ; ECase x bs (aor (aE g c bd m x) (aCase g c bd m bs)) ; ELam x b (aE g c (sAdd x bd) m b) ; EQuote b fu i (aor (i |> { INone PANo ; ISome y (aE g c bd m y) }) (aQ g b)) ; EScry p pData ; ENs fs pData ; ENum k PANo }
aEs g c bd m xs = xs |> { XNil PANo ; XCons x r (aor (aE g c bd m x) (aEs g c bd m r)) }
aName g c bd m n = orB m (sHas n bd) |> { Yes PANo ; No (orB (gKnown g n) (c |> { CxTop No ; CxCore ks np es (sHas n ks) }) |> { Yes PANo ; No pScope }) }
-- a case is over one declared type, each constructor once and every one
aCase g c bd m bs = bs |> { BNil pCase ; BCons b r (b |> { Br k ns y (findCI k (gCt g) |> { MCNone pCase ; MC i (i |> { CInfo k2 tn ix ar (aBrs g c bd m tn bs Ns0) }) }) }) }
aBrs g c bd m tn bs sn = bs |> { BNil (findTy tn (gYs g) |> { MTNone PANo ; MTy cs (aAll cs sn |> { Yes PANo ; No pCase }) }) ; BCons b r (b |> { Br k ns y (findCI k (gCt g) |> { MCNone pCase ; MC i (i |> { CInfo k2 tk ix ar (andB (eqId tk tn) (notB (sHas k sn)) |> { No pCase ; Yes (aor (aE g c (setOf ns bd) m y) (aBrs g c bd m tn r (sAdd k sn))) }) }) }) }) }
aAll ns s = ns |> { NmNil Yes ; NmCons n r (andB (sHas n s) (aAll r s)) }
-- EQ's two arguments are not provably functions (check.py eq_position)
aEqPos g c bd h as = h |> { EVar n (eqId n idEQ |> { Yes (aEqArgs g c bd as two) ; No PANo }) ; EApp p PANo ; ECell xs PANo ; EPick k x PANo ; ECase x bs PANo ; ELam x b PANo ; EQuote b fu i PANo ; EScry p PANo ; ENs fs PANo ; ENum k PANo }
aEqArgs g c bd as k = k |> { Zero PANo ; Suc j (as |> { XNil PANo ; XCons x r (aor (aFn g c bd x |> { Yes pData ; No PANo }) (aEqArgs g c bd r j)) }) }
-- what Stage A can prove a function (check.py provably_function)
aFn g c bd e = e |> { EVar n (aFnH g c bd n Zero) ; EApp p (aSpine e XNil |> { Spn h as (h |> { EVar n (aFnH g c bd n (aLenXs as)) ; EApp q No ; ECell xs No ; EPick k x No ; ECase x bs No ; ELam x b No ; EQuote b fu i No ; EScry p No ; ENs fs No ; ENum k No }) }) ; ECell xs No ; EPick k x No ; ECase x bs No ; ELam x b Yes ; EQuote b fu i No ; EScry p No ; ENs fs Yes ; ENum k No }
aFnH g c bd n k = sHas n bd |> { Yes No ; No (orB (isSKI n) (memN n (NmCons idB (NmCons idC (NmCons idW (NmCons idY NmNil))))) |> { Yes Yes ; No (findCI n (gCt g) |> { MC i (i |> { CInfo k2 tn ix ar (notB (geN k ar)) }) ; MCNone (orB (gMac g n) (orB (aEqBs (gDs g) n) (orB (c |> { CxTop No ; CxCore ks np es (aCoreBs es np n) }) (memN n (coreNames (gDs g)))))) }) }) }
aEqBs ds n = ds |> { DNil No ; DCons d r (d |> { DEq m bs x (eqId m n |> { Yes (notB (isNilN bs)) ; No (aEqBs r n) }) ; DDef m x (aEqBs r n) ; DType m cs fs (aEqBs r n) ; DMacro m ps c x (aEqBs r n) ; DCore m ps es (aEqBs r n) ; DCEq c m rn bs x (aEqBs r n) }) }
aCoreBs es np n = aFindEq es n |> { MEqNone No ; MEq bs x (geN (lenN bs) (Suc np)) }
aFindEq es n = es |> { DNil MEqNone ; DCons d r (d |> { DEq m bs x (eqId m n |> { Yes (MEq bs x) ; No (aFindEq r n) }) ; DDef m x (aFindEq r n) ; DType m cs fs (aFindEq r n) ; DMacro m ps c x (aFindEq r n) ; DCore m ps es2 (aFindEq r n) ; DCEq c m rn bs x (aFindEq r n) }) }
-- inside a quotation (check.py quoted): a name is the object type's
-- constructor, or a level-0 name, a constructor saturated; nothing binds
aQ g e = e |> { EVar n (aQHead g n Zero) ; EApp p (aSpine e XNil |> { Spn h as (aor (aQs g as) (h |> { EVar n (aQHead g n (aLenXs as)) ; EApp q (aQ g h) ; ECell xs (aQ g h) ; EPick k x (aQ g h) ; ECase x bs (aQ g h) ; ELam x b (aQ g h) ; EQuote b fu i (aQ g h) ; EScry q (aQ g h) ; ENs fs (aQ g h) ; ENum k (aQ g h) })) }) ; ECell xs (aQs g xs) ; EPick k x (aQ g x) ; ECase x bs (aor (aQ g x) (aQBs g bs)) ; ELam x b (aQ g b) ; EQuote b fu i (aor (isDatum fu i |> { Yes PANo ; No pData }) (aQ g b)) ; EScry p (aor (aPathL g p) (gOb g |> { ObNone PANo ; ObErr PANo ; Ob on cs fs apc (memN idScry (leavesOf apc cs) |> { Yes PANo ; No pSym }) })) ; ENs fs pData ; ENum k pData }
aQs g xs = xs |> { XNil PANo ; XCons x r (aor (aQ g x) (aQs g r)) }
aQBs g bs = bs |> { BNil PANo ; BCons b r (b |> { Br k ns y (aor (aQ g y) (aQBs g r)) }) }
aQHead g n k = (gOb g |> { ObNone No ; ObErr No ; Ob on cs fs apc (memN n cs) }) |> { Yes PANo ; No (gKnown g n |> { No pSym ; Yes (findCI n (gCt g) |> { MCNone PANo ; MC i (i |> { CInfo k2 tn ix ar (eqN k ar |> { Yes PANo ; No pArity }) }) }) }) }
-- a path literal (check.py path_literal): the path type declared; each
-- segment a tag, no payload, its constructor a nullary one of the
-- segment type
aPathL g p = gSg g |> { MNone pScope ; MName sg (aSegs g sg p) }
aSegs g sg p = p |> { PNil PANo ; PSeg t pay r (aor (pay |> { ISome x pData ; INone (aSegC g sg t) }) (aSegs g sg r)) }
aSegC g sg t = gSt g |> { Ist tab rv nx (itGet (capFirst (nameFor rv t)) tab |> { MIdNone pScope ; MId b (findCI (Id b) (gCt g) |> { MCNone pScope ; MC i (i |> { CInfo c tn ix ar (eqId tn sg |> { No pScope ; Yes (ar |> { Zero PANo ; Suc j pArity }) }) }) }) }) }
-- a definition (check.py definition): a namespace literal's facts, each
-- a path and a datum; a quotation, its interpreter a core applied to all
-- its parameters; anything else an expression
aDef g x = x |> { EVar n (aE g CxTop Ns0 No x) ; EApp p (aE g CxTop Ns0 No x) ; ECell xs (aE g CxTop Ns0 No x) ; EPick k y (aE g CxTop Ns0 No x) ; ECase y bs (aE g CxTop Ns0 No x) ; ELam y b (aE g CxTop Ns0 No x) ; EQuote b fu i (aor (i |> { INone PANo ; ISome y (aInterp g y) }) (aQ g b)) ; EScry p (aE g CxTop Ns0 No x) ; ENs fs (aFacts g fs) ; ENum k (aE g CxTop Ns0 No x) }
aFacts g fs = fs |> { FtNil PANo ; FtCons p v r (aor (aPathL g p) (aor (v |> { EVar n pData ; EApp q pData ; ECell xs pData ; EPick k y pData ; ECase y bs pData ; ELam y b pData ; EQuote b fu i (isDatum fu i |> { Yes (aQ g b) ; No pData }) ; EScry q pData ; ENs gs pData ; ENum k pData }) (aFacts g r))) }
aInterp g y = aSpine y XNil |> { Spn h as (h |> { EVar n (aCoreOf (gDs g) n |> { MEqNone pIface ; MEq ps x (eqN (aLenXs as) (lenN ps) |> { Yes PANo ; No pIface }) }) ; EApp q pIface ; ECell xs pIface ; EPick k x pIface ; ECase x bs pIface ; ELam x b pIface ; EQuote b fu i pIface ; EScry q pIface ; ENs fs pIface ; ENum k pIface }) }
aCoreOf ds n = ds |> { DNil MEqNone ; DCons d r (d |> { DCore m ps es (eqId m n |> { Yes (MEq ps (EVar m)) ; No (aCoreOf r n) }) ; DEq m bs x (aCoreOf r n) ; DDef m x (aCoreOf r n) ; DType m cs fs (aCoreOf r n) ; DMacro m ps c x (aCoreOf r n) ; DCEq c m rn bs x (aCoreOf r n) }) }
-- a core (check.py core): its equations, each with its parameters and
-- binders bound and the core's names known; then an interpreter core's
-- interface
aCore g ps es = aor (aCoreEqs g (CxCore (setOf (appN ps (appN (orderOf es) (aCoreGen g es))) Ns0) (lenN ps) es) es) (aIsInterp g es |> { No PANo ; Yes (aIface g (lenN ps) es) })
aCoreEqs g c es = es |> { DNil PANo ; DCons d r (aor (d |> { DEq n bs x (aE g c (setOf bs Ns0) No x) ; DDef n x PANo ; DType n cs fs PANo ; DMacro n ps m x PANo ; DCore n ps es2 PANo ; DCEq k n rn bs x PANo }) (aCoreEqs g c r)) }
aIsInterp g es = gOb g |> { ObNone No ; ObErr No ; Ob on cs fs apc (orB (orB (memN idGStep (orderOf es)) (memN idLoop (orderOf es))) (anyIn (gSs g) (orderOf es))) }
-- what generation adds to an interpreter core: `step`, and the loop unless
-- it writes `loop` (generate.names_generation_adds)
aCoreGen g es = aIsInterp g es |> { No NmNil ; Yes (appN (memN idGStep (orderOf es) |> { Yes NmNil ; No (nms1 idGStep) }) (memN idLoop (orderOf es) |> { Yes NmNil ; No (nms2 idLoop idGLoop1) })) }
-- the interface (check.py interface): no step for the application
-- constructor; a written `step` takes the term and installs the leaves'
-- steps in declaration order; a written `loop` the fuel and the term;
-- `loop1` only with `loop`, and the loop, the term and the fuel left
aIface g np es = aor (memN (gSa g) (orderOf es) |> { Yes pIface ; No PANo }) (aor (aFindEq es idGStep |> { MEqNone PANo ; MEq bs x (aStep g np bs x) }) (aor (aFindEq es idLoop |> { MEqNone PANo ; MEq bs x (eqN (minus (lenN bs) np) two |> { Yes PANo ; No pIface }) }) (aFindEq es idGLoop1 |> { MEqNone PANo ; MEq bs x (memN idLoop (orderOf es) |> { No pIface ; Yes (eqN (minus (lenN bs) np) (Suc two) |> { Yes PANo ; No pIface }) }) })))
aStep g np bs x = eqN (minus (lenN bs) np) one |> { No pIface ; Yes (aSpine x XNil |> { Spn h as (h |> { EVar n (eqId n idGSp |> { No PANo ; Yes (eqN (aLenXs as) (Suc (Suc (lenN (gSl g)))) |> { No pIface ; Yes (aHeads (aDrop2 as) |> { HsNone PANo ; HsIs ns (andB (aAllIn (gSl g) ns) (notB (aEqNs ns (gSl g))) |> { Yes pIface ; No PANo }) }) }) }) ; EApp q PANo ; ECell xs PANo ; EPick k y PANo ; ECase y b2 PANo ; ELam y b PANo ; EQuote b fu i PANo ; EScry q PANo ; ENs fs PANo ; ENum k PANo }) }) }
-- each argument's head a name, or not every one; a permutation of the
-- leaves' steps that is not their order is refused (check.py step_arm)
aHeads xs = xs |> { XNil (HsIs NmNil) ; XCons x r (aSpine x XNil |> { Spn h as (h |> { EVar n (aHeads r |> { HsNone HsNone ; HsIs ns (HsIs (NmCons n ns)) }) ; EApp q HsNone ; ECell ys HsNone ; EPick k y HsNone ; ECase y b2 HsNone ; ELam y b HsNone ; EQuote b fu i HsNone ; EScry q HsNone ; ENs fs HsNone ; ENum k HsNone }) }) }
aDrop2 xs = xs |> { XNil XNil ; XCons x r (r |> { XNil XNil ; XCons y r2 r2 }) }
aAllIn ws ns = ws |> { NmNil Yes ; NmCons w r (andB (memN w ns) (aAllIn r ns)) }
aEqNs a b = a |> { NmNil (b |> { NmNil Yes ; NmCons y r No }) ; NmCons x r (b |> { NmNil No ; NmCons y s (andB (eqId x y) (aEqNs r s)) }) }
-- Stage B (typecheck.py), over the generated program with its bodies
-- macro-expanded, after Stage A, as the expander checks before it
-- expands.  Every problem is a TypeMismatchError, so the first ends it:
-- each step takes the state and a continuation, and a problem returns BNo.
-- Types are nodes in a store keyed by number, as Python's objects are: a
-- variable (its link, the data and numeral constraints, a list's element),
-- a constructor and its arguments, and an arrow, whose elimination,
-- nominal type, datum, checked and numeral marks unification changes in
-- place.  Each node gets the next number, so the variables keep Python's
-- order, which generalization sorts by
--
-- the store, the next number, the program's schemes, the cores' (by
-- `core.eq`), the group's monotypes, the group's literals, latest first
-- the context: the program, the FUEL node, the constructors, the declared
-- numeral types, the names' texts
ndPut b x m = m |> { Nd0 (ndPut b x (NdT (NdB MTnNone Nd0 Nd0))) ; NdT t (t |> { NdB v z o (b |> { Bn (NdT (NdB x z o)) ; Bz r (NdT (NdB v (ndPut r x z) o)) ; Bo r (NdT (NdB v z (ndPut r x o))) }) }) }
ndGet b m = m |> { Nd0 MTnNone ; NdT t (t |> { NdB v z o (b |> { Bn v ; Bz r (ndGet r z) ; Bo r (ndGet r o) }) }) }
evPut b x m = m |> { Ev0 (evPut b x (EvT (EvB MScNone Ev0 Ev0))) ; EvT t (t |> { EvB v z o (b |> { Bn (EvT (EvB x z o)) ; Bz r (EvT (EvB v (evPut r x z) o)) ; Bo r (EvT (EvB v z (evPut r x o))) }) }) }
evGet b m = m |> { Ev0 MScNone ; EvT t (t |> { EvB v z o (b |> { Bn v ; Bz r (evGet r z) ; Bo r (evGet r o) }) }) }
bmPut b x m = m |> { Bm0 (bmPut b x (BmT (BmB MBtNone Bm0 Bm0))) ; BmT t (t |> { BmB v z o (b |> { Bn (BmT (BmB x z o)) ; Bz r (BmT (BmB v (bmPut r x z) o)) ; Bo r (BmT (BmB v z (bmPut r x o))) }) }) }
bmGet b m = m |> { Bm0 MBtNone ; BmT t (t |> { BmB v z o (b |> { Bn v ; Bz r (bmGet r z) ; Bo r (bmGet r o) }) }) }
bmDel b m = m |> { Bm0 Bm0 ; BmT t (t |> { BmB v z o (b |> { Bn (BmT (BmB MBtNone z o)) ; Bz r (BmT (BmB v (bmDel r z) o)) ; Bo r (BmT (BmB v z (bmDel r o))) }) }) }
-- the state's parts
bsNode s b = s |> { BS m nx ev ce mo li (ndGet b m |> { MTn x x ; MTnNone (TNV LkNone No No LkNone) }) }
bsSet s b x = s |> { BS m nx ev ce mo li (BS (ndPut b (MTn x) m) nx ev ce mo li) }
bsNew s x k = s |> { BS m nx ev ce mo li (k nx (BS (ndPut nx (MTn x) m) (inc nx) ev ce mo li)) }
bsEnv s n = s |> { BS m nx ev ce mo li (evGet (idBits n) ev) }
bsEnvPut s n x = s |> { BS m nx ev ce mo li (BS m nx (evPut (idBits n) (MSc x) ev) ce mo li) }
bsCEnv s n = s |> { BS m nx ev ce mo li (evGet (idBits n) ce) }
bsCEnvPut s n x = s |> { BS m nx ev ce mo li (BS m nx ev (evPut (idBits n) (MSc x) ce) mo li) }
bsMono s n = s |> { BS m nx ev ce mo li (bmGet (idBits n) mo) }
bsMonoPut s n x = s |> { BS m nx ev ce mo li (BS m nx ev ce (bmPut (idBits n) (MBt x) mo) li) }
bsMonoDel s n = s |> { BS m nx ev ce mo li (BS m nx ev ce (bmDel (idBits n) mo) li) }
bsLits s = s |> { BS m nx ev ce mo li li }
bsLitsSet s l = s |> { BS m nx ev ce mo li (BS m nx ev ce mo l) }
bsLitAdd s t = s |> { BS m nx ev ce mo li (BS m nx ev ce mo (BsCons t li)) }
gDecls g = g |> { BGx ds fu ct nu rv ds }
gFuel g = g |> { BGx ds fu ct nu rv fu }
gCts g = g |> { BGx ds fu ct nu rv ct }
gNums g = g |> { BGx ds fu ct nu rv nu }
gRv g = g |> { BGx ds fu ct nu rv rv }
-- numbers, as lists and in order
memB x xs = xs |> { BsNil No ; BsCons y r (orB (eqB x y) (memB x r)) }
addB x xs = memB x xs |> { Yes xs ; No (BsCons x xs) }
lenBs xs = xs |> { BsNil Zero ; BsCons x r (Suc (lenBs r)) }
revB xs acc = xs |> { BsNil acc ; BsCons x r (revB r (BsCons x acc)) }
cmpBits a b = a |> { Bn (b |> { Bn CEq ; Bz y CLt ; Bo y CLt }) ; Bz x (b |> { Bn CGt ; Bz y (cmpBits x y) ; Bo y (thenC (cmpBits x y) CLt) }) ; Bo x (b |> { Bn CGt ; Bz y (thenC (cmpBits x y) CGt) ; Bo y (cmpBits x y) }) }
insB x xs = xs |> { BsNil (BsCons x BsNil) ; BsCons y r (cmpBits x y |> { CLt (BsCons x xs) ; CEq (BsCons x xs) ; CGt (BsCons y (insB x r)) }) }
sortB xs = xs |> { BsNil BsNil ; BsCons x r (insB x (sortB r)) }
-- nodes: a fresh variable, a constructor, an arrow, an arrow's marks
bVar d n e s k = bsNew s (TNV LkNone d n e) k
bFresh s k = bVar No No LkNone s k
bCon x as s k = bsNew s (TNC x as) k
bArr p q el nm s k = bsNew s (TNA p q el nm No MNone No) k
bRes s b = bsNode s b |> { TNV r d n e (r |> { LkNone b ; LkTo c (bRes s c) }) ; TNC x a b ; TNA p q el nm dt ck nu b }
setElim s a v = bsNode s a |> { TNV r d n e s ; TNC x y s ; TNA p q el nm dt ck nu (bsSet s a (TNA p q v nm dt ck nu)) }
setChecked s a c = bsNode s a |> { TNV r d n e s ; TNC x y s ; TNA p q el nm dt ck nu (bsSet s a (TNA p q el nm dt c nu)) }
setDN s a dv nv = bsNode s a |> { TNV r d n e s ; TNC x y s ; TNA p q el nm dt ck nu (bsSet s a (TNA p q el nm dv ck nv)) }
setElem s v x = bsNode s v |> { TNV r d n e (bsSet s v (TNV r d n (LkTo x))) ; TNC y z s ; TNA p q el nm dt ck nu s }
-- _arrows: the last parameter's arrow made first; _scott: a datum's spine,
-- only its first arrow an elimination, committed to the type
bArrows ps r s k = ps |> { BsNil (k r s) ; BsCons p rest (bArrows rest r s (bArrowsK p k)) }
bArrowsK p k t s = bArr p t No MNone s k
bScott cs r nm s k = cs |> { BsNil (k r s) ; BsCons c0 rest (bArrows rest r s (bScottK c0 nm k)) }
bScottK c0 nm k t s = bArr c0 t Yes (MName nm) s k
bs1 a = BsCons a BsNil
bs2 a b = BsCons a (bs1 b)
bs3 a b c = BsCons a (bs2 b c)
bs4 a b c d = BsCons a (bs3 b c d)
-- the declared types: a type's constructors' fields, a constructor's
-- type, the numeral and list types (typecheck.py numeral_types, list_types)
tyFss ds n = ds |> { DNil MFsNone ; DCons d r (d |> { DEq m bs x (tyFss r n) ; DDef m x (tyFss r n) ; DType m cs fs (eqId m n |> { Yes (MFs cs) ; No (tyFss r n) }) ; DMacro m ps c x (tyFss r n) ; DCore m ps es (tyFss r n) ; DCEq c m rn bs x (tyFss r n) }) }
isTy g n = tyFss (gDecls g) n |> { MFs cs Yes ; MFsNone No }
tyFields ds n = ds |> { DNil FsNil ; DCons d r (d |> { DEq m bs x (tyFields r n) ; DDef m x (tyFields r n) ; DType m cs fs (eqId m n |> { Yes fs ; No (tyFields r n) }) ; DMacro m ps c x (tyFields r n) ; DCore m ps es (tyFields r n) ; DCEq c m rn bs x (tyFields r n) }) }
ctorFs cs fs c = cs |> { NmNil MFsNone ; NmCons n r (fs |> { FsNil MFsNone ; FsCons f fr (eqId n c |> { Yes (MFs f) ; No (ctorFs r fr c) }) }) }
ctorTy g c = findCI c (gCts g) |> { MC i (i |> { CInfo k tn ix ar (MName tn) }) ; MCNone MNone }
numTys ds = ds |> { DNil NmNil ; DCons d r (d |> { DEq m bs x (numTys r) ; DDef m x (numTys r) ; DType m cs fs (isNumTy m fs |> { Yes (NmCons m (numTys r)) ; No (numTys r) }) ; DMacro m ps c x (numTys r) ; DCore m ps es (numTys r) ; DCEq c m rn bs x (numTys r) }) }
isNumTy m fs = fs |> { FsNil No ; FsCons a r (r |> { FsNil No ; FsCons b r2 (andB (isNilN a) (andB (fsNil r2) (isOnly m b))) }) }
isOnly m b = b |> { NmNil No ; NmCons x r3 (andB (eqId x m) (isNilN r3)) }
fsNil fs = fs |> { FsNil Yes ; FsCons f r No }
isNumeral g n = orB (eqId n idFuel) (memN n (gNums g))
listElemOf ds n = tyFss ds n |> { MFsNone MNone ; MFs cs (isListTy n (tyFields ds n)) }
isListTy n fs = fs |> { FsNil MNone ; FsCons a r (r |> { FsNil MNone ; FsCons b r2 (andB (isNilN a) (fsNil r2) |> { No MNone ; Yes (b |> { NmNil MNone ; NmCons x r3 (r3 |> { NmNil MNone ; NmCons y r4 (andB (eqId y n) (isNilN r4) |> { Yes (MName x) ; No MNone }) }) }) }) }) }
-- field: a type a declaration names, a declared type or the prelude's fuel
bField g n s k = isTy g n |> { Yes (bCon n BsNil s k) ; No (eqId n idFuel |> { Yes (k (gFuel g) s) ; No BNo }) }
bFields g fs s k = fs |> { NmNil (k BsNil s) ; NmCons f r (bField g f s (bFieldsK g r k)) }
bFieldsK g r k t s = bFields g r s (bFieldsK2 t k)
bFieldsK2 t k ts s = k (BsCons t ts) s
-- scott: what a datum of a type is when applied; none for any other
bScottOf g t s k = bsNode s t |> { TNV r d n e BNo ; TNC x as (bFresh s (bScott1 g x as k)) ; TNA p q el nm dt ck nu BNo }
bScott1 g x as k r s = isTy g x |> { Yes (bConts g (tyFields (gDecls g) x) r s (bScott2 r x k)) ; No (eqId x idFuel |> { Yes (bArr (gFuel g) r No MNone s (bScottFuel r k)) ; No (eqId x idList |> { Yes (bScottList as r s k) ; No (eqId x idCell |> { Yes (bScottCell as r s k) ; No BNo }) }) }) }
bScott2 r x k cs s = bScott cs r x s k
bScottFuel r k a s = bScott (bs2 r a) r idFuel s k
bScottList as r s k = as |> { BsNil BNo ; BsCons a rest (bCon idList (bs1 a) s (bScottList2 a r k)) }
bScottList2 a r k la s = bArrows (bs2 a la) r s (bScottList3 r k)
bScottList3 r k c s = bScott (bs2 r c) r idList s k
bScottCell as r s k = as |> { BsNil BNo ; BsCons a r2 (r2 |> { BsNil BNo ; BsCons b r3 (bArrows (bs2 a b) r s (bScottCell2 r k)) }) }
bScottCell2 r k c s = bScott (bs1 c) r idCell s k
bConts g cfs r s k = cfs |> { FsNil (k BsNil s) ; FsCons fs rest (bFields g fs s (bContsK g rest r k)) }
bContsK g rest r k ts s = bArrows ts r s (bContsK2 g rest r k)
bContsK2 g rest r k c s = bConts g rest r s (bContsK3 c k)
bContsK3 c k cs s = k (BsCons c cs) s

-- unification, oriented, expected against given; equirecursive, a pair
-- met again assumed to hold.  The pairs seen are threaded, as Python's
-- set is shared down one top-level call
bUnify g e g0 s k = bUni g e g0 BpNil s (bUnifyK k)
bUnifyK k sn s = k s
bUni g e0 g0 sn s k = bUni2 g (bRes s e0) (bRes s g0) sn s k
bUni2 g e gv sn s k = eqB e gv |> { Yes (k sn s) ; No (bsNode s e |> { TNV r d n el (bBind g e gv s (k sn)) ; TNC x xs (bUniC g e x xs gv sn s k) ; TNA p q el nm dt ck nu (bUniA g e gv sn s k) }) }
bUniC g e x xs gv sn s k = bsNode s gv |> { TNV r d n el (bBind g gv e s (k sn)) ; TNC y ys (bSeen e gv sn s k (bConCon g x xs ys y)) ; TNA p q el nm dt ck nu (bSeen e gv sn s k (bConArr g e x gv)) }
bUniA g e gv sn s k = bsNode s gv |> { TNV r d n el (bBind g gv e s (k sn)) ; TNC y ys (bSeen e gv sn s k (bArrCon g e gv y)) ; TNA p q el nm dt ck nu (bSeen e gv sn s k (bArrArr g e gv)) }
bpHas a b ps = ps |> { BpNil No ; BpCons x y r (andB (eqB a x) (eqB b y) |> { Yes Yes ; No (bpHas a b r) }) }
bSeen e gv sn s k f = bpHas e gv sn |> { Yes (k sn s) ; No (f (BpCons e gv sn) s k) }
bConCon g x xs ys y sn s k = andB (eqId x y) (eqN (lenBs xs) (lenBs ys)) |> { No BNo ; Yes (bUniArgs g xs ys sn s k) }
bUniArgs g xs ys sn s k = xs |> { BsNil (k sn s) ; BsCons a r (ys |> { BsNil (k sn s) ; BsCons b r2 (bUni g a b sn s (bUniArgsK g r r2 k)) }) }
bUniArgsK g r r2 k sn s = bUniArgs g r r2 sn s k
mnIs m y = m |> { MName x (eqId x y) ; MNone No }
mnOther m y = m |> { MName x (notB (eqId x y)) ; MNone No }
mnSome m = m |> { MName x Yes ; MNone No }
mnClash a b = a |> { MName x (b |> { MName y (notB (eqId x y)) ; MNone No }) ; MNone No }
mnOr a b = a |> { MName x a ; MNone b }
-- an arrow against a datum: the datum applied, its Scott spine
bArrCon g e gv y sn s k = bsNode s e |> { TNV r d n el BNo ; TNC x xs BNo ; TNA p q el nm dt ck nu (mnIs ck y |> { Yes (k sn s) ; No (andB el (mnOther nm y) |> { Yes BNo ; No (bScottOf g gv s (bArrCon2 g e y el sn k)) }) }) }
bArrCon2 g e y el sn k sc s = el |> { Yes (bNominate g e y s (bArrCon3 g e y sc sn k)) ; No (bArrCon3 g e y sc sn k s) }
bArrCon3 g e y sc sn k s = bUni g e sc sn (setChecked s e (MName y)) k
-- a datum expected, an arrow given: only an elimination may be a datum
bConArr g e x gv sn s k = bsNode s gv |> { TNV r d n el BNo ; TNC y ys BNo ; TNA p q el nm dt ck nu (el |> { No BNo ; Yes (mnOther nm x |> { Yes BNo ; No (mnIs ck x |> { Yes (k sn s) ; No (bScottOf g e s (bConArr2 g gv x sn k)) }) }) }) }
bConArr2 g gv x sn k sc s = bNominate g gv x s (bConArr3 g gv x sc sn k)
bConArr3 g gv x sc sn k s = bUni g gv sc sn (setChecked s gv (MName x)) k
-- two arrows: their marks reconciled, then the parameters, flipped, and
-- the results
bArrArr g e gv sn s k = bsNode s e |> { TNV r d n el BNo ; TNC x xs BNo ; TNA ep eq eel enm edt eck enu (bsNode s gv |> { TNV r d n el BNo ; TNC x xs BNo ; TNA gp gq gel gnm gdt gck gnu (bAAF g e gv eel enm edt enu gel gnm gdt gnu s (bAAK g ep eq gp gq sn k)) }) }
bAAF g e gv eel enm edt enu gel gnm gdt gnu s k = andB gel (notB eel) |> { Yes (k s) ; No (andB eel (notB gel) |> { Yes (orB (mnSome enm) edt |> { Yes BNo ; No (k (setElim s e No)) }) ; No (andB eel gel |> { No (k s) ; Yes (mnClash enm gnm |> { Yes BNo ; No (bAAM g e gv (mnOr enm gnm) (setDN (setDN s e (orB edt gdt) (orB enu gnu)) gv (orB edt gdt) (orB enu gnu)) k) }) }) }) }
bAAM g e gv nm s k = nm |> { MName x (bNominate g e x s (bAAM2 g gv x k)) ; MNone (k s) }
bAAM2 g gv x k s = bNominate g gv x s k
bAAK g ep eq gp gq sn k s = bUni g gp ep sn s (bAAK2 g eq gq k)
bAAK2 g eq gq k sn s = bUni g eq gq sn s k
-- commit an elimination arrow to a type
bNominate g a nm s k = bsNode s a |> { TNV r d n e (k s) ; TNC x y (k s) ; TNA p q el n0 dt ck nu (andB nu (notB (isNumeral g nm)) |> { Yes BNo ; No (k (bsSet s a (TNA p q el (MName nm) dt ck nu))) }) }
-- bind: a variable's constraints met, then its link
bBind g v t0 s k = bBind2 g v (bRes s t0) s k
bBind2 g v t s k = eqB t v |> { Yes (k s) ; No (bsNode s v |> { TNV r d n e (d |> { Yes (bReqData g t BsNil s (bBindK1 g v t k)) ; No (bBindN g v t s k) }) ; TNC x y (k s) ; TNA p q el nm dt ck nu (k s) }) }
bBindK1 g v t k sn s = bBindN g v t s k
bBindN g v t s k = bsNode s v |> { TNV r d n e (n |> { Yes (bReqNum g t s (bBindE g v t k)) ; No (bBindE g v t k s) }) ; TNC x y (k s) ; TNA p q el nm dt ck nu (k s) }
bBindE g v t k s = bsNode s v |> { TNV r d n e (e |> { LkNone (bLink v t k s) ; LkTo x (bReqList g t x s (bLink v t k)) }) ; TNC x y (k s) ; TNA p q el nm dt ck nu (k s) }
bLink v t k s = bsNode s v |> { TNV r d n e (k (bsSet s v (TNV (LkTo t) d n e))) ; TNC x y (k s) ; TNA p q el nm dt ck nu (k s) }
-- the data constraint: no function anywhere in a value of the type,
-- through a cell's and a list's components; the nodes seen threaded
bReqData g t0 sn s k = bReqD2 g (bRes s t0) sn s k
bReqD2 g t sn s k = memB t sn |> { Yes (k sn s) ; No (bsNode s t |> { TNV r d n e (k (BsCons t sn) (bsSet s t (TNV r Yes n e))) ; TNC x as (bReqDs g as (BsCons t sn) s k) ; TNA p q el nm dt ck nu (el |> { No BNo ; Yes (k (BsCons t sn) (bsSet s t (TNA p q el nm Yes ck nu))) }) }) }
bReqDs g as sn s k = as |> { BsNil (k sn s) ; BsCons a r (bReqData g a sn s (bReqDsK g r k)) }
bReqDsK g r k sn s = bReqDs g r sn s k
-- the numeral constraint: a numeral type, or an unknown datum that must
-- become one
bReqNum g t0 s k = bReqNum2 g (bRes s t0) s k
bReqNum2 g t s k = bsNode s t |> { TNV r d n e (k (bsSet s t (TNV r d Yes e))) ; TNC x as (isNumeral g x |> { Yes (k s) ; No BNo }) ; TNA p q el nm dt ck nu (el |> { No BNo ; Yes (bReqNum3 g t nm (bsSet s t (TNA p q el nm Yes ck Yes)) k) }) }
bReqNum3 g t nm s k = nm |> { MName x (bNominate g t x s k) ; MNone (k s) }
-- the list constraint: a list of the element, the prelude's list, a
-- declared list type, or an unknown datum eliminated as a list of them
bReqList g t0 el s k = bReqL2 g (bRes s t0) el s k
bReqL2 g t el s k = bsNode s t |> { TNV r d n e (e |> { LkNone (k (bsSet s t (TNV r d n (LkTo el)))) ; LkTo x (bUnify g x el s k) }) ; TNC x as (eqId x idList |> { Yes (as |> { BsNil BNo ; BsCons a rr (bUnify g a el s k) }) ; No (listElemOf (gDecls g) x |> { MName fe (bField g fe s (bReqLF g el k)) ; MNone BNo }) }) ; TNA p q e2 nm dt ck nu (e2 |> { No BNo ; Yes (bFresh s (bReqLA g t el k)) }) }
bReqLF g el k ft s = bUnify g ft el s k
bReqLA g t el k r s = bVar No No (LkTo el) s (bReqLA2 g t el k r)
bReqLA2 g t el k r fv s = bArrows (bs2 el fv) r s (bReqLA3 g t k r)
bReqLA3 g t k r c s = bArr c r No MNone s (bReqLA4 g t k r)
bReqLA4 g t k r m s = bArr r m Yes MNone s (bReqLA5 g t k)
bReqLA5 g t k sp s = bUnify g t sp s k

-- instantiate: the quantified variables renamed, the type copied, each
-- copy a hole first, linked to the node once made; a nullary constructor
-- shared; the copies' marks as the original's
bInst g sc s k = sc |> { Sch vs ds t ns els (bInstSub vs ds ns Bm0 s (bInst2 g els t k)) }
bInstSub vs ds ns sub s k = vs |> { BsNil (k sub s) ; BsCons v r (bVar (memB v ds) (memB v ns) LkNone s (bInstSubK v r ds ns sub k)) }
bInstSubK v r ds ns sub k w s = bInstSub r ds ns (bmPut v (MBt w) sub) s k
bInst2 g els t k sub s = bInstEl g sub els Bm0 s (bInst3 g sub t k)
bInstEl g sub els mo s k = els |> { ElNil (k mo s) ; ElCons v et r (bGo g sub et mo s (bInstElK g sub v r k)) }
bInstElK g sub v r k e2 mo s = bInstEl g sub r mo (setElem s (bmGetD v sub) e2) k
bmGetD b m = bmGet b m |> { MBt x x ; MBtNone b }
bInst3 g sub t k mo s = bGo g sub t mo s (bInst4 k)
bInst4 k t2 mo s = k t2 s
bGo g sub t0 mo s k = bGo2 g sub (bRes s t0) mo s k
bGo2 g sub t mo s k = bsNode s t |> { TNV r d n e (k (bmGetD t sub) mo s) ; TNC x as (bmGet t mo |> { MBt h (k h mo s) ; MBtNone (as |> { BsNil (k t mo s) ; BsCons a r (bFresh s (bGoCon g sub t x as mo k)) }) }) ; TNA p q el nm dt ck nu (bmGet t mo |> { MBt h (k h mo s) ; MBtNone (bFresh s (bGoArr g sub t p q el nm dt ck nu mo k)) }) }
bGoCon g sub t x as mo k h s = bGoL g sub as (bmPut t (MBt h) mo) s (bGoCon2 x h k)
bGoCon2 x h k as2 mo s = bCon x as2 s (bGoFill h mo k)
bGoFill h mo k nw s = k nw mo (bsSet s h (TNV (LkTo nw) No No LkNone))
bGoL g sub as mo s k = as |> { BsNil (k BsNil mo s) ; BsCons a r (bGo g sub a mo s (bGoLK g sub r k)) }
bGoLK g sub r k a2 mo s = bGoL g sub r mo s (bGoLK2 a2 k)
bGoLK2 a2 k as2 mo s = k (BsCons a2 as2) mo s
bGoArr g sub t p q el nm dt ck nu mo k h s = bGo g sub p (bmPut t (MBt h) mo) s (bGoArr2 g sub q el nm dt ck nu h k)
bGoArr2 g sub q el nm dt ck nu h k p2 mo s = bGo g sub q mo s (bGoArr3 p2 el nm dt ck nu h k)
bGoArr3 p2 el nm dt ck nu h k q2 mo s = bsNew s (TNA p2 q2 el nm dt ck nu) (bGoFill h mo k)
-- free: a type's unbound variables, a list's element followed once
bFree t0 out sn s = bFree2 (bRes s t0) out sn s
bFree2 t out sn s = bsNode s t |> { TNV r d n e (e |> { LkNone (FV (addB t out) sn) ; LkTo x (memB t sn |> { Yes (FV (addB t out) sn) ; No (bFree x (addB t out) (BsCons t sn) s) }) }) ; TNC x as (memB t sn |> { Yes (FV out sn) ; No (bFreeL as out (BsCons t sn) s) }) ; TNA p q el nm dt ck nu (memB t sn |> { Yes (FV out sn) ; No (bFreeQ q (bFree p out (BsCons t sn) s) s) }) }
bFreeQ q r s = r |> { FV o sn (bFree q o sn s) }
bFreeL as out sn s = as |> { BsNil (FV out sn) ; BsCons a r (bFreeL2 r (bFree a out sn s) s) }
bFreeL2 r v s = v |> { FV o sn (bFreeL r o sn s) }
fvOut v = v |> { FV o sn o }
isDataV s v = bsNode s v |> { TNV r d n e d ; TNC x y No ; TNA p q el nm dt ck nu No }
isNumV s v = bsNode s v |> { TNV r d n e n ; TNC x y No ; TNA p q el nm dt ck nu No }
filtData s qs = qs |> { BsNil BsNil ; BsCons x r (isDataV s x |> { Yes (BsCons x (filtData s r)) ; No (filtData s r) }) }
filtNum s qs = qs |> { BsNil BsNil ; BsCons x r (isNumV s x |> { Yes (BsCons x (filtNum s r)) ; No (filtNum s r) }) }
elsOf s qs = qs |> { BsNil ElNil ; BsCons x r (bsNode s x |> { TNV lr d n e (e |> { LkNone (elsOf s r) ; LkTo y (ElCons x y (elsOf s r)) }) ; TNC y z (elsOf s r) ; TNA p q el nm dt ck nu (elsOf s r) }) }
bSchOf t qs s = Sch qs (filtData s qs) t (filtNum s qs) (elsOf s qs)
-- close: every free variable quantified.  generalize (typecheck.py) is
-- the same here: it quantifies all but the environment's free variables,
-- and those are always none.  Every program-level scheme is closed: a
-- constructor's, a datum's and a run's hold no variable, a core's loop is
-- a core's closed scheme, and generalize, the environment having none,
-- quantifies all; the group's monotypes are dropped before it runs; and
-- a scheme's type is only ever instantiated, a copy, so it stays closed
bClosed t s = bSchOf t (sortB (fvOut (bFree t BsNil BsNil s))) s
bGeneral t s = bClosed t s
-- the builtins (typecheck.py builtin), each built afresh and closed; k
-- takes the scheme, or none
bBuiltin g n s k = isSKI n |> { Yes (bBuiltinSKI g n s k) ; No (memN n (NmCons idB (NmCons idC (NmCons idW (NmCons idY NmNil)))) |> { Yes (bBuiltinBird g n s k) ; No (bBuiltinP g n s k) }) }
bF2 s k = bFresh s (bF2K k)
bF2K k a s = bFresh s (k a)
bF3 s k = bFresh s (bF3K k)
bF3K k a s = bF2 s (k a)
bClose k t s = k (MSc (bClosed t s)) s
bBuiltinSKI g n s k = eqId n idS |> { Yes (bF3 s (bBS k)) ; No (eqId n idK |> { Yes (bF2 s (bBK k)) ; No (bFresh s (bBI k)) }) }
bBS k a b c s = bArrows (bs2 a b) c s (bBS2 k a b c)
bBS2 k a b c i1 s = bArr a b No MNone s (bBS3 k a c i1)
bBS3 k a c i1 i2 s = bArrows (bs3 i1 i2 a) c s (bClose k)
bBK k a b s = bArrows (bs2 a b) a s (bClose k)
bBI k a s = bArr a a No MNone s (bClose k)
bBuiltinBird g n s k = eqId n idB |> { Yes (bF3 s (bBB k)) ; No (eqId n idC |> { Yes (bF3 s (bBC k)) ; No (eqId n idW |> { Yes (bF2 s (bBW k)) ; No (bFresh s (bBY k)) }) }) }
bBB k a b c s = bArr b c No MNone s (bBB2 k a b c)
bBB2 k a b c i1 s = bArr a b No MNone s (bBB3 k a c i1)
bBB3 k a c i1 i2 s = bArrows (bs3 i1 i2 a) c s (bClose k)
bBC k a b c s = bArrows (bs2 a b) c s (bBC2 k a b c)
bBC2 k a b c i1 s = bArrows (bs3 i1 b a) c s (bClose k)
bBW k a b s = bArrows (bs2 a a) b s (bBW2 k a b)
bBW2 k a b i1 s = bArrows (bs2 i1 a) b s (bClose k)
bBY k a s = bArr a a No MNone s (bBY2 k a)
bBY2 k a i1 s = bArr i1 a No MNone s (bClose k)
-- the prelude's, the numeral operations' and the list operations'
bBuiltinP g n s k = eqId n idPair |> { Yes (bF2 s (bBPair k)) ; No (eqId n idHd |> { Yes (bF2 s (bBHd k)) ; No (eqId n idTl |> { Yes (bF2 s (bBTl k)) ; No (eqId n idNil |> { Yes (bFresh s (bBNil k)) ; No (eqId n idCons |> { Yes (bFresh s (bBCons k)) ; No (eqId n idZero |> { Yes (k (MSc (Sch BsNil BsNil (gFuel g) BsNil ElNil)) s) ; No (eqId n idSuc |> { Yes (bArr (gFuel g) (gFuel g) No MNone s (bBSuc k)) ; No (bBuiltinOps g n s k) }) }) }) }) }) }) }
bBPair k a b s = bCon idCell (bs2 a b) s (bBPair2 k a b)
bBPair2 k a b c s = bArrows (bs2 a b) c s (bClose k)
bBHd k a b s = bCon idCell (bs2 a b) s (bBHd2 k a)
bBHd2 k a c s = bArr c a No MNone s (bClose k)
bBTl k a b s = bCon idCell (bs2 a b) s (bBHd2 k b)
bBNil k a s = bCon idList (bs1 a) s (bClose k)
bBCons k a s = bCon idList (bs1 a) s (bBCons2 k a)
bBCons2 k a l1 s = bCon idList (bs1 a) s (bBCons3 k a l1)
bBCons3 k a l1 l2 s = bArrows (bs2 a l1) l2 s (bClose k)
bBSuc k t s = k (MSc (Sch BsNil BsNil t BsNil ElNil)) s
bBuiltinOps g n s k = memN n (NmCons idNatAdd (NmCons idNatSub (NmCons idNatMul (NmCons idNatDiv (NmCons idNatRem NmNil))))) |> { Yes (bVar No Yes LkNone s (bBArith k)) ; No (memN n (NmCons idNatIfEq (NmCons idNatIfLe NmNil)) |> { Yes (bVar No Yes LkNone s (bBTest k)) ; No (memN n (NmCons idListLength (NmCons idListAt (NmCons idListAppend (NmCons idListTake (NmCons idListDrop NmNil))))) |> { Yes (bFresh s (bBList n k)) ; No (k MScNone s) }) }) }
bBArith k a s = bArrows (bs2 a a) a s (bClose k)
bBTest k a s = bFresh s (bBTest2 k a)
bBTest2 k a b s = bArrows (bs4 a a b b) b s (bClose k)
bBList n k e s = bVar No No (LkTo e) s (bBList2 n k e)
bBList2 n k e ls s = bVar No Yes LkNone s (bBList3 n k e ls)
bBList3 n k e ls nn s = eqId n idListLength |> { Yes (bArr ls nn No MNone s (bClose k)) ; No (eqId n idListAt |> { Yes (bArrows (bs3 ls nn e) e s (bClose k)) ; No (eqId n idListAppend |> { Yes (bArrows (bs2 ls ls) ls s (bClose k)) ; No (bArrows (bs2 ls nn) ls s (bClose k)) }) }) }
-- lookup: the bound names, the ISA, the core's own, the group's, the
-- program's, then the builtins
bdGet n bd = bd |> { BdNil MBtNone ; BdCons m t r (eqId n m |> { Yes (MBt t) ; No (bdGet n r) }) }
bLookup g n bd cx s k = bLookFrom g n (bLookWhere n bd cx s) s (bLookInst g k)
bLookWhere n bd cx s = bdGet n bd |> { MBt t (LsT t) ; MBtNone (isSKI n |> { Yes LsB ; No (cx |> { BxTop (bLook3 n s) ; BxCore rn (rnFind n rn |> { MNone (bLook3 n s) ; MName c (bsMono s c |> { MBt t (LsT t) ; MBtNone (bsCEnv s c |> { MSc sc (LsS sc) ; MScNone (bLook3 n s) }) }) }) }) }) }
bLook3 n s = bsMono s n |> { MBt t (LsT t) ; MBtNone (bsEnv s n |> { MSc sc (LsS sc) ; MScNone LsB }) }
bLookFrom g n w s k = w |> { LsT t (k (LsT t) s) ; LsS sc (k (LsS sc) s) ; LsB (bBuiltin g n s (bLookBK k)) }
bLookBK k m s = m |> { MSc sc (k (LsS sc) s) ; MScNone BNo }
bLookInst g k w s = w |> { LsT t (k t s) ; LsS sc (bInst g sc s k) ; LsB BNo }

-- inference over a macro-expanded body; k takes its type
bInfer g e bd cx s k = e |> { EVar n (bLookup g n bd cx s k) ; EApp p (aSpine e XNil |> { Spn h as (bInfer g h bd cx s (bInferArgs g (bIsEq h) as Zero bd cx k)) }) ; ECell xs (bInferL g xs bd cx s (bInferCell k)) ; EPick ax x (bInfer g x bd cx s (bInferPick g (axBits ax BkNil) k)) ; ECase x bs (bInferCase g x bs bd cx s k) ; ELam x b (bFresh s (bInferLam g x b bd cx k)) ; EQuote b fu i (bFresh s k) ; EScry p (bFresh s k) ; ENs fs (bFresh s k) ; ENum m (bFresh s (bLit k)) }
bLit k t s = k t (bsLitAdd s t)
bInferLam g x b bd cx k p s = bInfer g b (BdCons x p bd) cx s (bInferLam2 p k)
bInferLam2 p k bt s = bArr p bt No MNone s k
bIsEq h = h |> { EVar n (eqId n idEQ) ; EApp p No ; ECell xs No ; EPick k x No ; ECase x bs No ; ELam x b No ; EQuote b fu i No ; EScry p No ; ENs fs No ; ENum k No }
lt2 i = i |> { Zero Yes ; Suc j (j |> { Zero Yes ; Suc k No }) }
-- each argument: EQ's first two through a data variable, then the
-- function type unified with an elimination of it
bInferArgs g eq as i bd cx k tf s = as |> { XNil (k tf s) ; XCons x r (bInfer g x bd cx s (bIA2 g eq r i bd cx k tf)) }
bIA2 g eq r i bd cx k tf tx s = bIAData g (andB eq (lt2 i)) tx s (bIA3 g eq r i bd cx k tf)
bIAData g b tx s k = b |> { Yes (bVar Yes No LkNone s (bIAD g tx k)) ; No (k tx s) }
bIAD g tx k d s = bUnify g d tx s (bIAD2 k d)
bIAD2 k d s = k d s
bIA3 g eq r i bd cx k tf tx s = bFresh s (bIA4 g eq r i bd cx k tf tx)
bIA4 g eq r i bd cx k tf tx rv s = bArr tx rv Yes MNone s (bIA5 g eq r i bd cx k tf rv)
bIA5 g eq r i bd cx k tf rv ar s = bUnify g ar tf s (bInferArgs g eq r (Suc i) bd cx k rv)
-- a cell: its items' types paired from the right
bInferL g xs bd cx s k = xs |> { XNil (k BsNil s) ; XCons x r (bInfer g x bd cx s (bInferLK g r bd cx k)) }
bInferLK g r bd cx k t s = bInferL g r bd cx s (bInferLK2 t k)
bInferLK2 t k ts s = k (BsCons t ts) s
bInferCell k ts s = bCellFold ts s k
bCellFold ts s k = ts |> { BsNil BNo ; BsCons t r (r |> { BsNil (k t s) ; BsCons u r2 (bCellFold r s (bCellK t k)) }) }
bCellK t k ct s = bCon idCell (bs2 t ct) s k
-- a pick: the axis's bits after its first, a head for 0, a tail for 1
oddN n = n |> { Zero No ; Suc m (notB (oddN m)) }
halfN n = n |> { Zero Zero ; Suc m (m |> { Zero Zero ; Suc j (Suc (halfN j)) }) }
axBits n acc = n |> { Zero acc ; Suc m (m |> { Zero acc ; Suc j (axBits (halfN n) (BkCons (oddN n) acc)) }) }
bInferPick g bs k t s = bs |> { BkNil (k t s) ; BkCons b r (bFresh s (bPick1 g b r k t)) }
bPick1 g b r k t a s = bFresh s (bPick2 g b r k t a)
bPick2 g b r k t a c s = bCon idCell (bs2 a c) s (bPick3 g b r k t a c)
bPick3 g b r k t a c cl s = bUnify g cl t s (bPick4 g b r k a c)
bPick4 g b r k a c s = bInferPick g r k (b |> { Yes c ; No a }) s
-- a case, nominally: the scrutinee of the first branch's type, each
-- branch's binders its fields' types, one result
bInferCase g x bs bd cx s k = bs |> { BNil BNo ; BCons b r (b |> { Br c ns y (ctorTy g c |> { MNone BNo ; MName tn (bCon tn BsNil s (bCase2 g x bs bd cx k tn)) }) }) }
bCase2 g x bs bd cx k tn tc s = bInfer g x bd cx s (bCase3 g bs bd cx k tn tc)
bCase3 g bs bd cx k tn tc st s = bUnify g tc st s (bCase4 g bs bd cx k tn)
bCase4 g bs bd cx k tn s = bFresh s (bCase5 g bs bd cx k tn)
bCase5 g bs bd cx k tn res s = bBranches g bs bd cx tn res s (bCase6 k res)
bCase6 k res s = k res s
bBranches g bs bd cx tn res s k = bs |> { BNil (k s) ; BCons b r (b |> { Br c ns y (tyFss (gDecls g) tn |> { MFsNone BNo ; MFs cs (ctorFs cs (tyFields (gDecls g) tn) c |> { MFsNone BNo ; MFs fs (eqN (lenN ns) (lenN fs) |> { No BNo ; Yes (bFields g fs s (bBr2 g ns y r bd cx tn res k)) }) }) }) }) }
bBr2 g ns y r bd cx tn res k fts s = bInfer g y (bdAll ns fts bd) cx s (bBr3 g r bd cx tn res k)
bBr3 g r bd cx tn res k bt s = bUnify g res bt s (bBr4 g r bd cx tn res k)
bBr4 g r bd cx tn res k s = bBranches g r bd cx tn res s k
bdAll ns ts bd = ns |> { NmNil bd ; NmCons n r (ts |> { BsNil bd ; BsCons t tr (bdAll r tr (BdCons n t bd)) }) }
-- the declarations to infer: equations, definitions that are not
-- quotations or namespace literals, and each core equation, keyed by its
-- `core.eq`, its core's parameters first among its binders
bItems ds = ds |> { DNil BiNil ; DCons d r (d |> { DEq n bs x (BiCons (BIt n n bs x BxTop) (bItems r)) ; DDef n x (isQuoteE x |> { Yes (bItems r) ; No (BiCons (BIt n n NmNil x BxTop) (bItems r)) }) ; DType n cs fs (bItems r) ; DMacro n ps c x (bItems r) ; DCore n ps es (bItemsC es (bItems r)) ; DCEq c n rn bs x (bItems r) }) }
bItemsC es acc = es |> { DNil acc ; DCons d r (d |> { DCEq c n rn bs x (BiCons (BIt c n bs x (BxCore rn)) (bItemsC r acc)) ; DEq n bs x (bItemsC r acc) ; DDef n x (bItemsC r acc) ; DType n cs fs (bItemsC r acc) ; DMacro n ps c x (bItemsC r acc) ; DCore n ps fs (bItemsC r acc) }) }
bItem its key = its |> { BiNil (BIt idNone idNone NmNil (EVar idNone) BxTop) ; BiCons i r (i |> { BIt k n bs x cx (eqId k key |> { Yes i ; No (bItem r key) }) }) }
bKeys its = its |> { BiNil NmNil ; BiCons i r (i |> { BIt k n bs x cx (NmCons k (bKeys r)) }) }
bTopKeys its = its |> { BiNil NmNil ; BiCons i r (i |> { BIt k n bs x cx (cx |> { BxTop (NmCons k (bTopKeys r)) ; BxCore rn (bTopKeys r) }) }) }
-- an interpreter core's name denotes its loop: the cores with one, each
-- with its loop's key
bLoops g ss ds = ds |> { DNil RnNil ; DCons d r (d |> { DCore n ps es (andB (bHasObj g) (orB (orB (memN idGStep (ownNames es)) (memN idLoop (ownNames es))) (anyIn ss (ownNames es))) |> { Yes (loopOf es |> { MName c (RnCons n c (bLoops g ss r)) ; MNone (bLoops g ss r) }) ; No (bLoops g ss r) }) ; DEq n bs x (bLoops g ss r) ; DDef n x (bLoops g ss r) ; DType n cs fs (bLoops g ss r) ; DMacro n ps c x (bLoops g ss r) ; DCEq c n rn bs x (bLoops g ss r) }) }
ownNames es = es |> { DNil NmNil ; DCons d r (d |> { DCEq c e rn bs x (NmCons e (ownNames r)) ; DEq n bs x (NmCons n (ownNames r)) ; DDef n x (ownNames r) ; DType n cs fs (ownNames r) ; DMacro n ps c x (ownNames r) ; DCore n ps fs (ownNames r) }) }
bHasObj g = objOf (gDecls g) ObNone |> { Ob on cs fs apc Yes ; ObNone No ; ObErr No }
-- the names a body mentions (typecheck.py _names), under lambdas too
bNames e acc = e |> { EVar n (NmCons n acc) ; EApp p (p |> { EAp f a (bNames f (bNames a acc)) }) ; ECell xs (bNamesL xs acc) ; EPick k x (bNames x acc) ; ECase x bs (bNames x (bNamesB bs acc)) ; ELam x b (bNames b acc) ; EQuote b fu i acc ; EScry p acc ; ENs fs acc ; ENum k acc }
bNamesL xs acc = xs |> { XNil acc ; XCons x r (bNames x (bNamesL r acc)) }
bNamesB bs acc = bs |> { BNil acc ; BCons b r (b |> { Br c ns y (bNames y (bNamesB r acc)) }) }
-- an item's dependencies: a sibling of its core by `core.eq`, a
-- program-level item, or a core's loop
bDeps tk ls bs cx ns = ns |> { NmNil NmNil ; NmCons n r (memN n bs |> { Yes (bDeps tk ls bs cx r) ; No (bDep tk ls cx n (bDeps tk ls bs cx r)) }) }
bDep tk ls cx n acc = (cx |> { BxTop MNone ; BxCore rn (rnFind n rn) }) |> { MName c (NmCons c acc) ; MNone (memN n tk |> { Yes (NmCons n acc) ; No (rnFind n ls |> { MName c (NmCons c acc) ; MNone acc }) }) }
-- names in Python's order, by their texts
insName rv x xs = xs |> { NmNil (NmCons x NmNil) ; NmCons y r (cmpName (nameFor rv x) (nameFor rv y) |> { CLt (NmCons x xs) ; CEq (NmCons x xs) ; CGt (NmCons y (insName rv x r)) }) }
sortNames rv xs = xs |> { NmNil NmNil ; NmCons x r (insName rv x (sortNames rv r)) }
nubN xs = xs |> { NmNil NmNil ; NmCons x r (memN x r |> { Yes (nubN r) ; No (NmCons x (nubN r)) }) }
-- the groups (typecheck.py _sccs): Tarjan over the keys and each key's
-- dependencies in order, callees first, each group as Python pops it
bEqxs rv its ks tk ls = ks |> { NmNil ExNil ; NmCons k r (bItem its k |> { BIt k2 n bs x cx (ExCons (EqX k NmNil DBad (sortNames rv (nubN (bDeps tk ls bs cx (bNames x NmNil))))) (bEqxs rv its r tk ls)) }) }
revN xs acc = xs |> { NmNil acc ; NmCons x r (revN r (NmCons x acc)) }
revSc xs acc = xs |> { ScNil acc ; ScCons g r (revSc r (ScCons (revN g NmNil) acc)) }
bGroups rv its ls = bGroups2 (bEqxs rv its (sortNames rv (bKeys its)) (bTopKeys its) ls)
bGroups2 es = tarjan es (Tst Zero NmNil (tjInit es Tj0) ScNil) |> { Tst c stk m out (revSc out ScNil) }

-- a group (typecheck.py infer_group): each key a monotype; each item's
-- binders fresh, a repeated one taking the last; EQ's first two data; its
-- type unified with its monotype; then its literals settled, its
-- monotypes dropped and each type generalized
bGroup g its ls grp s k = bMonoAll grp s (bGroup2 g its ls grp k)
bMonoAll ks s k = ks |> { NmNil (k (bsLitsSet s BsNil)) ; NmCons c r (bFresh s (bMonoK c r k)) }
bMonoK c r k t s = bMonoAll r (bsMonoPut s c t) k
bGroup2 g its ls grp k s = bItemsT g its grp Bm0 s (bGroup3 g its ls grp k)
bItemsT g its ks rs s k = ks |> { NmNil (k rs s) ; NmCons c r (bItem its c |> { BIt c2 n bs x cx (bBinders bs BdNil s (bItemT g c n bs x cx (bItemsTK g its r rs k))) }) }
bItemsTK g its r rs k c t s = bItemsT g its r (bmPut (idBits c) (MBt t) rs) s k
bBinders bs bd s k = bs |> { NmNil (k bd s) ; NmCons b r (bFresh s (bBindersK b r bd k)) }
bBindersK b r bd k t s = bBinders r (BdCons b t bd) s k
bParams bs bd = bs |> { NmNil BsNil ; NmCons b r (BsCons (bdGet b bd |> { MBt t t ; MBtNone Bn }) (bParams r bd)) }
bItemT g c n bs x cx k bd s = bReqEq g (andB (cx |> { BxTop Yes ; BxCore rn No }) (eqId n idEQ) |> { Yes (bTake2 (bParams bs bd)) ; No BsNil }) s (bItemT2 g c bs x cx k bd)
bTake2 xs = xs |> { BsNil BsNil ; BsCons a r (r |> { BsNil (bs1 a) ; BsCons b r2 (bs2 a b) }) }
bReqEq g ts s k = ts |> { BsNil (k s) ; BsCons t r (bReqData g t BsNil s (bReqEqK g r k)) }
bReqEqK g r k sn s = bReqEq g r s k
bItemT2 g c bs x cx k bd s = bInfer g x bd cx s (bItemT3 g c bs k bd)
bItemT3 g c bs k bd bt s = bArrows (bParams bs bd) bt s (bItemT4 g c k)
bItemT4 g c k t s = bsMono s c |> { MBt m (bUnify g m t s (bItemT5 c t k)) ; MBtNone BNo }
bItemT5 c t k s = k c t s
bGroup3 g its ls grp k rs s = bSettle g (revB (bsLits s) BsNil) (bsLitsSet s BsNil) (bGroup4 g its ls grp k rs)
bGroup4 g its ls grp k rs s = bGen g its grp rs (bMonoDel grp s) (bGroup5 ls grp k)
bMonoDel ks s = ks |> { NmNil s ; NmCons c r (bMonoDel r (bsMonoDel s c)) }
bGen g its ks rs s k = ks |> { NmNil (k s) ; NmCons c r (bmGet (idBits c) rs |> { MBtNone (bGen g its r rs s k) ; MBt t (bGen g its r rs (bGenPut its c (bGeneral t s) s) k) }) }
-- a program-level item's scheme goes to the program's environment, a
-- core equation's to the cores', by its `core.eq`
bGenPut its c sc s = bItem its c |> { BIt k n bs x cx (cx |> { BxTop (bsEnvPut s c sc) ; BxCore rn (bsCEnvPut s c sc) }) }
-- once a core's loop is typed, the core's name denotes it
bGroup5 ls grp k s = k (bAlias ls grp s)
bAlias ls grp s = ls |> { RnNil s ; RnCons n c r (bAlias r grp (memN c grp |> { Yes (bsCEnv s c |> { MSc sc (bsEnvPut s n sc) ; MScNone s }) ; No s })) }
-- the literals: a numeral of a numeral type, or defaulted to the one
-- declared, or to fuel when none is; two declared is a problem
bSettle g lits s k = lits |> { BsNil (k s) ; BsCons t r (bSettle1 g (bRes s t) r s k) }
bSettle1 g t r s k = bsNode s t |> { TNV lr d n e (bSettle2 g t r s k) ; TNC x as (isNumeral g x |> { Yes (bSettle g r s k) ; No BNo }) ; TNA p q el nm dt ck nu (bSettle2 g t r s k) }
bSettle2 g t r s k = (gNums g |> { NmNil (MName idFuel) ; NmCons a rest (rest |> { NmNil (MName a) ; NmCons b rr MNone }) }) |> { MName a (bCon a BsNil s (bSettle3 g t r k)) ; MNone BNo }
bSettle3 g t r k c s = bUnify g t c s (bSettle4 g r k)
bSettle4 g r k s = bSettle g r s k
-- the constructors' schemes: their fields' types to their type's
bCtors g ds s k = ds |> { DNil (k s) ; DCons d r (d |> { DType n cs fs (bCtorsT g n cs fs s (bCtorsK g r k)) ; DEq m bs x (bCtors g r s k) ; DDef m x (bCtors g r s k) ; DMacro m ps c x (bCtors g r s k) ; DCore m ps es (bCtors g r s k) ; DCEq c m rn bs x (bCtors g r s k) }) }
bCtorsK g r k s = bCtors g r s k
bCtorsT g tn cs fs s k = cs |> { NmNil (k s) ; NmCons c cr (fs |> { FsNil (k s) ; FsCons f fr (bFields g f s (bCtorsT2 g tn c cr fr k)) }) }
bCtorsT2 g tn c cr fr k ts s = bCon tn BsNil s (bCtorsT3 g tn c cr fr k ts)
bCtorsT3 g tn c cr fr k ts tc s = bArrows ts tc s (bCtorsT4 g tn c cr fr k)
bCtorsT4 g tn c cr fr k t s = bCtorsT g tn cr fr (bsEnvPut s c (Sch BsNil BsNil t BsNil ElNil)) k
-- datums are the object type's terms, a namespace literal a function of
-- one to the answer type's; each level-1 run noted
bDatums ot an ds s k = ds |> { DNil (k s) ; DCons d r (d |> { DDef n x (x |> { EQuote b fu i (isDatum fu i |> { Yes (bDatums ot an r (bsEnvPut s n (Sch BsNil BsNil ot BsNil ElNil)) k) ; No (bDatums ot an r s k) }) ; ENs fs (an |> { MName a (bCon a BsNil s (bDatumsNs ot an n r k)) ; MNone (bDatums ot an r s k) }) ; EVar m (bDatums ot an r s k) ; EApp p (bDatums ot an r s k) ; ECell xs (bDatums ot an r s k) ; EPick m y (bDatums ot an r s k) ; ECase y bs (bDatums ot an r s k) ; ELam y b (bDatums ot an r s k) ; EScry p (bDatums ot an r s k) ; ENum m (bDatums ot an r s k) }) ; DEq n bs x (bDatums ot an r s k) ; DType n cs fs (bDatums ot an r s k) ; DMacro n ps c x (bDatums ot an r s k) ; DCore n ps es (bDatums ot an r s k) ; DCEq c n rn bs x (bDatums ot an r s k) }) }
bDatumsNs ot an n r k ta s = bArr ot ta No MNone s (bDatumsNs2 ot an n r k)
bDatumsNs2 ot an n r k t s = bDatums ot an r (bsEnvPut s n (Sch BsNil BsNil t BsNil ElNil)) k
-- the answer type, if there is exactly one with a nullary constructor
bAnswer on o2 r2 ds = ansCands on o2 r2 ds |> { NmNil MNone ; NmCons a r (r |> { NmNil (eqId a idNone |> { Yes MNone ; No (MName a) }) ; NmCons b r2x MNone }) }
-- signatures: each one of a program-level name, against its scheme
bSigs g sg s k = sg |> { SgNil (k s) ; SgCons n ts r (bsEnv s n |> { MScNone (bSigs g r s k) ; MSc sc (bFields g (initN ts) s (bSigs2 g n ts r k sc)) }) }
bSigs2 g n ts r k sc as s = bField g (lastN ts idNone) s (bSigs3 g r k sc as)
bSigs3 g r k sc as t s = bArrows as t s (bSigs4 g r k sc)
bSigs4 g r k sc sig s = bInst g sc s (bSigs5 g r k sig)
bSigs5 g r k sig it s = bUnify g sig it s (bSigs6 g r k)
bSigs6 g r k s = bSigs g r s k
-- the level-1 runs (typecheck.py run_decl): the interpreter, whnfF by
-- default, applied to its parameters, then the fuel and the term, to the
-- result type; each run is then of that type
bRuns g ms ot rn ds s k = ds |> { DNil (k s) ; DCons d r (d |> { DDef n x (x |> { EQuote b fu i (isDatum fu i |> { Yes (bRuns g ms ot rn r s k) ; No (bRun g ms ot rn n (i |> { INone (EVar idWhnfF) ; ISome y y }) (bsLitsSet s BsNil) (bRunsK g ms ot rn r k)) }) ; EVar m (bRuns g ms ot rn r s k) ; EApp p (bRuns g ms ot rn r s k) ; ECell xs (bRuns g ms ot rn r s k) ; EPick m y (bRuns g ms ot rn r s k) ; ECase y bs (bRuns g ms ot rn r s k) ; ELam y b (bRuns g ms ot rn r s k) ; EScry p (bRuns g ms ot rn r s k) ; ENs fs (bRuns g ms ot rn r s k) ; ENum m (bRuns g ms ot rn r s k) }) ; DEq n bs x (bRuns g ms ot rn r s k) ; DType n cs fs (bRuns g ms ot rn r s k) ; DMacro n ps c x (bRuns g ms ot rn r s k) ; DCore n ps es (bRuns g ms ot rn r s k) ; DCEq c n rn2 bs x (bRuns g ms ot rn r s k) }) }
bRunsK g ms ot rn r k s = bSettle g (revB (bsLits s) BsNil) (bsLitsSet s BsNil) (bRunsK2 g ms ot rn r k)
bRunsK2 g ms ot rn r k s = bRuns g ms ot rn r s k
bRun g ms ot rn n hd s k = aSpine hd XNil |> { Spn h as (h |> { EVar m (bsEnv s m |> { MScNone (k s) ; MSc sc (bInst g sc s (bRunArgs g ms ot rn n as k)) }) ; EApp p (k s) ; ECell xs (k s) ; EPick j y (k s) ; ECase y bs (k s) ; ELam y b (k s) ; EQuote b fu i (k s) ; EScry p (k s) ; ENs fs (k s) ; ENum j (k s) }) }
bRunArgs g ms ot rn n as k t s = as |> { XNil (bFresh s (bRunEnd g ot rn n k t)) ; XCons x r (mxTop ms x |> { MXFail BNo ; MX e w f (bInfer g e BdNil BxTop s (bRunArg2 g ms ot rn n r k t)) }) }
bRunArg2 g ms ot rn n r k t tx s = bFresh s (bRunArg3 g ms ot rn n r k t tx)
bRunArg3 g ms ot rn n r k t tx rv s = bArr tx rv Yes MNone s (bRunArg4 g ms ot rn n r k t rv)
bRunArg4 g ms ot rn n r k t rv ar s = bUnify g ar t s (bRunArgs g ms ot rn n r k rv)
bRunEnd g ot rn n k t rv s = bArrows (bs2 (gFuel g) ot) rv s (bRunEnd2 g rn n k t rv)
bRunEnd2 g rn n k t rv ar s = bUnify g ar t s (bRunEnd3 g rn n k rv)
bRunEnd3 g rn n k rv s = bCon rn BsNil s (bRunEnd4 g rn n k rv)
bRunEnd4 g rn n k rv tr s = bUnify g tr rv s (bRunEnd5 rn n k)
bRunEnd5 rn n k s = bCon rn BsNil s (bRunEnd6 n k)
bRunEnd6 n k tr s = k (bsEnvPut s n (Sch BsNil BsNil tr BsNil ElNil))
-- the run's arguments expanded before Stage B: Python expands them
-- inside it, and an expansion that fails refuses the program whatever
-- else Stage B finds.  An interpreter is a core (Stage A), and Python
-- reaches its arguments when the core denotes its loop
bArgsOK ms ls ds = ds |> { DNil Yes ; DCons d r (andB (d |> { DDef n x (x |> { EQuote b fu i (i |> { INone Yes ; ISome y (aSpine y XNil |> { Spn h as (h |> { EVar m (rnFind m ls |> { MName c (bArgsX ms as) ; MNone Yes }) ; EApp p Yes ; ECell xs Yes ; EPick j z Yes ; ECase z bs Yes ; ELam z b Yes ; EQuote b2 f2 i2 Yes ; EScry p Yes ; ENs fs Yes ; ENum j Yes }) }) }) ; EVar m Yes ; EApp p Yes ; ECell xs Yes ; EPick m y Yes ; ECase y bs Yes ; ELam y b Yes ; EScry p Yes ; ENs fs Yes ; ENum m Yes }) ; DEq n bs x Yes ; DType n cs fs Yes ; DMacro n ps c x Yes ; DCore n ps es Yes ; DCEq c n rn bs x Yes }) (bArgsOK ms ls r)) }
bArgsX ms as = as |> { XNil Yes ; XCons x r (mxTop ms x |> { MXFail No ; MX e w f (bArgsX ms r) }) }
-- Stage B from the top (typecheck.py run): the FUEL node first; the
-- constructors; the object, loop and answer types; the datums; the
-- groups; the signatures; the runs.  BOk where it finds no problem
stageB st ms ct ds sg ss = st |> { Ist tab rv nx (bCon idFuel BsNil (BS Nd0 Bn Ev0 Ev0 Bm0 BsNil) (stageB2 rv ms ct ds sg ss)) }
stageB2 rv ms ct ds sg ss fu s = stageB3 (BGx ds fu ct (numTys ds) rv) ms ds sg ss s
stageB3 g ms ds sg ss s = bCtors g ds s (stageB4 g ms ds sg ss)
stageB4 g ms ds sg ss s = bObjNode ds s (stageB5 g ms ds sg ss (bAnsOf ds) (bRtOf ds))
-- the object type's node, made once, if there is one; its loop's result
-- type and the answer type, as names
bObjNode ds s k = objOf ds ObNone |> { Ob on cs fs apc (bCon on BsNil s (bObjK k)) ; ObNone (k MBtNone s) ; ObErr (k MBtNone s) }
bObjK k t s = k (MBt t) s
bRtOf ds = objOf ds ObNone |> { Ob on cs fs apc (pickOR (candsOf on ds) |> { LT sd dn val to ks o2 r2 (MName r2) ; LTErr MNone }) ; ObNone MNone ; ObErr MNone }
bAnsOf ds = objOf ds ObNone |> { Ob on cs fs apc (pickOR (candsOf on ds) |> { LT sd dn val to ks o2 r2 (bAnswer on o2 r2 ds) ; LTErr MNone }) ; ObNone MNone ; ObErr MNone }
stageB5 g ms ds sg ss an rt mot s = bDatumsM mot an ds s (stageB6 g ms ds sg ss an rt (mot |> { MBt t t ; MBtNone Bn }))
bDatumsM mot an ds s k = mot |> { MBt ot (bDatums ot an ds s k) ; MBtNone (k s) }
stageB6 g ms ds sg ss an rt ot s = stageB7 g ms ds sg (bItems ds) (bLoops g ss ds) rt ot s
stageB7 g ms ds sg its ls rt ot s = bGroupsAll g its ls (bGroups (gRv g) its ls) s (stageB8 g ms ds sg ls rt ot)
bGroupsAll g its ls gs s k = gs |> { ScNil (k s) ; ScCons grp r (bGroup g its ls grp s (bGroupsK g its ls r k)) }
bGroupsK g its ls r k s = bGroupsAll g its ls r s k
stageB8 g ms ds sg ls rt ot s = bSigs g sg s (stageB9 g ms ds ls rt ot)
stageB9 g ms ds ls rt ot s = rt |> { MName rn (bRuns g ms ot rn ds s stageBEnd) ; MNone (stageBEnd s) }
stageBEnd s = BOk
-- the front end: characters to every name's term
front s = frontA (intern (lx s) seeded)
frontA q = q |> { IR raw st (front2 st raw) }
front2 st raw = cc TNl raw |> { CRFail (RErr Zero) ; CR is ys (dupS (ciNames is) Ns0 |> { Yes (RErr Zero) ; No (front2b st (ciMap is Cm0) ys raw) }) }
-- pass one refuses a constructor declared twice (parser.py collect_ctors)
ciNames is = is |> { CiNil NmNil ; CiCons x r (x |> { CInfo n tn i k (NmCons n (ciNames r)) }) }
front2b st ct ys raw = front3 st ct ys (pprog ct (nlf TNl TNl Zero BkNil raw))
front3 st ct ys p = p |> { PQFail (RErr Zero) ; PQ ds0 sg (stageA st ct ys ds0 |> { PANo (genProg ds0 st |> { GQErr (RErr Zero) ; GQ ds1 st1 (front3x st1 ct ys ds0 ds1 sg) }) ; PAIs c (RErr c) }) }
front3x st ct ys ds0 ds1 sg = xpand (macsOf ds1 McNil) ds1 |> { PDFail (RErr Zero) ; PD ds (orB (skiD ds) (orB (dupS (orderOf ds) Ns0) (orB (dupS (tyNames ys) Ns0) (orB (dupS (coreNames ds) Ns0) (dupEqs ds)))) |> { Yes (RErr Zero) ; No (front3b (macsOf ds1 McNil) ct ys (natOps ds0) (coreIds st ds) sg) }) }
front3b ms ct ys nops q sg = q |> { CQ ds st (front3s ms ct ys nops ds st sg (objOf ds ObNone |> { Ob on cs fs apc (lookPre nameGStep cs st |> { NQ ss st2 ss }) ; ObNone NmNil ; ObErr NmNil })) }
-- the runs' arguments expanded, then Stage B
front3s ms ct ys nops ds st sg ss = bArgsOK ms (bLoops (BGx ds Bn Cm0 NmNil Rv0) ss ds) ds |> { No (RErr Zero) ; Yes (stageB st ms ct ds sg ss |> { BNo (RErr (Suc (Suc (Suc (Suc (Suc (Suc (Suc Zero)))))))) ; BOk (front3c ms ct ys nops ds st) }) }
front3c ms ct ys nops ds st = (qstrip (pathSx ct st ds) (objOf ds ObNone |> { Ob on cs fs apc (memN idScry (leavesOf apc cs)) ; ObNone No ; ObErr No }) ds Bn |> { QStFail (RErr Zero) ; QSt qd qc (st |> { Ist tab rv nx (front4 rv ms ct ys ds nops qd (orderOf ds)) }) })
front4 rv ms ct ys ds nops qd o = front4a rv ms ct ys ds nops qd (appN o (prelNotIn (setOf o Ns0) (appN preludeNames nops)))
front4a rv ms ct ys ds nops qd env = front5 rv ms ct ys ds nops qd env (loops ds) (loopAlias (setOf (memN idNatMul nops |> { Yes (NmCons idNatAdd env) ; No env }) Ns0) (loops ds))
front5 rv ms ct ys ds nops qd env ls al = front5a rv ms ct ys ds nops qd env ls al (setOf (appN (notIn (l1Names qd) env) (appN (cidsOf ds) (rnKeys al))) Ns0) (eqsOf ct ys ds)
front5a rv ms ct ys ds nops qd env ls al es0 eqs = front5b rv ms ct ys ds nops qd env ls al es0 (depsAll (setOf (namesX eqs) Ns0) eqs)
front5b rv ms ct ys ds nops qd env ls al es0 dd = front5c rv ms ct ys ds nops qd env ls al es0 dd (tarjan dd (Tst Zero NmNil (tjInit dd Tj0) ScNil))
front5c rv ms ct ys ds nops qd env ls al es0 dd st = st |> { Tst c stk m out (front6 rv ms ct ys ds qd env ls es0 (defRules es0 ct ys ds (eqRules es0 (groupsOf dd m out Gm0) dd (ctorRules ct ys (loopRules al (natRules nops preludeRules)))))) }
-- without a quotation, nothing more; with one, the object type and the
-- loop's types are required
front6 rv ms ct ys ds qd env ls es0 rs = qd |> { QdNil (front8 rv ds env ls NmNil rs NmNil NmNil NmNil Me0) ; QdCons q r (objOf ds ObNone |> { ObNone (RErr Zero) ; ObErr (RErr Zero) ; Ob on cs fs apc (pickOR (candsOf on ds) |> { LTErr (RErr Zero) ; LT sd dn val to ks o2 r2 (andB (ansOK on o2 r2 ds) (pathOK ds) |> { No (RErr Zero) ; Yes (front6a rv ds env ls rs qd (QE apc (leavesOf apc cs)) (QX ms ct ys es0 (setOf (appN (pidsOf qd) (leafIds (leavesOf apc cs))) es0) (leafRen (leavesOf apc cs)) (QE apc (leavesOf apc cs)) ds (ansOf on o2 r2 ds) ls (bareOut (bareAll ds) (qNames qd) ds) (setOf (notIn (qNames qd) env) Ns0))) }) }) }) }
front6a rv ds env ls rs qd qe x = qcomp (qbody x) x qe qd Ns0 |> { QOErr (RErr Zero) ; QO nr dts l1 ck rt (front7a rv ds env ls qd (nrAdd nr rs) dts l1 ck rt qe) }
front7a rv ds env ls qd rs dts l1 ck rt qe = rootsOK rs (setOf dts Ns0) rt |> { No (RErr Zero) ; Yes (qe |> { QE apc lv (front8 rv ds env ls (qNames qd) rs dts l1 ck (seedMe lv Zero Me0)) }) }
front8 rv ds env ls qn rs dts l1 ck me0 = badRs rs |> { Yes (RErr Zero) ; No (front9 (outAll rv rs (appP (selfP (notIn qn env)) (appP (selfP dts) (appP (coreP (bareAll ds) qn ds) (appP (loopP ls) (selfP l1))))) me0) rs ck) }
-- the level-1 runs without a closed term are still made, for their errors
front9 q rs ck = q |> { OA os me (forceAll rs ck me |> { MTm t (RErr Zero) ; MTmNone (ROk os) }) }
forceAll rs ck me = findMe idAt me |> { MTm t (MTm t) ; MTmNone (ck |> { NmNil MTmNone ; NmCons n r (tof rs n me NmNil |> { TM t me2 (forceAll rs r me2) }) }) }
