-- Reading the front end's result out (docs/SKIJACK-0.md §5): appended to
-- front0.ascii.ski, `render` turns a result into a tree of the marker
-- atoms it is given, a cell of sixteen, which a reducer prints in
-- normal form.
rBit hi lo b = b |> { Lo lo ; Hi hi }
rCode m c = c |> { Code a6 a5 a4 a3 a2 a1 a0 ((2@m) (rBit (6@m) (14@m) a6) (rBit (6@m) (14@m) a5) (rBit (6@m) (14@m) a4) (rBit (6@m) (14@m) a3) (rBit (6@m) (14@m) a2) (rBit (6@m) (14@m) a1) (rBit (6@m) (14@m) a0)) }
rName m n = n |> { NNil (30@m) ; NCons c r ((62@m) (rCode m c) (rName m r)) }
rNat m n = n |> { Zero (126@m) ; Suc k ((254@m) (rNat m k)) }
rTm m t = t |> { TS (510@m) ; TK (1022@m) ; TI (2046@m) ; TV n ((4094@m) (rNat m n)) ; TA p (p |> { Ap e f ((8190@m) (rTm m e) (rTm m f)) }) }
rOuts m os = os |> { ONil (16382@m) ; OCons n t r ((32766@m) (rName m n) (rTm m t) (rOuts m r)) }
render m r = r |> { ROk os ((65534@m) (rOuts m os)) ; RErr (65535@m) }
